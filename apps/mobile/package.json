{
  "name": "@asms/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "pnpm --filter @asms/shared build && expo start --dev-client",
    "android": "pnpm --filter @asms/shared build && expo run:android",
    "lint": "pnpm --filter @asms/shared build && eslint .",
    "typecheck": "pnpm --filter @asms/shared build && tsc --noEmit",
    "test": "pnpm --filter @asms/shared build && jest --maxWorkers=2 --workerIdleMemoryLimit=1024MB",
    "export:android": "pnpm --filter @asms/shared build && expo export --platform android --output-dir dist",
    "doctor": "expo-doctor",
    "api:generate": "openapi-typescript ../api/openapi/school.json -o src/api/school.d.ts --default-non-nullable false",
    "capture:fixtures": "node scripts/capture-fixtures.ts"
  },
  "dependencies": {
    "@asms/shared": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.0",
    "expo": "57.0.27",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-device": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-image": "57.0.5",
    "expo-image-manipulator": "57.0.21",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-screen-capture": "57.0.4",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "openapi-typescript": "7.13.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "packageManager": "pnpm@12.3.4",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  }
}
