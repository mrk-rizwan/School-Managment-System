{
  "name": "@asms/api",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker": "dotenv run -f ../../.env -- ts-node src/worker.ts",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=2 --workerIdleMemoryLimit=1024MB",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:test:deploy": "node scripts/migrate-test-db.js",
    "openapi": "tsx scripts/generate-openapi.ts",
    "db:migration:new": "prisma migrate dev --create-only",
    "seed:platform-admin": "dotenv run -f ../../.env -- ts-node scripts/seed-platform-admin.ts",
    "seed:dev-school": "dotenv run -f ../../.env -- ts-node scripts/seed-dev-school.ts"
  },
  "dependencies": {
    "@asms/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1144.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "22.1.1",
    "firebase-admin": "14.5.0",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.13",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
