{
  "components": {
    "schemas": {
      "ApiErrorBodyDto": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "details": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "type": "object"
      },
      "ApiErrorDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ChangePlatformPasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "ChangeSchoolStatusDto": {
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SchoolStatusTarget"
              }
            ]
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "type": "object"
      },
      "ConfirmTotpDto": {
        "properties": {
          "code": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "CreateSchoolDto": {
        "properties": {
          "feeDueDay": {
            "default": 10,
            "maximum": 28,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "shortCode": {
            "description": "Trimmed and lower-cased before validation. Cannot be changed later.",
            "pattern": "^[a-z0-9]{3,12}$",
            "type": "string"
          },
          "timezone": {
            "default": "Asia/Karachi",
            "description": "IANA time zone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "shortCode"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "MALFORMED_REQUEST",
          "AUTH_REQUIRED",
          "AUTH_FAILED",
          "PERMISSION_DENIED",
          "SCHOOL_SUSPENDED",
          "ORIGIN_REJECTED",
          "NOT_FOUND",
          "VALIDATION_FAILED",
          "REFERENCE_NOT_FOUND",
          "UNKNOWN_FIELD",
          "INVALID_VALUE",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_ERROR",
          "PASSWORD_CHANGE_REQUIRED",
          "TOTP_REQUIRED",
          "TOTP_NOT_ENROLLED",
          "TOTP_ALREADY_ENROLLED",
          "TOTP_INVALID",
          "CURRENT_PASSWORD_INCORRECT",
          "SCHOOL_SHORT_CODE_TAKEN",
          "SCHOOL_SHORT_CODE_IMMUTABLE",
          "SCHOOL_TERMINATED",
          "ILLEGAL_STATUS_TRANSITION",
          "CONCURRENT_UPDATE",
          "UNEXPECTED_RESPONSE"
        ],
        "type": "string"
      },
      "PlatformLoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "totpCode": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PlatformMeDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "sessionExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "sessionStage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlatformSessionStage"
              }
            ]
          },
          "totpEnrolled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "sessionStage",
          "totpEnrolled",
          "mustChangePassword",
          "sessionExpiresAt"
        ],
        "type": "object"
      },
      "PlatformSessionStage": {
        "enum": [
          "totp_enrolment",
          "full"
        ],
        "type": "string"
      },
      "SchoolDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shortCode": {
            "pattern": "^[a-z0-9]{3,12}$",
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SchoolStatus"
              }
            ]
          },
          "timezone": {
            "description": "IANA time zone",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "shortCode",
          "status",
          "timezone",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "SchoolSort": {
        "enum": [
          "name",
          "-name",
          "shortCode",
          "-shortCode",
          "status",
          "-status",
          "createdAt",
          "-createdAt"
        ],
        "type": "string"
      },
      "SchoolStatus": {
        "enum": [
          "trial",
          "active",
          "suspended",
          "terminated"
        ],
        "type": "string"
      },
      "SchoolStatusTarget": {
        "enum": [
          "active",
          "suspended",
          "terminated"
        ],
        "type": "string"
      },
      "TotpEnrolmentDto": {
        "properties": {
          "otpauthUri": {
            "type": "string"
          },
          "secret": {
            "description": "Base32, for manual entry.",
            "type": "string"
          }
        },
        "required": [
          "otpauthUri",
          "secret"
        ],
        "type": "object"
      },
      "UpdateSchoolDto": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "shortCode": {
            "description": "Never accepted: present with any value is 409 SCHOOL_SHORT_CODE_IMMUTABLE",
            "type": "string"
          },
          "timezone": {
            "description": "IANA time zone",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
