/// Tenant: one announcement (R144-R152). Content is editable while draft or scheduled and frozen
/// once sending, sent or cancelled (trigger announcements_final_frozen). A holiday's notice and
/// its cancellation are announcements naming the holiday (R151). scheduled_at is kept as history
/// on a sent row (decision 11). Never deleted.
model Announcement {
  id                  BigInt               @id(map: "announcements_pkey") @default(autoincrement())
  schoolId            BigInt               @map("school_id")
  /// 1-120, never an identity number (CHECK announcements_title_no_id_check).
  title               String               @db.VarChar(120)
  /// 1-1800 (the composed message body is "{school}: {title}\n{body}" in 2,000; decision 6).
  body                String               @db.VarChar(1800)
  category            AnnouncementCategory
  priority            AnnouncementPriority
  status              AnnouncementStatus   @default(draft)
  /// Required when scheduled, absent on a draft, history afterwards (CHECK announcements_scheduled_check).
  scheduledAt         DateTime?            @map("scheduled_at") @db.Timestamptz(3)
  /// The last day it shows in an inbox (R147); null = never expires.
  expiresOn           DateTime?            @map("expires_on") @db.Date
  /// `{school_id}/{ULID}.{jpg|png|pdf}`; key, mime and size together (CHECK announcements_attachment_check).
  attachmentObjectKey String?              @map("attachment_object_key") @db.VarChar(64)
  attachmentMime      String?              @map("attachment_mime") @db.VarChar(32)
  attachmentSizeBytes Int?                 @map("attachment_size_bytes")
  holidayId           BigInt?              @map("holiday_id")
  createdBy           BigInt               @map("created_by")
  /// Set exactly when sent (CHECK announcements_sent_check).
  sentAt              DateTime?            @map("sent_at") @db.Timestamptz(3)
  /// Set together, exactly when cancelled (CHECK announcements_cancelled_check).
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy         BigInt?              @map("cancelled_by")
  cancelReason        String?              @map("cancel_reason") @db.VarChar(500)
  /// Persons resolved at send (R145); 0 until then.
  recipientCount      Int                  @default(0) @map("recipient_count")
  /// Failed attempts of the send job since the last send (§5.6); the fifth gives up.
  sendFailures        Int                  @default(0) @map("send_failures") @db.SmallInt
  /// Set when the send job gave up; only on a draft (CHECK announcements_send_failed_check).
  sendFailedAt        DateTime?            @map("send_failed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School                  @relation(fields: [schoolId], references: [id], map: "announcements_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  holiday         Holiday?                @relation("AnnouncementHoliday", fields: [schoolId, holidayId], references: [schoolId, id], map: "announcements_holiday_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  createdByUser   User                    @relation("AnnouncementCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "announcements_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User?                   @relation("AnnouncementCancelledBy", fields: [schoolId, cancelledBy], references: [schoolId, id], map: "announcements_cancelled_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  noticeOf        Holiday[]               @relation("HolidayAnnouncement")
  audiences       AnnouncementAudience[]
  recipients      AnnouncementRecipient[]

  @@unique([schoolId, id], map: "announcements_school_id_id_key")
  /// The scheduled-send sweep source (§5.6).
  @@index([schoolId, status, scheduledAt], map: "announcements_school_id_status_scheduled_at_idx")
  /// A `.scope` holder's own list.
  @@index([schoolId, createdBy, createdAt], map: "announcements_school_id_created_by_created_at_idx")
  @@index([schoolId, holidayId], map: "announcements_school_id_holiday_id_idx")
  @@index([schoolId, cancelledBy], map: "announcements_school_id_cancelled_by_idx")
  @@map("announcements")
}

/// Tenant: one audience item of an announcement. Exactly the foreign key its kind names is set
/// (CHECK announcement_audiences_target_check); one row per target (unique index
/// announcement_audiences_target_key). A draft's audience is a form field: rows are replaced on
/// PATCH (decision 12), so this table has no no-delete trigger.
model AnnouncementAudience {
  id             BigInt         @id(map: "announcement_audiences_pkey") @default(autoincrement())
  schoolId       BigInt         @map("school_id")
  announcementId BigInt         @map("announcement_id")
  kind           AudienceKind
  classId        BigInt?        @map("class_id")
  sectionId      BigInt?        @map("section_id")
  studentId      BigInt?        @map("student_id")
  guardianId     BigInt?        @map("guardian_id")
  staffId        BigInt?        @map("staff_id")
  /// class, section and student only; 1-2 distinct (CHECK announcement_audiences_roles_check).
  roles          AudienceRole[] @default([parents, students])
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School       @relation(fields: [schoolId], references: [id], map: "announcement_audiences_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  announcement Announcement @relation(fields: [schoolId, announcementId], references: [schoolId, id], map: "announcement_audiences_announcement_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  class        Class?       @relation(fields: [schoolId, classId], references: [schoolId, id], map: "announcement_audiences_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section      Section?     @relation(fields: [schoolId, sectionId], references: [schoolId, id], map: "announcement_audiences_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student      Student?     @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_audiences_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian     Guardian?    @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "announcement_audiences_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff        Staff?       @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "announcement_audiences_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "announcement_audiences_school_id_id_key")
  @@index([schoolId, announcementId], map: "announcement_audiences_school_id_announcement_id_idx")
  @@index([schoolId, classId], map: "announcement_audiences_school_id_class_id_idx")
  @@index([schoolId, sectionId], map: "announcement_audiences_school_id_section_id_idx")
  @@index([schoolId, studentId], map: "announcement_audiences_school_id_student_id_idx")
  @@index([schoolId, guardianId], map: "announcement_audiences_school_id_guardian_id_idx")
  @@index([schoolId, staffId], map: "announcement_audiences_school_id_staff_id_idx")
  @@map("announcement_audiences")
}

/// Tenant, append-only: one person an announcement resolved to at send (R145), once each
/// (partial uniques per person). Serves viaStudents and attachment access, never the inbox
/// (plan §4.2). message_id is back-filled once, from NULL, in the send transaction.
model AnnouncementRecipient {
  id             BigInt   @id(map: "announcement_recipients_pkey") @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  announcementId BigInt   @map("announcement_id")
  /// Exactly one of the three (CHECK announcement_recipients_person_check).
  guardianId     BigInt?  @map("guardian_id")
  staffId        BigInt?  @map("staff_id")
  studentId      BigInt?  @map("student_id")
  messageId      BigInt?  @map("message_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School                         @relation(fields: [schoolId], references: [id], map: "announcement_recipients_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  announcement Announcement                   @relation(fields: [schoolId, announcementId], references: [schoolId, id], map: "announcement_recipients_announcement_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian     Guardian?                      @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "announcement_recipients_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff        Staff?                         @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "announcement_recipients_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student      Student?                       @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_recipients_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  message      Message?                       @relation(fields: [schoolId, messageId], references: [schoolId, id], map: "announcement_recipients_message_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  students     AnnouncementRecipientStudent[]

  @@unique([schoolId, id], map: "announcement_recipients_school_id_id_key")
  @@index([schoolId, announcementId], map: "announcement_recipients_school_id_announcement_id_idx")
  @@index([schoolId, guardianId], map: "announcement_recipients_school_id_guardian_id_idx")
  @@index([schoolId, staffId], map: "announcement_recipients_school_id_staff_id_idx")
  @@index([schoolId, studentId], map: "announcement_recipients_school_id_student_id_idx")
  @@index([schoolId, messageId], map: "announcement_recipients_school_id_message_id_idx")
  @@map("announcement_recipients")
}

/// Tenant, append-only: why a guardian recipient is in the audience, every student that put them
/// there (R145). Staff and student recipients have none.
model AnnouncementRecipientStudent {
  id                      BigInt   @id(map: "announcement_recipient_students_pkey") @default(autoincrement())
  schoolId                BigInt   @map("school_id")
  announcementRecipientId BigInt   @map("announcement_recipient_id")
  studentId               BigInt   @map("student_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school    School                @relation(fields: [schoolId], references: [id], map: "announcement_recipient_students_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  recipient AnnouncementRecipient @relation(fields: [schoolId, announcementRecipientId], references: [schoolId, id], map: "announcement_recipient_students_announcement_recipient_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student   Student               @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_recipient_students_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "announcement_recipient_students_school_id_id_key")
  @@unique([schoolId, announcementRecipientId, studentId], map: "announcement_recipient_students_key")
  @@index([schoolId, studentId], map: "announcement_recipient_students_school_id_student_id_idx")
  @@map("announcement_recipient_students")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 slice 18: fee setup and payment accounts (phase-3-financial.md §4). Money discipline
// (§3.2): no delete, no truncate, frozen columns and named CHECKs in migration SQL
// (20261005182000_slice18_fee_setup), every object in test/guardrails/schema-checks.ts.
// ---------------------------------------------------------------------------------------------

enum FeeHeadCategory {
  tuition
  admission
  annual
  exam
  fine
  other

  @@map("fee_head_category")
}

enum FeeFrequency {
  monthly
  once
  yearly
  per_term
  ad_hoc

  @@map("fee_frequency")
}

enum FeeHeadStatus {
  active
  archived

  @@map("fee_head_status")
}

enum FeeStructureStatus {
  active
  superseded

  @@map("fee_structure_status")
}

enum PaymentAccountKind {
  bank
  jazzcash
  easypaisa

  @@map("payment_account_kind")
}

enum PaymentAccountStatus {
  active
  disabled

  @@map("payment_account_status")
}

/// Tenant: one row per fee type (rule 8). Five are seeded with the school (created_by null, R176).
/// Category and frequency never change; archive is final. At most one live tuition and one live
/// fine head, and live names are unique (partial unique indexes in migration SQL).
model FeeHead {
  id                 BigInt          @id(map: "fee_heads_pkey") @default(autoincrement())
  schoolId           BigInt          @map("school_id")
  name               String          @db.VarChar(60)
  category           FeeHeadCategory
  frequency          FeeFrequency
  /// Never true for a fine (CHECK fee_heads_fine_concession_check).
  concessionEligible Boolean         @map("concession_eligible")
  /// Never true for admission (CHECK fee_heads_admission_refundable_check, rule 20).
  refundable         Boolean
  status             FeeHeadStatus   @default(active)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  archivedBy         BigInt?         @map("archived_by")
  archiveReason      String?         @map("archive_reason") @db.VarChar(500)
  /// Null for the seeded heads.
  createdBy          BigInt?         @map("created_by")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School           @relation(fields: [schoolId], references: [id], map: "fee_heads_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  createdByUser   User?            @relation("FeeHeadCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "fee_heads_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  archivedByUser  User?            @relation("FeeHeadArchivedBy", fields: [schoolId, archivedBy], references: [schoolId, id], map: "fee_heads_archived_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  structures      FeeStructure[]
  concessionHeads ConcessionHead[]
  campaigns       ChargeCampaign[]
  charges         Charge[]

  @@unique([schoolId, id], map: "fee_heads_school_id_id_key")
  @@index([schoolId, status, name], map: "fee_heads_school_id_status_name_idx")
  @@index([schoolId, createdBy], map: "fee_heads_school_id_created_by_idx")
  @@index([schoolId, archivedBy], map: "fee_heads_school_id_archived_by_idx")
  @@map("fee_heads")
}

/// Tenant: what a class pays for a head from a month on (R177). Active rows are unique per (class,
/// head, effective month); a same-month replacement supersedes the active row, a later month is a
/// new active row. Amount, head, class and month never change; a superseded row stays.
model FeeStructure {
  id             BigInt             @id(map: "fee_structures_pkey") @default(autoincrement())
  schoolId       BigInt             @map("school_id")
  academicYearId BigInt             @map("academic_year_id")
  classId        BigInt             @map("class_id")
  feeHeadId      BigInt             @map("fee_head_id")
  /// Whole rupees, 0 or more; 0 generates nothing.
  amount         Int
  /// `YYYY-MM` (CHECK fee_structures_effective_from_check).
  effectiveFrom  String             @map("effective_from") @db.Char(7)
  status         FeeStructureStatus @default(active)
  /// The row that replaced this one in the same month; set once, after the replacement exists.
  supersededBy   BigInt?            @map("superseded_by")
  supersededAt   DateTime?          @map("superseded_at") @db.Timestamptz(3)
  /// Required when the row supersedes another (the service); never an identity number.
  reason         String?            @db.VarChar(500)
  createdBy      BigInt             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School         @relation(fields: [schoolId], references: [id], map: "fee_structures_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  /// The class is of the row's year (classes (school_id, id, academic_year_id)).
  class         Class          @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "fee_structures_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  feeHead       FeeHead        @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], map: "fee_structures_fee_head_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  successor     FeeStructure?  @relation("FeeStructureSupersededBy", fields: [schoolId, supersededBy], references: [schoolId, id], map: "fee_structures_superseded_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  predecessors  FeeStructure[] @relation("FeeStructureSupersededBy")
  createdByUser User           @relation(fields: [schoolId, createdBy], references: [schoolId, id], map: "fee_structures_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "fee_structures_school_id_id_key")
  @@index([schoolId, academicYearId, classId], map: "fee_structures_school_id_academic_year_id_class_id_idx")
  @@index([schoolId, feeHeadId], map: "fee_structures_school_id_fee_head_id_idx")
  @@index([schoolId, supersededBy], map: "fee_structures_school_id_superseded_by_idx")
  @@index([schoolId, createdBy], map: "fee_structures_school_id_created_by_idx")
  @@map("fee_structures")
}

/// Tenant: a bank or wallet account guardians can pay into (rule 21); an active one turns the
/// deposit-claim flow on. Never edited: a change is a new row and the old one disabled.
model SchoolPaymentAccount {
  id            BigInt               @id(map: "school_payment_accounts_pkey") @default(autoincrement())
  schoolId      BigInt               @map("school_id")
  kind          PaymentAccountKind
  /// The account holder's name as the bank shows it.
  title         String               @db.VarChar(100)
  /// Letters, digits and dashes; never an identity number's shape (CHECK).
  accountNo     String               @map("account_no") @db.VarChar(34)
  /// Banks only (CHECK school_payment_accounts_bank_name_check).
  bankName      String?              @map("bank_name") @db.VarChar(100)
  status        PaymentAccountStatus @default(active)
  disabledAt    DateTime?            @map("disabled_at") @db.Timestamptz(3)
  disabledBy    BigInt?              @map("disabled_by")
  disableReason String?              @map("disable_reason") @db.VarChar(500)
  createdBy     BigInt               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School @relation(fields: [schoolId], references: [id], map: "school_payment_accounts_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  createdByUser  User   @relation("PaymentAccountCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "school_payment_accounts_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  disabledByUser User?  @relation("PaymentAccountDisabledBy", fields: [schoolId, disabledBy], references: [schoolId, id], map: "school_payment_accounts_disabled_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "school_payment_accounts_school_id_id_key")
  @@index([schoolId, status, createdAt], map: "school_payment_accounts_school_id_status_created_at_idx")
  @@index([schoolId, createdBy], map: "school_payment_accounts_school_id_created_by_idx")
  @@index([schoolId, disabledBy], map: "school_payment_accounts_school_id_disabled_by_idx")
  @@map("school_payment_accounts")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 wave I schema groundwork (phase-3-financial.md §3.2, §4): slice 19 concessions, charges
// and runs; slice 23 expenses; slice 24 leave; slice 26 platform billing. Money discipline in
// migration SQL (20261006100100_slice19_charges, 20261006100200_slice23_expenses,
// 20261006100300_slice24_leave, 20261006100400_slice26_platform_billing), every named object in
// test/guardrails/schema-checks.ts (WAVE_I_OBJECTS).
// ---------------------------------------------------------------------------------------------

enum ConcessionKind {
  percentage
  fixed

  @@map("concession_kind")
}

enum ConcessionStatus {
  requested
  approved
  rejected
  ended

  @@map("concession_status")
}

enum ChargeKind {
  generated
  campaign
  manual
  late_fee
  adjustment

  @@map("charge_kind")
}

/// `open -> settled | voided | waived`; `settled -> open` only while asms.reversing_payment is
/// 'on' (trigger charges_status_transition).
enum ChargeStatus {
  open
  settled
  voided
  waived

  @@map("charge_status")
}

enum ChargeRunKind {
  monthly
  campaign

  @@map("charge_run_kind")
}

enum ChargeRunStatus {
  queued
  running
  done
  failed

  @@map("charge_run_status")
}

enum CampaignStatus {
  draft
  generating
  generated
  cancelled

  @@map("campaign_status")
}

/// Shared by expenses (slice 23) and payments (slice 20). `carried_forward` is internal: written
/// by a carry-forward, never offered at the counter, never an expense's method (CHECK).
enum PaymentMethod {
  cash
  bank_transfer
  jazzcash
  easypaisa
  carried_forward

  @@map("payment_method")
}

/// Created in its own migration (20261006100000_wave_i_expense_category), before expenses.
enum ExpenseCategory {
  electricity
  water
  internet
  cleaning
  stationery
  repairs
  maintenance
  fuel
  transport
  building
  daily_purchases
  salary_advance_cash
  cash_shortfall
  other

  @@map("expense_category")
}

enum ExpenseStatus {
  recorded
  pending_approval
  approved
  rejected
  voided

  @@map("expense_status")
}

enum LeaveCode {
  casual
  sick
  unpaid
  other

  @@map("leave_code")
}

enum LeaveTypeStatus {
  active
  archived

  @@map("leave_type_status")
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
  ended_early

  @@map("leave_status")
}

enum PlanStatus {
  active
  archived

  @@map("plan_status")
}

enum InvoiceStatus {
  issued
  paid
  void

  @@map("invoice_status")
}

/// Tenant: a concession for one student in one academic year (R182, R183), reducing the named
/// heads (concession_heads) from effective_from. `requested` by charge.create, decided by a
/// principal; a principal holding both keys creates it approved. One live concession per student
/// per year per head is a service check under the student-row lock. Never decided for the
/// decider's own child, except by the sole principal with self_approved (trigger
/// concessions_own_child, R232, R253).
model Concession {
  id             BigInt           @id(map: "concessions_pkey") @default(autoincrement())
  schoolId       BigInt           @map("school_id")
  studentId      BigInt           @map("student_id")
  academicYearId BigInt           @map("academic_year_id")
  /// The originating enrolment; the concession follows the student within the year (R182).
  enrolmentId    BigInt           @map("enrolment_id")
  kind           ConcessionKind
  /// 1-100 for percentage; > 0 whole rupees per charge for fixed (CHECK concessions_value_check).
  value          Int
  /// `YYYY-MM`.
  effectiveFrom  String           @map("effective_from") @db.Char(7)
  reason         String           @db.VarChar(500)
  status         ConcessionStatus @default(requested)
  requestedBy    BigInt           @map("requested_by")
  requestedAt    DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedBy      BigInt?          @map("decided_by")
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(3)
  /// Required on a rejection (CHECK concessions_decided_check).
  decisionReason String?          @map("decision_reason") @db.VarChar(500)
  /// The sole principal's decision for their own child (R253).
  selfApproved   Boolean          @default(false) @map("self_approved")
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(3)
  endedBy        BigInt?          @map("ended_by")
  endReason      String?          @map("end_reason") @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School           @relation(fields: [schoolId], references: [id], map: "concessions_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  /// The enrolment, the child and the year together (four-column FK).
  enrolment       Enrolment        @relation(fields: [schoolId, enrolmentId, studentId, academicYearId], references: [schoolId, id, studentId, academicYearId], map: "concessions_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  requestedByUser User             @relation("ConcessionRequestedBy", fields: [schoolId, requestedBy], references: [schoolId, id], map: "concessions_requested_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  decidedByUser   User?            @relation("ConcessionDecidedBy", fields: [schoolId, decidedBy], references: [schoolId, id], map: "concessions_decided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  endedByUser     User?            @relation("ConcessionEndedBy", fields: [schoolId, endedBy], references: [schoolId, id], map: "concessions_ended_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  heads           ConcessionHead[]
  charges         Charge[]

  @@unique([schoolId, id], map: "concessions_school_id_id_key")
  /// The target of charges.concession_id: a charge names a concession of its own child and year.
  @@unique([schoolId, id, studentId, academicYearId], map: "concessions_school_id_id_student_id_academic_year_id_key")
  @@index([schoolId, studentId, academicYearId, status], map: "concessions_school_id_student_id_academic_year_id_status_idx")
  /// The principal's queue (status = requested).
  @@index([schoolId, status, requestedAt], map: "concessions_school_id_status_requested_at_idx")
  @@index([schoolId, enrolmentId, studentId, academicYearId], map: "concessions_school_id_enrolment_id_idx")
  @@index([schoolId, requestedBy], map: "concessions_school_id_requested_by_idx")
  @@index([schoolId, decidedBy], map: "concessions_school_id_decided_by_idx")
  @@index([schoolId, endedBy], map: "concessions_school_id_ended_by_idx")
  @@map("concessions")
}

/// Tenant, append-only: a head a concession reduces. Eligibility (fee_heads.concession_eligible)
/// is a service check (CONCESSION_HEAD_NOT_ELIGIBLE).
model ConcessionHead {
  id           BigInt   @id(map: "concession_heads_pkey") @default(autoincrement())
  schoolId     BigInt   @map("school_id")
  concessionId BigInt   @map("concession_id")
  feeHeadId    BigInt   @map("fee_head_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school     School     @relation(fields: [schoolId], references: [id], map: "concession_heads_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  concession Concession @relation(fields: [schoolId, concessionId], references: [schoolId, id], map: "concession_heads_concession_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  feeHead    FeeHead    @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], map: "concession_heads_fee_head_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "concession_heads_school_id_id_key")
  @@unique([schoolId, concessionId, feeHeadId], map: "concession_heads_school_id_concession_id_fee_head_id_key")
  @@index([schoolId, feeHeadId], map: "concession_heads_school_id_fee_head_id_idx")
  @@map("concession_heads")
}

/// Tenant: one generation run, monthly or campaign (§3.7, R179). At most one queued or running
/// run per (year, period, kind) (partial unique charge_runs_period_key). A daily catch-up writes a
/// row only when it inserted something. The outbox sweep fails a stale run (error_code 'stale',
/// R252). Identity columns frozen; counts and status move.
model ChargeRun {
  id               BigInt          @id(map: "charge_runs_pkey") @default(autoincrement())
  schoolId         BigInt          @map("school_id")
  academicYearId   BigInt          @map("academic_year_id")
  /// `YYYY-MM`: the month generated; for a campaign run, the month it was generated in.
  period           String          @db.Char(7)
  kind             ChargeRunKind
  /// Set iff kind = campaign (CHECK charge_runs_campaign_check).
  campaignId       BigInt?         @map("campaign_id")
  status           ChargeRunStatus @default(queued)
  /// Null for the schedule.
  triggeredBy      BigInt?         @map("triggered_by")
  queuedAt         DateTime        @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt        DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz(3)
  studentsCharged  Int             @default(0) @map("students_charged")
  chargesInserted  Int             @default(0) @map("charges_inserted")
  chargesSkipped   Int             @default(0) @map("charges_skipped")
  /// `[{ classId, reason }]` objects only (CHECK charge_runs_skipped_classes_check).
  skippedClasses   Json            @default("[]") @map("skipped_classes")
  /// A manual monthly run that recreates voided generated charges.
  regenerateVoided Boolean         @default(false) @map("regenerate_voided")
  /// Set iff failed; 'stale' when the sweep failed it.
  errorCode        String?         @map("error_code") @db.VarChar(32)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School          @relation(fields: [schoolId], references: [id], map: "charge_runs_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  academicYear    AcademicYear    @relation(fields: [schoolId, academicYearId], references: [schoolId, id], map: "charge_runs_academic_year_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// A campaign of the run's year.
  campaign        ChargeCampaign? @relation(fields: [schoolId, campaignId, academicYearId], references: [schoolId, id, academicYearId], map: "charge_runs_campaign_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  triggeredByUser User?           @relation(fields: [schoolId, triggeredBy], references: [schoolId, id], map: "charge_runs_triggered_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "charge_runs_school_id_id_key")
  @@index([schoolId, academicYearId, period], map: "charge_runs_school_id_academic_year_id_period_idx")
  /// The stale sweep.
  @@index([schoolId, status, queuedAt], map: "charge_runs_school_id_status_queued_at_idx")
  @@index([schoolId, campaignId, academicYearId], map: "charge_runs_school_id_campaign_id_idx")
  @@index([schoolId, triggeredBy], map: "charge_runs_school_id_triggered_by_idx")
  @@map("charge_runs")
}

/// Tenant: a one-off charge to an audience of students (R184), e.g. an exam fee. Content is
/// editable while draft (trigger charge_campaigns_content_frozen); `generating` returns to draft if
/// its run fails or goes stale.
model ChargeCampaign {
  id               BigInt         @id(map: "charge_campaigns_pkey") @default(autoincrement())
  schoolId         BigInt         @map("school_id")
  name             String         @db.VarChar(120)
  academicYearId   BigInt         @map("academic_year_id")
  feeHeadId        BigInt         @map("fee_head_id")
  /// Whole rupees > 0.
  amount           Int
  dueOn            DateTime       @map("due_on") @db.Date
  description      String?        @db.VarChar(500)
  applyConcessions Boolean        @default(false) @map("apply_concessions")
  status           CampaignStatus @default(draft)
  createdBy        BigInt         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set together, iff generated, and kept if a generated campaign is cancelled
  /// (CHECK charge_campaigns_generated_check).
  generatedAt      DateTime?      @map("generated_at") @db.Timestamptz(3)
  generatedCount   Int?           @map("generated_count")
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy      BigInt?        @map("cancelled_by")
  cancelReason     String?        @map("cancel_reason") @db.VarChar(500)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School                   @relation(fields: [schoolId], references: [id], map: "charge_campaigns_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  academicYear    AcademicYear             @relation(fields: [schoolId, academicYearId], references: [schoolId, id], map: "charge_campaigns_academic_year_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  feeHead         FeeHead                  @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], map: "charge_campaigns_fee_head_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  createdByUser   User                     @relation("ChargeCampaignCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "charge_campaigns_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User?                    @relation("ChargeCampaignCancelledBy", fields: [schoolId, cancelledBy], references: [schoolId, id], map: "charge_campaigns_cancelled_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  audiences       ChargeCampaignAudience[]
  runs            ChargeRun[]
  charges         Charge[]

  @@unique([schoolId, id], map: "charge_campaigns_school_id_id_key")
  /// The target of charges.campaign_id and charge_runs.campaign_id: same year.
  @@unique([schoolId, id, academicYearId], map: "charge_campaigns_school_id_id_academic_year_id_key")
  @@index([schoolId, academicYearId, status], map: "charge_campaigns_school_id_academic_year_id_status_idx")
  @@index([schoolId, feeHeadId], map: "charge_campaigns_school_id_fee_head_id_idx")
  @@index([schoolId, createdBy], map: "charge_campaigns_school_id_created_by_idx")
  @@index([schoolId, cancelledBy], map: "charge_campaigns_school_id_cancelled_by_idx")
  @@map("charge_campaigns")
}

/// Tenant: one audience item of a campaign, the announcement_audiences shape restricted to the
/// student kinds (CHECK charge_campaign_audiences_kind_check). Rows are written and removed only
/// while the campaign is a draft (trigger charge_campaign_audiences_draft_only), so a generated
/// campaign keeps its audience.
model ChargeCampaignAudience {
  id         BigInt       @id(map: "charge_campaign_audiences_pkey") @default(autoincrement())
  schoolId   BigInt       @map("school_id")
  campaignId BigInt       @map("campaign_id")
  kind       AudienceKind
  classId    BigInt?      @map("class_id")
  sectionId  BigInt?      @map("section_id")
  studentId  BigInt?      @map("student_id")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  school   School         @relation(fields: [schoolId], references: [id], map: "charge_campaign_audiences_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  campaign ChargeCampaign @relation(fields: [schoolId, campaignId], references: [schoolId, id], map: "charge_campaign_audiences_campaign_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  class    Class?         @relation(fields: [schoolId, classId], references: [schoolId, id], map: "charge_campaign_audiences_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section  Section?       @relation(fields: [schoolId, sectionId], references: [schoolId, id], map: "charge_campaign_audiences_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student  Student?       @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "charge_campaign_audiences_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "charge_campaign_audiences_school_id_id_key")
  @@index([schoolId, campaignId], map: "charge_campaign_audiences_school_id_campaign_id_idx")
  @@index([schoolId, classId], map: "charge_campaign_audiences_school_id_class_id_idx")
  @@index([schoolId, sectionId], map: "charge_campaign_audiences_school_id_section_id_idx")
  @@index([schoolId, studentId], map: "charge_campaign_audiences_school_id_student_id_idx")
  @@map("charge_campaign_audiences")
}

/// Tenant: one charge to one student (R179-R186, R239-R241). Amount, student, head and period
/// never change; only status, settled_at, allocated_amount, credited_amount and the void and
/// waive columns move. outstanding = amount - allocated_amount - credited_amount; an open charge
/// has outstanding > 0 and a settled one 0 (CHECK charges_settled_outstanding_check; adjustment
/// rows excepted). An adjustment is its own settled row whose insert raises the original's
/// credited_amount (trigger charges_adjustment_credit). Idempotency keys (partial uniques in
/// migration SQL): charges_generated_key, charges_once_key, charges_yearly_key,
/// charges_late_fee_key, charges_campaign_key.
model Charge {
  id                 BigInt       @id(map: "charges_pkey") @default(autoincrement())
  schoolId           BigInt       @map("school_id")
  enrolmentId        BigInt       @map("enrolment_id")
  studentId          BigInt       @map("student_id")
  academicYearId     BigInt       @map("academic_year_id")
  feeHeadId          BigInt       @map("fee_head_id")
  /// The head's frequency when charged, frozen (the idempotency keys read it).
  headFrequency      FeeFrequency @map("head_frequency")
  kind               ChargeKind
  /// `YYYY-MM`: set on a generated monthly charge and a late fee; absent on generated once and
  /// yearly charges (CHECK charges_generated_period_check).
  period             String?      @db.Char(7)
  campaignId         BigInt?      @map("campaign_id")
  lateFeeForChargeId BigInt?      @map("late_fee_for_charge_id")
  adjustsChargeId    BigInt?      @map("adjusts_charge_id")
  concessionId       BigInt?      @map("concession_id")
  grossAmount        Int          @map("gross_amount")
  concessionAmount   Int          @default(0) @map("concession_amount")
  /// gross_amount - concession_amount (CHECK charges_amount_check).
  amount             Int
  /// Trigger-maintained (slice 20's allocation and reversal triggers); never re-summed.
  allocatedAmount    Int          @default(0) @map("allocated_amount")
  /// Trigger-maintained: raised by each adjustment row (trigger charges_adjustment_credit).
  creditedAmount     Int          @default(0) @map("credited_amount")
  description        String       @db.VarChar(200)
  /// Rule 25: the charge-due date (payments carry the verified date).
  dueOn              DateTime     @map("due_on") @db.Date
  status             ChargeStatus @default(open)
  /// Set iff settled (CHECK charges_settled_check).
  settledAt          DateTime?    @map("settled_at") @db.Timestamptz(3)
  voidedAt           DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedBy           BigInt?      @map("voided_by")
  voidReason         String?      @map("void_reason") @db.VarChar(500)
  /// Late fees only (CHECK charges_waived_check).
  waivedAt           DateTime?    @map("waived_at") @db.Timestamptz(3)
  waivedBy           BigInt?      @map("waived_by")
  waiveReason        String?      @map("waive_reason") @db.VarChar(500)
  /// Null when written by a job (generation and late fees run as the system actor).
  createdBy          BigInt?      @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School              @relation(fields: [schoolId], references: [id], map: "charges_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  /// The enrolment, the child and the year together (four-column FK).
  enrolment     Enrolment           @relation(fields: [schoolId, enrolmentId, studentId, academicYearId], references: [schoolId, id, studentId, academicYearId], map: "charges_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  feeHead       FeeHead             @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], map: "charges_fee_head_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// A campaign of the charge's year.
  campaign      ChargeCampaign?     @relation(fields: [schoolId, campaignId, academicYearId], references: [schoolId, id, academicYearId], map: "charges_campaign_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The charge a late fee is for: same child and year.
  lateFeeFor    Charge?             @relation("ChargeLateFeeFor", fields: [schoolId, lateFeeForChargeId, academicYearId, studentId], references: [schoolId, id, academicYearId, studentId], map: "charges_late_fee_for_charge_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  lateFees      Charge[]            @relation("ChargeLateFeeFor")
  /// The charge an adjustment credits: same child and year.
  adjusts       Charge?             @relation("ChargeAdjusts", fields: [schoolId, adjustsChargeId, academicYearId, studentId], references: [schoolId, id, academicYearId, studentId], map: "charges_adjusts_charge_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  adjustments   Charge[]            @relation("ChargeAdjusts")
  /// A concession of the same child and year.
  concession    Concession?         @relation(fields: [schoolId, concessionId, studentId, academicYearId], references: [schoolId, id, studentId, academicYearId], map: "charges_concession_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  createdByUser User?               @relation("ChargeCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "charges_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  voidedByUser  User?               @relation("ChargeVoidedBy", fields: [schoolId, voidedBy], references: [schoolId, id], map: "charges_voided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  waivedByUser  User?               @relation("ChargeWaivedBy", fields: [schoolId, waivedBy], references: [schoolId, id], map: "charges_waived_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  allocations   PaymentAllocation[]
  receiptLines  ReceiptLine[]

  @@unique([schoolId, id], map: "charges_school_id_id_key")
  /// The target of charge-linked rows (late fees, adjustments, slice 20's allocations and lines).
  @@unique([schoolId, id, academicYearId, studentId], map: "charges_school_id_id_academic_year_id_student_id_key")
  @@index([schoolId, studentId, dueOn], map: "charges_school_id_student_id_due_on_idx")
  @@index([schoolId, status, dueOn], map: "charges_school_id_status_due_on_idx")
  @@index([schoolId, academicYearId, period], map: "charges_school_id_academic_year_id_period_idx")
  @@index([schoolId, feeHeadId], map: "charges_school_id_fee_head_id_idx")
  @@index([schoolId, enrolmentId, studentId, academicYearId], map: "charges_school_id_enrolment_id_idx")
  @@index([schoolId, campaignId, academicYearId], map: "charges_school_id_campaign_id_idx")
  @@index([schoolId, concessionId, studentId, academicYearId], map: "charges_school_id_concession_id_idx")
  @@index([schoolId, lateFeeForChargeId, academicYearId, studentId], map: "charges_school_id_late_fee_for_charge_id_idx")
  @@index([schoolId, adjustsChargeId, academicYearId, studentId], map: "charges_school_id_adjusts_charge_id_idx")
  @@index([schoolId, createdBy], map: "charges_school_id_created_by_idx")
  @@index([schoolId, voidedBy], map: "charges_school_id_voided_by_idx")
  @@index([schoolId, waivedBy], map: "charges_school_id_waived_by_idx")
  @@map("charges")
}

/// Tenant: money the school spent (R206-R208, R244). Calendar-scoped, no academic year. Numbered
/// from the school's expense_no counter. Content is editable while recorded or pending_approval
/// (trigger expenses_content_frozen); nobody approves, rejects or voids-after-approval their own
/// except a principal's self-approval on record (trigger expenses_not_self).
model Expense {
  id               BigInt          @id(map: "expenses_pkey") @default(autoincrement())
  schoolId         BigInt          @map("school_id")
  /// From school_counters 'expense_no'; unique per school.
  expenseNo        Int             @map("expense_no")
  category         ExpenseCategory
  /// Whole rupees > 0.
  amount           Int
  spentOn          DateTime        @map("spent_on") @db.Date
  description      String          @db.VarChar(500)
  payee            String?         @db.VarChar(100)
  /// Never carried_forward (CHECK expenses_method_check).
  method           PaymentMethod
  reference        String?         @db.VarChar(60)
  /// `{school_id}/{ULID}.{jpg|png|pdf}`; key, mime and size together, set once.
  receiptObjectKey String?         @map("receipt_object_key") @db.VarChar(64)
  receiptMime      String?         @map("receipt_mime") @db.VarChar(32)
  receiptSizeBytes Int?            @map("receipt_size_bytes")
  status           ExpenseStatus
  recordedBy       BigInt          @map("recorded_by")
  recordedAt       DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  decidedBy        BigInt?         @map("decided_by")
  decidedAt        DateTime?       @map("decided_at") @db.Timestamptz(3)
  /// Required on a rejection (CHECK expenses_decided_check).
  decisionReason   String?         @map("decision_reason") @db.VarChar(500)
  /// A principal's own expense above the threshold, approved as recorded (R206).
  selfApproved     Boolean         @default(false) @map("self_approved")
  voidedAt         DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedBy         BigInt?         @map("voided_by")
  voidReason       String?         @map("void_reason") @db.VarChar(500)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school             School          @relation(fields: [schoolId], references: [id], map: "expenses_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  recordedByUser     User            @relation("ExpenseRecordedBy", fields: [schoolId, recordedBy], references: [schoolId, id], map: "expenses_recorded_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  decidedByUser      User?           @relation("ExpenseDecidedBy", fields: [schoolId, decidedBy], references: [schoolId, id], map: "expenses_decided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  voidedByUser       User?           @relation("ExpenseVoidedBy", fields: [schoolId, voidedBy], references: [schoolId, id], map: "expenses_voided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  shortfallHandovers CashHandover[]
  salaryAdvances     SalaryAdvance[]

  @@unique([schoolId, id], map: "expenses_school_id_id_key")
  @@unique([schoolId, expenseNo], map: "expenses_school_id_expense_no_key")
  @@index([schoolId, spentOn], map: "expenses_school_id_spent_on_idx")
  @@index([schoolId, status, recordedAt], map: "expenses_school_id_status_recorded_at_idx")
  @@index([schoolId, category, spentOn], map: "expenses_school_id_category_spent_on_idx")
  @@index([schoolId, recordedBy, spentOn], map: "expenses_school_id_recorded_by_spent_on_idx")
  @@index([schoolId, decidedBy], map: "expenses_school_id_decided_by_idx")
  @@index([schoolId, voidedBy], map: "expenses_school_id_voided_by_idx")
  @@map("expenses")
}

/// Tenant: a kind of staff leave (R209). Three are seeded with the school (created_by null,
/// asms_seed_school_finance); a type never changes (a different entitlement is a new type) and
/// archive is final. Live names are unique, case-insensitively (leave_types_live_name_key).
model LeaveType {
  id          BigInt          @id(map: "leave_types_pkey") @default(autoincrement())
  schoolId    BigInt          @map("school_id")
  name        String          @db.VarChar(40)
  code        LeaveCode
  /// Null = unlimited; else 1-366 (CHECK leave_types_days_per_year_check).
  daysPerYear Int?            @map("days_per_year") @db.SmallInt
  /// Never true for `unpaid` (CHECK leave_types_paid_check).
  paid        Boolean
  status      LeaveTypeStatus @default(active)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)
  archivedBy  BigInt?         @map("archived_by")
  /// Null for the seeded types.
  createdBy   BigInt?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School         @relation(fields: [schoolId], references: [id], map: "leave_types_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  createdByUser  User?          @relation("LeaveTypeCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "leave_types_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  archivedByUser User?          @relation("LeaveTypeArchivedBy", fields: [schoolId, archivedBy], references: [schoolId, id], map: "leave_types_archived_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  requests       LeaveRequest[]

  @@unique([schoolId, id], map: "leave_types_school_id_id_key")
  @@index([schoolId, status, name], map: "leave_types_school_id_status_name_idx")
  @@index([schoolId, createdBy], map: "leave_types_school_id_created_by_idx")
  @@index([schoolId, archivedBy], map: "leave_types_school_id_archived_by_idx")
  @@map("leave_types")
}

/// Tenant: a staff member's leave request (R209-R212, R248). Calendar-scoped, no academic year.
/// Live requests of one staff member never overlap (exclusion constraint
/// leave_requests_live_excl); nobody decides or ends their own leave except the sole principal
/// approving their own, self_approved (trigger leave_requests_not_self, R210, R253).
model LeaveRequest {
  id                BigInt      @id(map: "leave_requests_pkey") @default(autoincrement())
  schoolId          BigInt      @map("school_id")
  staffId           BigInt      @map("staff_id")
  leaveTypeId       BigInt      @map("leave_type_id")
  startsOn          DateTime    @map("starts_on") @db.Date
  /// starts_on .. starts_on + 59 days (CHECK leave_requests_dates_check).
  endsOn            DateTime    @map("ends_on") @db.Date
  /// Frozen at request (R209).
  workingDays       Int         @map("working_days") @db.SmallInt
  reason            String      @db.VarChar(500)
  status            LeaveStatus @default(pending)
  requestedBy       BigInt      @map("requested_by")
  requestedAt       DateTime    @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// Recorded by an approver for the staff member; still needs another decider (R210).
  onBehalf          Boolean     @default(false) @map("on_behalf")
  decidedBy         BigInt?     @map("decided_by")
  decidedAt         DateTime?   @map("decided_at") @db.Timestamptz(3)
  /// Required on a rejection (CHECK leave_requests_decided_check).
  decisionReason    String?     @map("decision_reason") @db.VarChar(500)
  /// The sole principal approving their own leave (R253).
  selfApproved      Boolean     @default(false) @map("self_approved")
  /// The cover created on approval (R212); set once.
  coverAssignmentId BigInt?     @map("cover_assignment_id")
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy       BigInt?     @map("cancelled_by")
  cancelReason      String?     @map("cancel_reason") @db.VarChar(500)
  /// Set iff ended_early, inside the request's dates (CHECK leave_requests_ended_early_check).
  endedEarlyOn      DateTime?   @map("ended_early_on") @db.Date
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School             @relation(fields: [schoolId], references: [id], map: "leave_requests_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff           Staff              @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "leave_requests_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  leaveType       LeaveType          @relation(fields: [schoolId, leaveTypeId], references: [schoolId, id], map: "leave_requests_leave_type_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  requestedByUser User               @relation("LeaveRequestRequestedBy", fields: [schoolId, requestedBy], references: [schoolId, id], map: "leave_requests_requested_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  decidedByUser   User?              @relation("LeaveRequestDecidedBy", fields: [schoolId, decidedBy], references: [schoolId, id], map: "leave_requests_decided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User?              @relation("LeaveRequestCancelledBy", fields: [schoolId, cancelledBy], references: [schoolId, id], map: "leave_requests_cancelled_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  coverAssignment TeacherAssignment? @relation(fields: [schoolId, coverAssignmentId], references: [schoolId, id], map: "leave_requests_cover_assignment_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "leave_requests_school_id_id_key")
  @@index([schoolId, staffId, startsOn], map: "leave_requests_school_id_staff_id_starts_on_idx")
  @@index([schoolId, status, requestedAt], map: "leave_requests_school_id_status_requested_at_idx")
  @@index([schoolId, leaveTypeId], map: "leave_requests_school_id_leave_type_id_idx")
  @@index([schoolId, coverAssignmentId], map: "leave_requests_school_id_cover_assignment_id_idx")
  @@index([schoolId, requestedBy], map: "leave_requests_school_id_requested_by_idx")
  @@index([schoolId, decidedBy], map: "leave_requests_school_id_decided_by_idx")
  @@index([schoolId, cancelledBy], map: "leave_requests_school_id_cancelled_by_idx")
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 wave J schema groundwork (phase-3-financial.md §3.2, §3.4, §3.5, §4): slice 20 payments,
// allocations, receipts, reversals and cash handovers; slice 25 salary structures, advances,
// payroll runs and payslips. Money discipline in migration SQL (20261006140000_slice20_payments,
// 20261006140100_slice25_payroll), every named object in test/guardrails/schema-checks.ts
// (WAVE_J_OBJECTS).
// ---------------------------------------------------------------------------------------------

/// `verified -> voided` (trigger payments_status_transition); a void is a payment_reversals row.
enum PaymentStatus {
  verified
  voided

  @@map("payment_status")
}

/// `carried_forward` moves an advance to another year (R251): a reversal plus a new payment.
enum ReversalKind {
  void
  refund
  refund_reversal
  carried_forward

  @@map("reversal_kind")
}

enum HandoverStatus {
  open
  confirmed

  @@map("handover_status")
}

enum ShortfallResolution {
  recovered
  written_off
  explained_by_void

  @@map("shortfall_resolution")
}

/// Tenant: money received for one academic year (R187-R189), verified when recorded (rule 25:
/// verified_at). unallocated_amount starts at amount (trigger payments_unallocated_init) and moves
/// only through the allocation and reversal triggers, bounded by payments_unallocated_amount_check;
/// a remainder above 0 must name advance_for_student_id by commit (deferred constraint trigger
/// payments_advance_student_required). A cash payment sits in its recorder's custody until a
/// handover of that recorder gathers it (handover_id, set once; the FK binds handover and
/// recorder). Never recorded for the recorder's own child (trigger payments_own_child, R232).
model Payment {
  id                    BigInt        @id(map: "payments_pkey") @default(autoincrement())
  schoolId              BigInt        @map("school_id")
  academicYearId        BigInt        @map("academic_year_id")
  /// Exactly one of payer_guardian_id and payer_name (CHECK payments_payer_check).
  payerGuardianId       BigInt?       @map("payer_guardian_id")
  /// A walk-in payer; names one student (the service).
  payerName             String?       @map("payer_name") @db.VarChar(100)
  method                PaymentMethod
  /// Whole rupees > 0.
  amount                Int
  /// Trigger-maintained; never re-summed. Starts at amount.
  unallocatedAmount     Int           @default(0) @map("unallocated_amount")
  receivedOn            DateTime      @map("received_on") @db.Date
  /// Required for bank_transfer, jazzcash and easypaisa (CHECK payments_reference_required_check).
  reference             String?       @db.VarChar(60)
  /// Set iff method = carried_forward: the reversal that moved the money here (R251).
  carriedFromReversalId BigInt?       @map("carried_from_reversal_id")
  recordedBy            BigInt        @map("recorded_by")
  recordedAt            DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Rule 25: who verified, and when (the office path: the recorder, at recording).
  verifiedBy            BigInt        @map("verified_by")
  verifiedAt            DateTime      @default(now()) @map("verified_at") @db.Timestamptz(3)
  /// Cash only (CHECK payments_handover_cash_check); set once, while the handover is open.
  handoverId            BigInt?       @map("handover_id")
  /// The child an unallocated remainder belongs to (R189); set once.
  advanceForStudentId   BigInt?       @map("advance_for_student_id")
  status                PaymentStatus @default(verified)
  voidedAt              DateTime?     @map("voided_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school              School              @relation(fields: [schoolId], references: [id], map: "payments_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  academicYear        AcademicYear        @relation(fields: [schoolId, academicYearId], references: [schoolId, id], map: "payments_academic_year_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  payerGuardian       Guardian?           @relation(fields: [schoolId, payerGuardianId], references: [schoolId, id], map: "payments_payer_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  carriedFromReversal PaymentReversal?    @relation("PaymentCarriedFrom", fields: [schoolId, carriedFromReversalId], references: [schoolId, id], map: "payments_carried_from_reversal_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  recordedByUser      User                @relation("PaymentRecordedBy", fields: [schoolId, recordedBy], references: [schoolId, id], map: "payments_recorded_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  verifiedByUser      User                @relation("PaymentVerifiedBy", fields: [schoolId, verifiedBy], references: [schoolId, id], map: "payments_verified_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// A handover of the payment's own recorder (cash_handovers (school_id, id, collector_user_id)).
  handover            CashHandover?       @relation(fields: [schoolId, handoverId, recordedBy], references: [schoolId, id, collectorUserId], map: "payments_handover_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  advanceForStudent   Student?            @relation(fields: [schoolId, advanceForStudentId], references: [schoolId, id], map: "payments_advance_for_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  allocations         PaymentAllocation[]
  receipt             Receipt?
  reversals           PaymentReversal[]   @relation("ReversalPayment")
  /// The carry-forward reversals that created this payment's target (at most one, R251).
  carriedToReversals  PaymentReversal[]   @relation("ReversalCarriedTo")

  @@unique([schoolId, id], map: "payments_school_id_id_key")
  /// The target of payment-linked rows (allocations, receipts, reversals): same year.
  @@unique([schoolId, id, academicYearId], map: "payments_school_id_id_academic_year_id_key")
  @@index([schoolId, receivedOn], map: "payments_school_id_received_on_idx")
  @@index([schoolId, payerGuardianId, receivedOn], map: "payments_school_id_payer_guardian_id_received_on_idx")
  @@index([schoolId, recordedBy, receivedOn], map: "payments_school_id_recorded_by_received_on_idx")
  @@index([schoolId, handoverId, recordedBy], map: "payments_school_id_handover_id_idx")
  @@index([schoolId, status, receivedOn], map: "payments_school_id_status_received_on_idx")
  @@index([schoolId, advanceForStudentId], map: "payments_school_id_advance_for_student_id_idx")
  @@index([schoolId, verifiedBy], map: "payments_school_id_verified_by_idx")
  @@index([schoolId, academicYearId, receivedOn], map: "payments_school_id_academic_year_id_received_on_idx")
  @@index([schoolId, carriedFromReversalId], map: "payments_school_id_carried_from_reversal_id_idx")
  @@map("payments")
}

/// Tenant: part of a payment applied to one charge of the same year and child (R188). Inserting
/// raises charges.allocated_amount and lowers payments.unallocated_amount under the row locks
/// (statement trigger payment_allocations_apply); setting reversed_at, once, does the opposite and
/// reopens a settled charge (statement trigger payment_allocations_reverse). One live row per
/// payment and charge (partial unique payment_allocations_live_key). Columns frozen.
model PaymentAllocation {
  id             BigInt    @id(map: "payment_allocations_pkey") @default(autoincrement())
  schoolId       BigInt    @map("school_id")
  paymentId      BigInt    @map("payment_id")
  chargeId       BigInt    @map("charge_id")
  studentId      BigInt    @map("student_id")
  academicYearId BigInt    @map("academic_year_id")
  /// Whole rupees > 0.
  amount         Int
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set once: a void, or a credit's de-allocation (A6).
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], map: "payment_allocations_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  payment Payment @relation(fields: [schoolId, paymentId, academicYearId], references: [schoolId, id, academicYearId], map: "payment_allocations_payment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The charge, its child and its year together.
  charge  Charge  @relation(fields: [schoolId, chargeId, academicYearId, studentId], references: [schoolId, id, academicYearId, studentId], map: "payment_allocations_charge_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "payment_allocations_school_id_id_key")
  @@index([schoolId, paymentId, academicYearId], map: "payment_allocations_school_id_payment_id_idx")
  @@index([schoolId, chargeId, academicYearId, studentId], map: "payment_allocations_school_id_charge_id_idx")
  @@index([schoolId, studentId, createdAt], map: "payment_allocations_school_id_student_id_created_at_idx")
  @@map("payment_allocations")
}

/// Tenant: the one receipt of a payment (R190), numbered from the school's receipt_<yearId>
/// counter, taken last in the payment's transaction; unique per school and year
/// (receipts_number_key). A voided payment's receipt keeps its number (voided_at, set once by the
/// void). Otherwise frozen.
model Receipt {
  id             BigInt    @id(map: "receipts_pkey") @default(autoincrement())
  schoolId       BigInt    @map("school_id")
  paymentId      BigInt    @map("payment_id")
  academicYearId BigInt    @map("academic_year_id")
  receiptNo      Int       @map("receipt_no")
  /// The payment's amount, snapshotted.
  amount         Int
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedBy       BigInt    @map("issued_by")
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)

  school       School        @relation(fields: [schoolId], references: [id], map: "receipts_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  payment      Payment       @relation(fields: [schoolId, paymentId, academicYearId], references: [schoolId, id, academicYearId], map: "receipts_payment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  issuedByUser User          @relation(fields: [schoolId, issuedBy], references: [schoolId, id], map: "receipts_issued_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  lines        ReceiptLine[]

  @@unique([schoolId, id], map: "receipts_school_id_id_key")
  /// The target of receipt_lines: same year.
  @@unique([schoolId, id, academicYearId], map: "receipts_school_id_id_academic_year_id_key")
  /// One receipt per payment (the year is the payment's, fixed by the FK).
  @@unique([schoolId, paymentId, academicYearId], map: "receipts_payment_key")
  /// R190: gapless and never reused per school and year.
  @@unique([schoolId, academicYearId, receiptNo], map: "receipts_number_key")
  @@index([schoolId, issuedBy], map: "receipts_school_id_issued_by_idx")
  @@map("receipts")
}

/// Tenant, append-only: a receipt's printed lines, snapshotted (§3.5). charge_id null is the
/// advance line (fee_head_name and period null with it).
model ReceiptLine {
  id             BigInt   @id(map: "receipt_lines_pkey") @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  receiptId      BigInt   @map("receipt_id")
  academicYearId BigInt   @map("academic_year_id")
  studentId      BigInt   @map("student_id")
  chargeId       BigInt?  @map("charge_id")
  feeHeadName    String?  @map("fee_head_name") @db.VarChar(60)
  /// `YYYY-MM`.
  period         String?  @db.Char(7)
  amount         Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], map: "receipt_lines_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  receipt Receipt @relation(fields: [schoolId, receiptId, academicYearId], references: [schoolId, id, academicYearId], map: "receipt_lines_receipt_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "receipt_lines_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The charge, its child and its year together.
  charge  Charge? @relation(fields: [schoolId, chargeId, academicYearId, studentId], references: [schoolId, id, academicYearId, studentId], map: "receipt_lines_charge_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "receipt_lines_school_id_id_key")
  @@index([schoolId, receiptId, academicYearId], map: "receipt_lines_school_id_receipt_id_idx")
  @@index([schoolId, studentId], map: "receipt_lines_school_id_student_id_idx")
  @@index([schoolId, chargeId, academicYearId, studentId], map: "receipt_lines_school_id_charge_id_idx")
  @@map("receipt_lines")
}

/// Tenant, append-only: a correction of a payment (rule 0.19, R191, R192, R251). `void` reverses
/// every live allocation, reopens the charges and voids the payment and its receipt; `refund` and
/// `carried_forward` lower unallocated_amount; `refund_reversal` raises it back (triggers
/// payment_reversals_not_self, payment_reversals_apply). A carry-forward names its target payment
/// once that payment exists (carried_to_payment_id, set once; deferred constraint trigger
/// payment_reversals_carry_forward_linked).
model PaymentReversal {
  id                 BigInt         @id(map: "payment_reversals_pkey") @default(autoincrement())
  schoolId           BigInt         @map("school_id")
  paymentId          BigInt         @map("payment_id")
  academicYearId     BigInt         @map("academic_year_id")
  kind               ReversalKind
  /// Set iff refund_reversal: the refund of the same payment it reverses.
  reversesId         BigInt?        @map("reverses_id")
  /// Only on carried_forward; set once, after the target payment exists.
  carriedToPaymentId BigInt?        @map("carried_to_payment_id")
  /// Whole rupees > 0; a void's is the payment's amount.
  amount             Int
  reason             String         @db.VarChar(500)
  requestedBy        BigInt         @map("requested_by")
  /// The principal approving a refund or refund reversal; null otherwise.
  approvedBy         BigInt?        @map("approved_by")
  /// Set iff refund; never carried_forward.
  refundMethod       PaymentMethod? @map("refund_method")
  refundReference    String?        @map("refund_reference") @db.VarChar(60)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  school              School            @relation(fields: [schoolId], references: [id], map: "payment_reversals_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  payment             Payment           @relation("ReversalPayment", fields: [schoolId, paymentId, academicYearId], references: [schoolId, id, academicYearId], map: "payment_reversals_payment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// A reversal of the same payment.
  reverses            PaymentReversal?  @relation("ReversalReverses", fields: [schoolId, reversesId, paymentId], references: [schoolId, id, paymentId], map: "payment_reversals_reverses_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  reversedBy          PaymentReversal[] @relation("ReversalReverses")
  carriedToPayment    Payment?          @relation("ReversalCarriedTo", fields: [schoolId, carriedToPaymentId], references: [schoolId, id], map: "payment_reversals_carried_to_payment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  carriedPayments     Payment[]         @relation("PaymentCarriedFrom")
  requestedByUser     User              @relation("PaymentReversalRequestedBy", fields: [schoolId, requestedBy], references: [schoolId, id], map: "payment_reversals_requested_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  approvedByUser      User?             @relation("PaymentReversalApprovedBy", fields: [schoolId, approvedBy], references: [schoolId, id], map: "payment_reversals_approved_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  explainedShortfalls CashHandover[]

  @@unique([schoolId, id], map: "payment_reversals_school_id_id_key")
  /// The target of reverses_id: a reversal of the same payment.
  @@unique([schoolId, id, paymentId], map: "payment_reversals_school_id_id_payment_id_key")
  @@index([schoolId, paymentId, academicYearId], map: "payment_reversals_school_id_payment_id_idx")
  @@index([schoolId, reversesId, paymentId], map: "payment_reversals_school_id_reverses_id_idx")
  @@index([schoolId, carriedToPaymentId], map: "payment_reversals_school_id_carried_to_payment_id_idx")
  @@index([schoolId, requestedBy], map: "payment_reversals_school_id_requested_by_idx")
  @@index([schoolId, approvedBy], map: "payment_reversals_school_id_approved_by_idx")
  @@index([schoolId, kind, createdAt], map: "payment_reversals_school_id_kind_created_at_idx")
  @@map("payment_reversals")
}

/// Tenant: one collector's cash gathered for counting (§3.4, R193, R194). expected_amount and
/// payment_count are stored at open and match the payments gathered by commit (deferred
/// constraint trigger cash_handovers_expected_matches). The confirmer is never the collector nor
/// the opener (CHECK cash_handovers_not_self_check); counted - expected = surplus - shortfall. A
/// shortfall is resolved once: recovered, written off (a cash_shortfall expense) or explained by
/// a void of one of its payments.
model CashHandover {
  id                        BigInt               @id(map: "cash_handovers_pkey") @default(autoincrement())
  schoolId                  BigInt               @map("school_id")
  collectorUserId           BigInt               @map("collector_user_id")
  collectorStaffId          BigInt               @map("collector_staff_id")
  openedBy                  BigInt               @map("opened_by")
  /// opened_by <> collector_user_id (CHECK cash_handovers_on_behalf_check).
  onBehalf                  Boolean              @default(false) @map("on_behalf")
  expectedAmount            Int                  @map("expected_amount")
  paymentCount              Int                  @map("payment_count")
  openedAt                  DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// The opener's note.
  note                      String?              @db.VarChar(500)
  status                    HandoverStatus       @default(open)
  confirmedBy               BigInt?              @map("confirmed_by")
  confirmedAt               DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  countedAmount             Int?                 @map("counted_amount")
  shortfallAmount           Int?                 @map("shortfall_amount")
  surplusAmount             Int?                 @map("surplus_amount")
  /// The confirmer's note.
  confirmNote               String?              @map("confirm_note") @db.VarChar(500)
  shortfallResolution       ShortfallResolution? @map("shortfall_resolution")
  shortfallResolvedAt       DateTime?            @map("shortfall_resolved_at") @db.Timestamptz(3)
  shortfallResolvedBy       BigInt?              @map("shortfall_resolved_by")
  shortfallResolutionReason String?              @map("shortfall_resolution_reason") @db.VarChar(500)
  /// Set iff written_off: the cash_shortfall expense.
  shortfallExpenseId        BigInt?              @map("shortfall_expense_id")
  /// Set iff explained_by_void: the void of a payment in this handover.
  shortfallReversalId       BigInt?              @map("shortfall_reversal_id")
  updatedAt                 DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school            School           @relation(fields: [schoolId], references: [id], map: "cash_handovers_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  /// The collector's login and staff record together (users (school_id, id, staff_id)).
  collector         User             @relation("CashHandoverCollector", fields: [schoolId, collectorUserId, collectorStaffId], references: [schoolId, id, staffId], map: "cash_handovers_collector_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  openedByUser      User             @relation("CashHandoverOpenedBy", fields: [schoolId, openedBy], references: [schoolId, id], map: "cash_handovers_opened_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  confirmedByUser   User?            @relation("CashHandoverConfirmedBy", fields: [schoolId, confirmedBy], references: [schoolId, id], map: "cash_handovers_confirmed_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  resolvedByUser    User?            @relation("CashHandoverResolvedBy", fields: [schoolId, shortfallResolvedBy], references: [schoolId, id], map: "cash_handovers_shortfall_resolved_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  shortfallExpense  Expense?         @relation(fields: [schoolId, shortfallExpenseId], references: [schoolId, id], map: "cash_handovers_shortfall_expense_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  shortfallReversal PaymentReversal? @relation(fields: [schoolId, shortfallReversalId], references: [schoolId, id], map: "cash_handovers_shortfall_reversal_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  payments          Payment[]

  @@unique([schoolId, id], map: "cash_handovers_school_id_id_key")
  /// The target of payments.handover_id: a handover of the payment's recorder.
  @@unique([schoolId, id, collectorUserId], map: "cash_handovers_school_id_id_collector_user_id_key")
  @@index([schoolId, status, openedAt], map: "cash_handovers_school_id_status_opened_at_idx")
  @@index([schoolId, confirmedBy], map: "cash_handovers_school_id_confirmed_by_idx")
  @@index([schoolId, collectorUserId, collectorStaffId], map: "cash_handovers_school_id_collector_user_id_idx")
  @@index([schoolId, openedBy], map: "cash_handovers_school_id_opened_by_idx")
  @@index([schoolId, shortfallResolvedBy], map: "cash_handovers_school_id_shortfall_resolved_by_idx")
  @@index([schoolId, shortfallExpenseId], map: "cash_handovers_school_id_shortfall_expense_id_idx")
  @@index([schoolId, shortfallReversalId], map: "cash_handovers_school_id_shortfall_reversal_id_idx")
  @@map("cash_handovers")
}

enum SalaryStructureStatus {
  active
  superseded

  @@map("salary_structure_status")
}

enum SalaryComponentKind {
  allowance
  deduction

  @@map("salary_component_kind")
}

enum AdvanceStatus {
  open
  recovered
  written_off

  @@map("advance_status")
}

enum PayrollRunStatus {
  draft
  finalised

  @@map("payroll_run_status")
}

enum PayslipStatus {
  pending
  paid

  @@map("payslip_status")
}

enum PayslipLineKind {
  allowance
  deduction
  absence
  advance_recovery
  adjustment

  @@map("payslip_line_kind")
}

/// Tenant: a staff member's salary from effective_from (R213, R214). Calendar-scoped, no academic
/// year. Active rows of one staff member never overlap (exclusion constraint
/// salary_structures_live_excl; a null ended_on is open-ended). A later structure closes this one
/// (ended_on, set once); a same-day replacement supersedes it (superseded_at with the status,
/// superseded_by once the replacement exists). Never written for the writer's own staff row
/// except by the sole principal, self_approved (trigger salary_structures_not_self, R235, R253).
model SalaryStructure {
  id            BigInt                @id(map: "salary_structures_pkey") @default(autoincrement())
  schoolId      BigInt                @map("school_id")
  staffId       BigInt                @map("staff_id")
  /// Whole rupees, 0 or more.
  basic         Int
  effectiveFrom DateTime              @map("effective_from") @db.Date
  /// Set once, when a later structure starts; inclusive.
  endedOn       DateTime?             @map("ended_on") @db.Date
  status        SalaryStructureStatus @default(active)
  supersededAt  DateTime?             @map("superseded_at") @db.Timestamptz(3)
  supersededBy  BigInt?               @map("superseded_by")
  reason        String                @db.VarChar(500)
  createdBy     BigInt                @map("created_by")
  /// The sole principal's own structure (R253).
  selfApproved  Boolean               @default(false) @map("self_approved")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School                     @relation(fields: [schoolId], references: [id], map: "salary_structures_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff         Staff                      @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "salary_structures_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The replacement: a structure of the same staff member.
  successor     SalaryStructure?           @relation("SalaryStructureSupersededBy", fields: [schoolId, supersededBy, staffId], references: [schoolId, id, staffId], map: "salary_structures_superseded_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  predecessors  SalaryStructure[]          @relation("SalaryStructureSupersededBy")
  createdByUser User                       @relation(fields: [schoolId, createdBy], references: [schoolId, id], map: "salary_structures_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  components    SalaryStructureComponent[]
  payslips      Payslip[]

  @@unique([schoolId, id], map: "salary_structures_school_id_id_key")
  /// The target of payslips.structure_id and superseded_by: the same staff member.
  @@unique([schoolId, id, staffId], map: "salary_structures_school_id_id_staff_id_key")
  @@index([schoolId, staffId, effectiveFrom], map: "salary_structures_school_id_staff_id_effective_from_idx")
  @@index([schoolId, supersededBy, staffId], map: "salary_structures_school_id_superseded_by_idx")
  @@index([schoolId, createdBy], map: "salary_structures_school_id_created_by_idx")
  @@map("salary_structures")
}

/// Tenant, append-only: a named allowance or deduction of a structure. Deductions are taken in
/// `position` order (§3.3); positions are unique within the structure.
model SalaryStructureComponent {
  id          BigInt              @id(map: "salary_structure_components_pkey") @default(autoincrement())
  schoolId    BigInt              @map("school_id")
  structureId BigInt              @map("structure_id")
  kind        SalaryComponentKind
  name        String              @db.VarChar(60)
  /// Whole rupees > 0.
  amount      Int
  /// 0-19 (at most 20 components).
  position    Int                 @db.SmallInt
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  school    School          @relation(fields: [schoolId], references: [id], map: "salary_structure_components_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  structure SalaryStructure @relation(fields: [schoolId, structureId], references: [schoolId, id], map: "salary_structure_components_structure_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "salary_structure_components_school_id_id_key")
  @@unique([schoolId, structureId, kind, name], map: "salary_structure_components_name_key")
  @@unique([schoolId, structureId, position], map: "salary_structure_components_position_key")
  @@map("salary_structure_components")
}

/// Tenant: money lent to a staff member, recovered from later payslips in instalments (R215).
/// recovered_amount moves only through salary_advance_recoveries (trigger
/// salary_advance_recoveries_apply), bounded by salary_advances_recovered_check; the advance turns
/// recovered when fully repaid. Never granted or written off for the actor's own staff row
/// (trigger salary_advances_not_self, R235).
model SalaryAdvance {
  id               BigInt        @id(map: "salary_advances_pkey") @default(autoincrement())
  schoolId         BigInt        @map("school_id")
  staffId          BigInt        @map("staff_id")
  /// Whole rupees > 0.
  amount           Int
  grantedOn        DateTime      @map("granted_on") @db.Date
  /// `YYYY-MM`: the first payroll month that recovers (default the month after granted_on).
  recoverFrom      String        @map("recover_from") @db.Char(7)
  /// 1 .. amount.
  instalmentAmount Int           @map("instalment_amount")
  /// The principal (the service, requirePrincipal).
  approvedBy       BigInt        @map("approved_by")
  /// Never carried_forward.
  paidMethod       PaymentMethod @map("paid_method")
  paidReference    String?       @map("paid_reference") @db.VarChar(60)
  /// The salary_advance_cash expense written with it (R215); one advance per expense.
  expenseId        BigInt?       @map("expense_id")
  /// Trigger-maintained; never re-summed.
  recoveredAmount  Int           @default(0) @map("recovered_amount")
  status           AdvanceStatus @default(open)
  writtenOffAt     DateTime?     @map("written_off_at") @db.Timestamptz(3)
  writtenOffBy     BigInt?       @map("written_off_by")
  writeOffReason   String?       @map("write_off_reason") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school           School                  @relation(fields: [schoolId], references: [id], map: "salary_advances_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff            Staff                   @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "salary_advances_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  approvedByUser   User                    @relation("SalaryAdvanceApprovedBy", fields: [schoolId, approvedBy], references: [schoolId, id], map: "salary_advances_approved_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  writtenOffByUser User?                   @relation("SalaryAdvanceWrittenOffBy", fields: [schoolId, writtenOffBy], references: [schoolId, id], map: "salary_advances_written_off_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  expense          Expense?                @relation(fields: [schoolId, expenseId], references: [schoolId, id], map: "salary_advances_expense_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  recoveries       SalaryAdvanceRecovery[]

  @@unique([schoolId, id], map: "salary_advances_school_id_id_key")
  /// The target of salary_advance_recoveries: the same staff member.
  @@unique([schoolId, id, staffId], map: "salary_advances_school_id_id_staff_id_key")
  @@index([schoolId, staffId, status], map: "salary_advances_school_id_staff_id_status_idx")
  @@index([schoolId, approvedBy], map: "salary_advances_school_id_approved_by_idx")
  @@index([schoolId, writtenOffBy], map: "salary_advances_school_id_written_off_by_idx")
  @@index([schoolId, expenseId], map: "salary_advances_school_id_expense_id_idx")
  @@map("salary_advances")
}

/// Tenant: one month's payroll (R214). Calendar-scoped, one per school and month. A draft is
/// recomputed in place; once finalised its content and its payslips are frozen.
model PayrollRun {
  id             BigInt           @id(map: "payroll_runs_pkey") @default(autoincrement())
  schoolId       BigInt           @map("school_id")
  /// `YYYY-MM`.
  yearMonth      String           @map("year_month") @db.Char(7)
  /// 0-31.
  workingDays    Int              @map("working_days") @db.SmallInt
  status         PayrollRunStatus @default(draft)
  preparedAt     DateTime         @default(now()) @map("prepared_at") @db.Timestamptz(3)
  /// Null when the pay-day job prepared it.
  preparedBy     BigInt?          @map("prepared_by")
  finalisedBy    BigInt?          @map("finalised_by")
  finalisedAt    DateTime?        @map("finalised_at") @db.Timestamptz(3)
  finaliseReason String?          @map("finalise_reason") @db.VarChar(500)
  staffCount     Int              @default(0) @map("staff_count")
  /// `[{ staffId, reason }]` objects only (CHECK payroll_runs_skipped_check).
  skipped        Json             @default("[]")
  totalNet       Int              @default(0) @map("total_net")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School    @relation(fields: [schoolId], references: [id], map: "payroll_runs_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  preparedByUser  User?     @relation("PayrollRunPreparedBy", fields: [schoolId, preparedBy], references: [schoolId, id], map: "payroll_runs_prepared_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  finalisedByUser User?     @relation("PayrollRunFinalisedBy", fields: [schoolId, finalisedBy], references: [schoolId, id], map: "payroll_runs_finalised_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  payslips        Payslip[]

  @@unique([schoolId, id], map: "payroll_runs_school_id_id_key")
  /// One run per school and month (PAYROLL_RUN_EXISTS).
  @@unique([schoolId, yearMonth], map: "payroll_runs_month_key")
  @@index([schoolId, preparedBy], map: "payroll_runs_school_id_prepared_by_idx")
  @@index([schoolId, finalisedBy], map: "payroll_runs_school_id_finalised_by_idx")
  @@map("payroll_runs")
}

/// Tenant: one staff member's pay for a run (R214-R218). net = basic + allowances - deductions -
/// absence - recovery + adjustment, never negative (CHECK payslips_net_check). Rewritten by
/// recompute while the run is a draft; frozen once it is finalised except the paid columns, which
/// are set once and only then (trigger payslips_run_guard).
model Payslip {
  id                  BigInt         @id(map: "payslips_pkey") @default(autoincrement())
  schoolId            BigInt         @map("school_id")
  runId               BigInt         @map("run_id")
  staffId             BigInt         @map("staff_id")
  structureId         BigInt         @map("structure_id")
  employedWorkingDays Int            @map("employed_working_days") @db.SmallInt
  /// Pro-rated over the employed working days (R246).
  basic               Int
  allowancesTotal     Int            @map("allowances_total")
  deductionsTotal     Int            @map("deductions_total")
  unpaidDays          Int            @map("unpaid_days") @db.SmallInt
  unmarkedDays        Int            @map("unmarked_days") @db.SmallInt
  absenceDeduction    Int            @map("absence_deduction")
  advanceRecovery     Int            @map("advance_recovery")
  /// Signed: the sum of adjustment lines.
  adjustmentTotal     Int            @default(0) @map("adjustment_total")
  net                 Int
  status              PayslipStatus  @default(pending)
  paidOn              DateTime?      @map("paid_on") @db.Date
  paidMethod          PaymentMethod? @map("paid_method")
  paidReference       String?        @map("paid_reference") @db.VarChar(60)
  paidBy              BigInt?        @map("paid_by")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school     School                  @relation(fields: [schoolId], references: [id], map: "payslips_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  run        PayrollRun              @relation(fields: [schoolId, runId], references: [schoolId, id], map: "payslips_run_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff      Staff                   @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "payslips_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// A structure of the same staff member.
  structure  SalaryStructure         @relation(fields: [schoolId, structureId, staffId], references: [schoolId, id, staffId], map: "payslips_structure_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  paidByUser User?                   @relation(fields: [schoolId, paidBy], references: [schoolId, id], map: "payslips_paid_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  lines      PayslipLine[]           @relation("PayslipLines")
  adjustedBy PayslipLine[]           @relation("PayslipLineAdjusts")
  recoveries SalaryAdvanceRecovery[]

  @@unique([schoolId, id], map: "payslips_school_id_id_key")
  /// The target of lines and recoveries: the same staff member.
  @@unique([schoolId, id, staffId], map: "payslips_school_id_id_staff_id_key")
  /// One payslip per staff member per run.
  @@unique([schoolId, runId, staffId], map: "payslips_run_staff_key")
  @@index([schoolId, staffId, runId], map: "payslips_school_id_staff_id_run_id_idx")
  @@index([schoolId, runId, status], map: "payslips_school_id_run_id_status_idx")
  @@index([schoolId, structureId, staffId], map: "payslips_school_id_structure_id_idx")
  @@index([schoolId, paidBy], map: "payslips_school_id_paid_by_idx")
  @@map("payslips")
}

/// Tenant: a payslip's lines. Computed lines are rewritten (and may be removed) while the run is a
/// draft; an adjustment (signed, by a person, with a reason) is kept, may correct an earlier
/// finalised payslip of the same staff member, and is never one's own (triggers
/// payslip_lines_draft_only, payslip_adjust_not_self; R216, R235).
model PayslipLine {
  id               BigInt          @id(map: "payslip_lines_pkey") @default(autoincrement())
  schoolId         BigInt          @map("school_id")
  payslipId        BigInt          @map("payslip_id")
  staffId          BigInt          @map("staff_id")
  kind             PayslipLineKind
  name             String          @db.VarChar(60)
  /// > 0; signed and non-zero for an adjustment.
  amount           Int
  /// An adjustment correcting an earlier finalised payslip.
  adjustsPayslipId BigInt?         @map("adjusts_payslip_id")
  /// Set iff adjustment.
  reason           String?         @db.VarChar(500)
  /// Set iff adjustment.
  createdBy        BigInt?         @map("created_by")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  school        School   @relation(fields: [schoolId], references: [id], map: "payslip_lines_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  payslip       Payslip  @relation("PayslipLines", fields: [schoolId, payslipId, staffId], references: [schoolId, id, staffId], map: "payslip_lines_payslip_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  adjusts       Payslip? @relation("PayslipLineAdjusts", fields: [schoolId, adjustsPayslipId, staffId], references: [schoolId, id, staffId], map: "payslip_lines_adjusts_payslip_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  createdByUser User?    @relation(fields: [schoolId, createdBy], references: [schoolId, id], map: "payslip_lines_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "payslip_lines_school_id_id_key")
  @@index([schoolId, payslipId, staffId], map: "payslip_lines_school_id_payslip_id_idx")
  @@index([schoolId, adjustsPayslipId, staffId], map: "payslip_lines_school_id_adjusts_payslip_id_idx")
  @@index([schoolId, createdBy], map: "payslip_lines_school_id_created_by_idx")
  @@map("payslip_lines")
}

/// Tenant, append-only: an instalment of an advance taken by a finalised payslip of the same staff
/// member (R215, R247). Its insert raises salary_advances.recovered_amount (trigger
/// salary_advance_recoveries_apply).
model SalaryAdvanceRecovery {
  id        BigInt   @id(map: "salary_advance_recoveries_pkey") @default(autoincrement())
  schoolId  BigInt   @map("school_id")
  advanceId BigInt   @map("advance_id")
  payslipId BigInt   @map("payslip_id")
  staffId   BigInt   @map("staff_id")
  /// Whole rupees > 0.
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school  School        @relation(fields: [schoolId], references: [id], map: "salary_advance_recoveries_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  advance SalaryAdvance @relation(fields: [schoolId, advanceId, staffId], references: [schoolId, id, staffId], map: "salary_advance_recoveries_advance_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  payslip Payslip       @relation(fields: [schoolId, payslipId, staffId], references: [schoolId, id, staffId], map: "salary_advance_recoveries_payslip_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "salary_advance_recoveries_school_id_id_key")
  @@unique([schoolId, advanceId, payslipId], map: "salary_advance_recoveries_advance_payslip_key")
  @@index([schoolId, advanceId, staffId], map: "salary_advance_recoveries_school_id_advance_id_idx")
  @@index([schoolId, payslipId, staffId], map: "salary_advance_recoveries_school_id_payslip_id_idx")
  @@map("salary_advance_recoveries")
}

/// Non-tenant: a platform price tier (R219). Active bands never overlap (exclusion constraint
/// platform_plans_band_excl); bands are frozen; name, price and allowance may change until the
/// plan is archived. None is seeded.
model PlatformPlan {
  id           BigInt     @id(map: "platform_plans_pkey") @default(autoincrement())
  name         String     @db.VarChar(60)
  minStudents  Int        @map("min_students")
  /// Null = unbounded; else >= min_students.
  maxStudents  Int?       @map("max_students")
  /// Whole rupees a month.
  monthlyPrice Int        @map("monthly_price")
  /// The school's sms_monthly_cap while on this plan (unless overridden).
  smsAllowance Int        @map("sms_allowance")
  status       PlanStatus @default(active)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions PlatformSubscription[]
  invoices      PlatformInvoice[]

  @@index([status, minStudents], map: "platform_plans_status_min_students_idx")
  @@map("platform_plans")
}

/// Non-tenant: a school's plan over time, the history of its tiers. One live row per school
/// (partial unique platform_subscriptions_live_key); only ended_on moves, once.
model PlatformSubscription {
  id         BigInt    @id(map: "platform_subscriptions_pkey") @default(autoincrement())
  schoolId   BigInt    @map("school_id")
  planId     BigInt    @map("plan_id")
  startedOn  DateTime  @map("started_on") @db.Date
  /// Inclusive; a same-day replacement ends the old row on the day it started.
  endedOn    DateTime? @map("ended_on") @db.Date
  /// A manual override: billed on this plan whatever the count; needs a reason.
  pinned     Boolean   @default(false)
  /// Null = the monthly billing job.
  assignedBy BigInt?   @map("assigned_by")
  reason     String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School        @relation(fields: [schoolId], references: [id], map: "platform_subscriptions_school_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  plan           PlatformPlan  @relation(fields: [planId], references: [id], map: "platform_subscriptions_plan_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  assignedByUser PlatformUser? @relation(fields: [assignedBy], references: [id], map: "platform_subscriptions_assigned_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@index([schoolId, startedOn], map: "platform_subscriptions_school_id_started_on_idx")
  /// PLAN_IN_USE: a live subscription on the plan.
  @@index([planId, endedOn], map: "platform_subscriptions_plan_id_ended_on_idx")
  @@index([assignedBy], map: "platform_subscriptions_assigned_by_idx")
  @@map("platform_subscriptions")
}

/// Non-tenant despite its school_id (named exception 6's shape): the per-school daily count of
/// active students, written inside runAsSchool by school-metrics-rollup and read only by billing.
/// A re-run of the same day rewrites the count; the school and day never change.
model PlatformSchoolMetric {
  id             BigInt   @id(map: "platform_school_metrics_pkey") @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  day            DateTime @db.Date
  activeStudents Int      @map("active_students")
  computedAt     DateTime @map("computed_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "platform_school_metrics_school_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, day], map: "platform_school_metrics_school_id_day_key")
  @@map("platform_school_metrics")
}

/// Non-tenant: the platform's monthly invoice to a school (R220, R221). One non-void invoice per
/// school per month (partial unique platform_invoices_month_key); numbered gaplessly from
/// platform_settings.invoice_counter. `issued -> paid | void`.
model PlatformInvoice {
  id                   BigInt        @id(map: "platform_invoices_pkey") @default(autoincrement())
  schoolId             BigInt        @map("school_id")
  /// `INV-YYYY-NNNNN`, unique.
  invoiceNo            String        @map("invoice_no") @db.VarChar(14)
  /// `YYYY-MM`, the month billed.
  yearMonth            String        @map("year_month") @db.Char(7)
  planId               BigInt        @map("plan_id")
  studentCount         Int           @map("student_count")
  /// Whole rupees, the plan's monthly price when issued.
  amount               Int
  dueOn                DateTime      @map("due_on") @db.Date
  status               InvoiceStatus @default(issued)
  issuedAt             DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Stamped once by the daily run, the day after due_on.
  overdueAt            DateTime?     @map("overdue_at") @db.Timestamptz(3)
  /// Stamped once by the daily run after the grace days.
  suspensionEligibleAt DateTime?     @map("suspension_eligible_at") @db.Timestamptz(3)
  /// Set iff paid (CHECK platform_invoices_paid_check).
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(3)
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy             BigInt?       @map("voided_by")
  voidReason           String?       @map("void_reason") @db.VarChar(500)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school       School            @relation(fields: [schoolId], references: [id], map: "platform_invoices_school_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  plan         PlatformPlan      @relation(fields: [planId], references: [id], map: "platform_invoices_plan_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  voidedByUser PlatformUser?     @relation(fields: [voidedBy], references: [id], map: "platform_invoices_voided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  payments     PlatformPayment[]

  @@unique([invoiceNo], map: "platform_invoices_invoice_no_key")
  @@index([schoolId, yearMonth], map: "platform_invoices_school_id_year_month_idx")
  @@index([status, dueOn], map: "platform_invoices_status_due_on_idx")
  @@index([planId], map: "platform_invoices_plan_id_idx")
  @@index([voidedBy], map: "platform_invoices_voided_by_idx")
  @@map("platform_invoices")
}

/// Non-tenant, append-only: the full payment of one invoice (one per invoice).
model PlatformPayment {
  id         BigInt   @id(map: "platform_payments_pkey") @default(autoincrement())
  invoiceId  BigInt   @map("invoice_id")
  /// Whole rupees > 0, the invoice amount.
  amount     Int
  receivedOn DateTime @map("received_on") @db.Date
  reference  String   @db.VarChar(60)
  recordedBy BigInt   @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice        PlatformInvoice @relation(fields: [invoiceId], references: [id], map: "platform_payments_invoice_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  recordedByUser PlatformUser    @relation(fields: [recordedBy], references: [id], map: "platform_payments_recorded_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([invoiceId], map: "platform_payments_invoice_id_key")
  @@index([recordedBy], map: "platform_payments_recorded_by_idx")
  @@map("platform_payments")
}
