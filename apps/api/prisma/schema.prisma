/// Non-tenant despite its school_id (CLAUDE.md named exception 6, like platform_audit_log): the
/// per-school, per-day, per-channel rollup written by the per-school job and the platform's only
/// window onto messaging (R114). Counts, statuses and caps only; never a body, recipient or phone.
model PlatformDeliveryHealth {
  id                    BigInt             @id(map: "platform_delivery_health_pkey") @default(autoincrement())
  schoolId              BigInt             @map("school_id")
  day                   DateTime           @db.Date
  channel               MessageChannel
  accepted              Int                @default(0)
  delivered             Int                @default(0)
  failed                Int                @default(0)
  suppressed            Int                @default(0)
  /// Snapshot of the school's live number at computation; all three null when it has none (the
  /// DTO's `none`). Days are Asia/Karachi calendar days: today, and yesterday until 01:00.
  whatsappStatus        WhatsAppStatus?    @map("whatsapp_status")
  whatsappLastHealthyAt DateTime?          @map("whatsapp_last_healthy_at") @db.Timestamptz(3)
  whatsappLastErrorCode WhatsAppErrorCode? @map("whatsapp_last_error_code")
  smsUsed               Int                @default(0) @map("sms_used")
  smsCap                Int                @map("sms_cap")
  computedAt            DateTime           @map("computed_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "platform_delivery_health_school_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, day, channel], map: "platform_delivery_health_school_id_day_channel_key")
  @@map("platform_delivery_health")
}

/// Tenant: the school's own WhatsApp number, paired by the principal (owner's answer to item 17).
/// One live row per school (partial index whatsapp_numbers_school_id_live_key); a lost SIM is a
/// new row after disabling the old one, never a delete. provider, phone and cloud_phone_number_id
/// are frozen; waha_session is frozen once set and never reused; a disabled row stays disabled.
/// waha_session and cloud_phone_number_id are globally unique: a webhook correlates by them
/// (named exception 5), so their indexes are allowlisted in NON_SCHOOL_LEADING_INDEXES.
model WhatsAppNumber {
  id                  BigInt             @id(map: "whatsapp_numbers_pkey") @default(autoincrement())
  schoolId            BigInt             @map("school_id")
  /// E.164 (CHECK whatsapp_numbers_phone_check).
  phone               String             @db.VarChar(16)
  provider            WhatsAppProvider
  /// WAHA's session name, derived from the row id; null for the Cloud API.
  wahaSession         String?            @map("waha_session") @db.VarChar(64)
  /// Meta's phone-number id, in clear: an identifier, not a credential (contracts/slice-9.md
  /// §13.4). Not a row id, so allowlisted in NON_FK_ID_COLUMNS. Cloud API only.
  cloudPhoneNumberId  String?            @map("cloud_phone_number_id") @db.VarChar(32)
  /// AES-256-GCM `v1:...`, AAD-bound to school, table and column; Cloud API only.
  cloudAccessToken    String?            @map("cloud_access_token") @db.VarChar(2048)
  status              WhatsAppStatus     @default(pending)
  lastHealthyAt       DateTime?          @map("last_healthy_at") @db.Timestamptz(3)
  lastErrorCode       WhatsAppErrorCode? @map("last_error_code")
  /// Inbound messages are counted and ignored (the inbound workflow is unspecified).
  inboundIgnoredCount Int                @default(0) @map("inbound_ignored_count")
  /// paired_by is set at the pairing request, paired_at when the number is first connected
  /// (contracts/slice-9.md §13.9; CHECK whatsapp_numbers_paired_check).
  pairedAt            DateTime?          @map("paired_at") @db.Timestamptz(3)
  pairedBy            BigInt?            @map("paired_by")
  disabledAt          DateTime?          @map("disabled_at") @db.Timestamptz(3)
  disabledBy          BigInt?            @map("disabled_by")
  disabledReason      String?            @map("disabled_reason") @db.VarChar(500)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School @relation(fields: [schoolId], references: [id], map: "whatsapp_numbers_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  pairedByUser   User?  @relation("WhatsAppNumberPairedBy", fields: [schoolId, pairedBy], references: [schoolId, id], map: "whatsapp_numbers_paired_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  disabledByUser User?  @relation("WhatsAppNumberDisabledBy", fields: [schoolId, disabledBy], references: [schoolId, id], map: "whatsapp_numbers_disabled_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "whatsapp_numbers_school_id_id_key")
  @@unique([wahaSession], map: "whatsapp_numbers_waha_session_key")
  @@unique([cloudPhoneNumberId], map: "whatsapp_numbers_cloud_phone_number_id_key")
  @@index([schoolId, pairedBy], map: "whatsapp_numbers_school_id_paired_by_idx")
  @@index([schoolId, disabledBy], map: "whatsapp_numbers_school_id_disabled_by_idx")
  @@map("whatsapp_numbers")
}

/// Tenant: a phone's push registration, one per session (token rotation is an update). Liveness
/// is the session's: push goes only where the session is live and not idle-expired (R115). The
/// token is not unique: two parents may sign in on one phone. Only user_id is frozen: a password
/// change rotates the session and moves the device to it (contracts/slice-9.md §13.6).
model Device {
  id                 BigInt                    @id(map: "devices_pkey") @default(autoincrement())
  schoolId           BigInt                    @map("school_id")
  userId             BigInt                    @map("user_id")
  sessionId          BigInt                    @map("session_id")
  platform           DevicePlatform
  /// FCM registration token; never returned by the API (R173).
  pushToken          String                    @map("push_token") @db.VarChar(512)
  /// X-App-Version (CHECK devices_app_version_check).
  appVersion         String                    @map("app_version") @db.VarChar(14)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime                  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  unregisteredAt     DateTime?                 @map("unregistered_at") @db.Timestamptz(3)
  unregisteredReason DeviceUnregisteredReason? @map("unregistered_reason")
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], map: "devices_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user    User    @relation(fields: [schoolId, userId], references: [schoolId, id], map: "devices_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  session Session @relation(fields: [schoolId, sessionId], references: [schoolId, id], map: "devices_session_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "devices_school_id_id_key")
  @@unique([schoolId, sessionId], map: "devices_school_id_session_id_key")
  @@index([schoolId, userId], map: "devices_school_id_user_id_idx")
  @@index([schoolId, pushToken], map: "devices_school_id_push_token_idx")
  @@map("devices")
}

/// Tenant: one outbound message to one person (R105, R107), written in the sender's transaction
/// and enqueued after commit. Exactly one of guardian_id, staff_id, student_id
/// (CHECK messages_recipient_check); no phone number, no recipient_user_id. subject_id is
/// polymorphic like audit_log's (allowlisted in NON_FK_ID_COLUMNS). R107 is three partial unique
/// indexes, messages_subject_{guardian,staff,student}_key. The content columns are frozen.
model Message {
  id               BigInt             @id(map: "messages_pkey") @default(autoincrement())
  schoolId         BigInt             @map("school_id")
  type             MessageType
  priority         MessagePriority
  /// snake_case (CHECK messages_subject_type_check), e.g. holiday, attendance_alert.
  subjectType      String             @map("subject_type") @db.VarChar(32)
  subjectId        BigInt             @map("subject_id")
  guardianId       BigInt?            @map("guardian_id")
  staffId          BigInt?            @map("staff_id")
  studentId        BigInt?            @map("student_id")
  /// Rendered English body; never an identity number (CHECK messages_body_no_id_check).
  body             String             @db.VarChar(2000)
  /// `{school_id}/{ULID}.{jpg|png|pdf}` (CHECK messages_media_object_key_check).
  mediaObjectKey   String?            @map("media_object_key") @db.VarChar(64)
  /// Announcement-carried types only: the push title and email subject (contracts/slice-14.md
  /// §4.4); never an identity number (CHECK messages_title_no_id_check). Null: titleOf().
  title            String?            @db.VarChar(120)
  channelPlan      MessageChannel[]   @map("channel_plan")
  status           MessageStatus      @default(queued)
  /// Set exactly when status = suppressed (CHECK messages_suppressed_check).
  suppressedReason SuppressionReason? @map("suppressed_reason")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set by the claim; a `sending` row claimed over 10 minutes ago is requeued by the outbox
  /// sweep (contracts/slice-9.md §7.6, §13.1). Set whenever status = sending
  /// (CHECK messages_claimed_check).
  claimedAt        DateTime?          @map("claimed_at") @db.Timestamptz(3)
  /// Set exactly when processing has ended (CHECK messages_finished_check).
  finishedAt       DateTime?          @map("finished_at") @db.Timestamptz(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school     School            @relation(fields: [schoolId], references: [id], map: "messages_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  guardian   Guardian?         @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "messages_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff      Staff?            @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "messages_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student    Student?          @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "messages_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  deliveries MessageDelivery[]
  announcementRecipients AnnouncementRecipient[]

  @@unique([schoolId, id], map: "messages_school_id_id_key")
  /// The per-school outbox sweep (R105).
  @@index([schoolId, status, createdAt], map: "messages_school_id_status_created_at_idx")
  @@index([schoolId, subjectType, subjectId], map: "messages_school_id_subject_type_subject_id_idx")
  /// The inbox, resolved by person at read time (plan §4.2); also the FK indexes.
  @@index([schoolId, guardianId, createdAt], map: "messages_school_id_guardian_id_created_at_idx")
  @@index([schoolId, staffId, createdAt], map: "messages_school_id_staff_id_created_at_idx")
  @@index([schoolId, studentId, createdAt], map: "messages_school_id_student_id_created_at_idx")
  @@map("messages")
}

/// Tenant: one attempt on one channel (R108), unique per (message, channel, attempt). The raw
/// provider reference is never stored in clear: provider_ref_hash is SHA-256 of
/// `channel|providerRef`, globally unique per channel for webhook correlation (partial index
/// message_deliveries_provider_ref_key, named exception 5); a pull provider's reference is kept
/// encrypted in poll_ref only until a final status. Only status, delivered_at, failed_at and
/// error_code change, only forward, and poll_ref only to NULL (trigger
/// message_deliveries_forward_only).
model MessageDelivery {
  id               BigInt             @id(map: "message_deliveries_pkey") @default(autoincrement())
  schoolId         BigInt             @map("school_id")
  messageId        BigInt             @map("message_id")
  channel          MessageChannel
  /// 1 or more (CHECK message_deliveries_attempt_check).
  attempt          Int                @db.SmallInt
  status           DeliveryStatus
  providerRefHash  String?            @map("provider_ref_hash") @db.Char(64)
  /// AES-256-GCM `v1:...` (AAD `schoolId|message_deliveries|poll_ref`) of a pull provider's
  /// reference (Sendpk), for the delivery poll; only on an accepted SMS attempt
  /// (CHECK message_deliveries_poll_ref_check), cleared at a final status (contracts/slice-9.md
  /// §13.3).
  pollRef          String?            @map("poll_ref")
  /// e.g. `+9230*****67`: never seven digits in a row (CHECK message_deliveries_to_masked_no_id_check).
  toMasked         String?            @map("to_masked") @db.VarChar(32)
  /// Only on a failed attempt (CHECK message_deliveries_error_code_check).
  errorCode        DeliveryErrorCode? @map("error_code")
  /// Why a leg was not sent (plan §4.2: "a suppression is a delivery row with a reason"). Set
  /// exactly when status = suppressed (CHECK message_deliveries_suppressed_check).
  suppressedReason SuppressionReason? @map("suppressed_reason")
  segments         Int?               @db.SmallInt
  attemptedAt      DateTime           @default(now()) @map("attempted_at") @db.Timestamptz(3)
  deliveredAt      DateTime?          @map("delivered_at") @db.Timestamptz(3)
  failedAt         DateTime?          @map("failed_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], map: "message_deliveries_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  message Message @relation(fields: [schoolId, messageId], references: [schoolId, id], map: "message_deliveries_message_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "message_deliveries_school_id_id_key")
  /// A crashed worker cannot write an attempt twice; also the message FK's index.
  @@unique([schoolId, messageId, channel, attempt], map: "message_deliveries_attempt_key")
  @@map("message_deliveries")
}

/// Tenant: sends per month per channel, the cap's counter (R109): SMS segments for `sms`, accepted
/// legs otherwise (contracts/slice-9.md §13.8). Advanced atomically with
/// INSERT ... ON CONFLICT DO UPDATE SET sent_count = sent_count + n WHERE sent_count + n <= cap.
model MessageUsage {
  id        BigInt         @id(map: "message_usage_pkey") @default(autoincrement())
  schoolId  BigInt         @map("school_id")
  /// `YYYY-MM` in the school's time zone (CHECK message_usage_year_month_check).
  yearMonth String         @map("year_month") @db.Char(7)
  channel   MessageChannel
  sentCount Int            @default(0) @map("sent_count")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "message_usage_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore

  @@unique([schoolId, id], map: "message_usage_school_id_id_key")
  @@unique([schoolId, yearMonth, channel], map: "message_usage_school_id_year_month_channel_key")
  @@map("message_usage")
}

// ---------------------------------------------------------------------------------------------
// Phase 2, slice 10: calendar (phase-2-daily-operations.md §5 "Calendar", contracts/slice-10.md),
// and the school settings Phase 2 reads (plan §4.5). Value sets mirror packages/shared.
// ---------------------------------------------------------------------------------------------

enum HolidayKind {
  public
  school

  @@map("holiday_kind")
}

enum HolidayStatus {
  draft
  published
  cancelled

  @@map("holiday_status")
}

/// Register item 23: how a late day counts in the attendance percentage.
enum LateCountsAs {
  present
  half_day
  absent_after_cutoff

  @@map("late_counts_as")
}

enum LeaveCountsAs {
  excused
  absent

  @@map("leave_counts_as")
}

/// A level: student implies guardian (register item 26).
enum RemarkVisibility {
  internal
  guardian
  student

  @@map("remark_visibility")
}

/// Tenant: a closure range, one row however long (a ten-week break is one row and one notice).
/// Live (draft or published) ranges never overlap within a school: EXCLUDE holidays_live_excl.
/// starts_on, ends_on, kind and name are frozen once published (trigger holidays_published_frozen):
/// a wrong date is cancel plus a new holiday. cancelled is final (holidays_cancelled_frozen).
/// announcement_id names the slice-14 announcement that is the notice; it gains its foreign key
/// with the announcements table (allowlisted in NON_FK_ID_COLUMNS until then) and stays null for
/// holidays published before slice 14 (contracts/slice-10.md §4.7).
model Holiday {
  id             BigInt        @id(map: "holidays_pkey") @default(autoincrement())
  schoolId       BigInt        @map("school_id")
  startsOn       DateTime      @map("starts_on") @db.Date
  /// Inclusive; equals starts_on for one day (the API fills it; CHECK holidays_dates_check).
  endsOn         DateTime      @map("ends_on") @db.Date
  name           String        @db.VarChar(100)
  description    String?       @db.VarChar(500)
  kind           HolidayKind
  /// false: a teaching holiday on which staff still work (Phase 3 payroll's working days).
  appliesToStaff Boolean       @default(true) @map("applies_to_staff")
  status         HolidayStatus @default(draft)
  /// Set together, exactly when published or cancelled from published (CHECK holidays_published_check).
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  publishedBy    BigInt?       @map("published_by")
  /// Set together, exactly when cancelled (CHECK holidays_cancelled_check).
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy    BigInt?       @map("cancelled_by")
  cancelReason   String?       @map("cancel_reason") @db.VarChar(500)
  announcementId BigInt?       @map("announcement_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School @relation(fields: [schoolId], references: [id], map: "holidays_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  publishedByUser User?  @relation("HolidayPublishedBy", fields: [schoolId, publishedBy], references: [schoolId, id], map: "holidays_published_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User?  @relation("HolidayCancelledBy", fields: [schoolId, cancelledBy], references: [schoolId, id], map: "holidays_cancelled_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The announcement that is this holiday's notice (R151, contracts/slice-14.md §6); a later
  /// cancellation notice is a second announcement naming the holiday, not this column.
  announcement    Announcement? @relation("HolidayAnnouncement", fields: [schoolId, announcementId], references: [schoolId, id], map: "holidays_announcement_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  announcements   Announcement[] @relation("AnnouncementHoliday")

  @@unique([schoolId, id], map: "holidays_school_id_id_key")
  /// Status is an index column, not a partial predicate (Prisma casts enum conditions).
  @@index([schoolId, status, startsOn], map: "holidays_school_id_status_starts_on_idx")
  @@index([schoolId, publishedBy], map: "holidays_school_id_published_by_idx")
  @@index([schoolId, cancelledBy], map: "holidays_school_id_cancelled_by_idx")
  @@index([schoolId, announcementId], map: "holidays_school_id_announcement_id_idx")
  @@map("holidays")
}

// ---------------------------------------------------------------------------------------------
// Phase 2, wave E groundwork: attendance (slices 11, 12), diary and remarks (slice 13)
// (phase-2-daily-operations.md §4.6, §5 "Attendance", "Diary and remarks"). Value sets mirror
// packages/shared (test/guardrails/shared-enums.e2e-spec.ts). Hand-written CHECKs, history and
// freeze triggers live in the migration phase2_attendance_diary.
// ---------------------------------------------------------------------------------------------

/// One mark: a period, or the day's single period in daily mode (rule 14).
enum AttendanceStatus {
  present
  absent
  late
  on_leave

  @@map("attendance_status")
}

/// The derived status of an enrolment-day (R127).
enum DayStatus {
  present
  absent
  late
  on_leave
  partial

  @@map("day_status")
}

/// Its own set, so payroll can add a value without touching student attendance (slice 12).
enum StaffAttendanceStatus {
  present
  absent
  late
  on_leave

  @@map("staff_attendance_status")
}

/// Derived from the session channel: bearer = app, cookie = web.
enum RegisterSource {
  app
  web

  @@map("register_source")
}

enum AttendanceAlertKind {
  absence
  late
  corrected

  @@map("attendance_alert_kind")
}

/// pending -> sent | cancelled; both final (trigger attendance_alerts_status_final).
enum AttendanceAlertStatus {
  pending
  sent
  cancelled

  @@map("attendance_alert_status")
}

enum AttendanceAlertCancelReason {
  mark_changed
  holiday
  link_ended
  backdated

  @@map("attendance_alert_cancel_reason")
}

enum RemarkCategory {
  academic
  behaviour
  homework
  attendance
  participation
  general

  @@map("remark_category")
}

/// Tenant: one register per (section, date, period) (R119, attendance_registers_natural_key).
/// No counts: the summary is the aggregate layer. mode is copied from the class; period is 1 in
/// daily mode (CHECK attendance_registers_daily_period_check). Everything but last_amended_by/at
/// is frozen (trigger attendance_registers_columns_immutable).
model AttendanceRegister {
  id             BigInt         @id(map: "attendance_registers_pkey") @default(autoincrement())
  schoolId       BigInt         @map("school_id")
  sectionId      BigInt         @map("section_id")
  classId        BigInt         @map("class_id")
  academicYearId BigInt         @map("academic_year_id")
  date           DateTime       @db.Date
  /// 1-12 (CHECK attendance_registers_period_check).
  period         Int            @db.SmallInt
  mode           AttendanceMode
  submittedBy    BigInt         @map("submitted_by")
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  /// Set together (CHECK attendance_registers_amended_check).
  lastAmendedBy  BigInt?        @map("last_amended_by")
  lastAmendedAt  DateTime?      @map("last_amended_at") @db.Timestamptz(3)
  source         RegisterSource

  school            School           @relation(fields: [schoolId], references: [id], map: "attendance_registers_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  class             Class            @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "attendance_registers_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section           Section          @relation(fields: [schoolId, sectionId, classId], references: [schoolId, id, classId], map: "attendance_registers_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  submittedByUser   User             @relation("RegisterSubmittedBy", fields: [schoolId, submittedBy], references: [schoolId, id], map: "attendance_registers_submitted_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  lastAmendedByUser User?            @relation("RegisterLastAmendedBy", fields: [schoolId, lastAmendedBy], references: [schoolId, id], map: "attendance_registers_last_amended_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  marks             AttendanceMark[]

  @@unique([schoolId, id], map: "attendance_registers_school_id_id_key")
  @@unique([schoolId, sectionId, date, period], map: "attendance_registers_natural_key")
  /// Target of the marks FK: a mark can never disagree with its register's date and period.
  @@unique([schoolId, id, date, period], map: "attendance_registers_school_id_id_date_period_key")
  /// R129's anti-join (sections with no register on a date).
  @@index([schoolId, date, sectionId], map: "attendance_registers_school_id_date_section_id_idx")
  @@index([schoolId, sectionId, classId], map: "attendance_registers_school_id_section_id_class_id_idx")
  @@index([schoolId, classId, academicYearId], map: "attendance_registers_school_id_class_id_academic_year_id_idx")
  @@index([schoolId, submittedBy], map: "attendance_registers_school_id_submitted_by_idx")
  @@index([schoolId, lastAmendedBy], map: "attendance_registers_school_id_last_amended_by_idx")
  @@map("attendance_registers")
}

/// Tenant, lean (about 4.8 M rows per school-year): no student_id, no marked_by, no year. The
/// author is the register's submitted_by or a changes row; the year is on the register and the
/// enrolment. attendance_marks_natural_key (rule 14) is the offline idempotency key. Identity
/// columns are frozen; a status or note change writes attendance_mark_changes through the §4.6
/// trigger (attendance_marks_history), which needs the transaction-local actor and reason.
model AttendanceMark {
  id          BigInt           @id(map: "attendance_marks_pkey") @default(autoincrement())
  schoolId    BigInt           @map("school_id")
  registerId  BigInt           @map("register_id")
  enrolmentId BigInt           @map("enrolment_id")
  date        DateTime         @db.Date
  period      Int              @db.SmallInt
  status      AttendanceStatus
  /// The gate's latest arrival (attendance_arrivals), school-local time.
  arrivedAt   DateTime?        @map("arrived_at") @db.Time(0)
  /// Never an identity number (CHECK attendance_marks_note_no_id_check).
  note        String?          @db.VarChar(200)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  school    School                 @relation(fields: [schoolId], references: [id], map: "attendance_marks_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  register  AttendanceRegister     @relation(fields: [schoolId, registerId, date, period], references: [schoolId, id, date, period], map: "attendance_marks_register_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  enrolment Enrolment              @relation(fields: [schoolId, enrolmentId], references: [schoolId, id], map: "attendance_marks_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changes   AttendanceMarkChange[]
  arrivals  AttendanceArrival[]

  @@unique([schoolId, id], map: "attendance_marks_school_id_id_key")
  @@unique([schoolId, enrolmentId, date, period], map: "attendance_marks_natural_key")
  @@index([schoolId, registerId, date, period], map: "attendance_marks_school_id_register_id_date_period_idx")
  @@map("attendance_marks")
}

/// Tenant, append-only: written only by the attendance_marks_history trigger (plan §4.6). reason
/// is NOT NULL (R122) and never an identity number.
model AttendanceMarkChange {
  id           BigInt           @id(map: "attendance_mark_changes_pkey") @default(autoincrement())
  schoolId     BigInt           @map("school_id")
  markId       BigInt           @map("mark_id")
  oldStatus    AttendanceStatus @map("old_status")
  newStatus    AttendanceStatus @map("new_status")
  oldNote      String?          @map("old_note") @db.VarChar(200)
  newNote      String?          @map("new_note") @db.VarChar(200)
  /// The arrival time before and after (slice 11 §12 item 2): a correction of record, tracked.
  oldArrivedAt DateTime?        @map("old_arrived_at") @db.Time(0)
  newArrivedAt DateTime?        @map("new_arrived_at") @db.Time(0)
  changedBy    BigInt           @map("changed_by")
  changedAt    DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason       String           @db.VarChar(500)

  school        School         @relation(fields: [schoolId], references: [id], map: "attendance_mark_changes_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  mark          AttendanceMark @relation(fields: [schoolId, markId], references: [schoolId, id], map: "attendance_mark_changes_mark_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changedByUser User           @relation(fields: [schoolId, changedBy], references: [schoolId, id], map: "attendance_mark_changes_changed_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "attendance_mark_changes_school_id_id_key")
  @@index([schoolId, markId], map: "attendance_mark_changes_school_id_mark_id_idx")
  @@index([schoolId, changedBy], map: "attendance_mark_changes_school_id_changed_by_idx")
  @@map("attendance_mark_changes")
}

/// Tenant, append-only: the gate's record behind POST /attendance-arrivals (R168). The mark's
/// arrived_at mirrors the latest.
model AttendanceArrival {
  id         BigInt   @id(map: "attendance_arrivals_pkey") @default(autoincrement())
  schoolId   BigInt   @map("school_id")
  markId     BigInt   @map("mark_id")
  arrivedAt  DateTime @map("arrived_at") @db.Time(0)
  recordedBy BigInt   @map("recorded_by")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  school         School         @relation(fields: [schoolId], references: [id], map: "attendance_arrivals_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  mark           AttendanceMark @relation(fields: [schoolId, markId], references: [schoolId, id], map: "attendance_arrivals_mark_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  recordedByUser User           @relation(fields: [schoolId, recordedBy], references: [schoolId, id], map: "attendance_arrivals_recorded_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "attendance_arrivals_school_id_id_key")
  @@index([schoolId, markId], map: "attendance_arrivals_school_id_mark_id_idx")
  @@index([schoolId, recordedBy], map: "attendance_arrivals_school_id_recorded_by_idx")
  @@map("attendance_arrivals")
}

/// Tenant: one alert per child, day, kind and sequence (R126; seq counts corrected-notice
/// reversals). Linked messages carry subject_type 'attendance_alert'. pending -> sent | cancelled,
/// both final; cancel_reason set exactly when cancelled.
model AttendanceAlert {
  id           BigInt                       @id(map: "attendance_alerts_pkey") @default(autoincrement())
  schoolId     BigInt                       @map("school_id")
  enrolmentId  BigInt                       @map("enrolment_id")
  studentId    BigInt                       @map("student_id")
  date         DateTime                     @db.Date
  kind         AttendanceAlertKind
  seq          Int                          @default(1) @db.SmallInt
  dueAt        DateTime                     @map("due_at") @db.Timestamptz(3)
  status       AttendanceAlertStatus        @default(pending)
  cancelReason AttendanceAlertCancelReason? @map("cancel_reason")
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When a fourth row of this kind for the child-day was due and refused (the cap of three);
  /// stamped once on the kind's latest row, the one change a sent or cancelled row accepts.
  cappedAt     DateTime?                    @map("capped_at") @db.Timestamptz(3)

  school    School    @relation(fields: [schoolId], references: [id], map: "attendance_alerts_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  /// The enrolment and the child together: an alert can never name another child.
  enrolment Enrolment @relation(fields: [schoolId, enrolmentId, studentId], references: [schoolId, id, studentId], map: "attendance_alerts_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "attendance_alerts_school_id_id_key")
  @@unique([schoolId, studentId, date, kind, seq], map: "attendance_alerts_natural_key")
  /// The due sweep. Status is an index column, not a partial predicate.
  @@index([schoolId, status, dueAt], map: "attendance_alerts_school_id_status_due_at_idx")
  @@index([schoolId, enrolmentId, studentId], map: "attendance_alerts_school_id_enrolment_id_student_id_idx")
  @@map("attendance_alerts")
}

/// Tenant: R127 materialised per enrolment-day (report cards and the parent heat map read this,
/// never raw marks). The day's value (R128) is computed at read from these counts and the
/// school's settings. Recomputed in place; which enrolment-day it describes is frozen.
model AttendanceDayStatus {
  id                 BigInt    @id(map: "attendance_day_status_pkey") @default(autoincrement())
  schoolId           BigInt    @map("school_id")
  enrolmentId        BigInt    @map("enrolment_id")
  studentId          BigInt    @map("student_id")
  sectionId          BigInt    @map("section_id")
  date               DateTime  @db.Date
  status             DayStatus
  /// The four counts sum to periods_recorded (CHECK attendance_day_status_periods_check).
  periodsRecorded    Int       @map("periods_recorded") @db.SmallInt
  periodsPresent     Int       @map("periods_present") @db.SmallInt
  periodsLate        Int       @map("periods_late") @db.SmallInt
  periodsAbsent      Int       @map("periods_absent") @db.SmallInt
  periodsLeave       Int       @map("periods_leave") @db.SmallInt
  /// The arrived_at of the lowest-period late mark (slice 11 §8.2), for late_counts_as =
  /// absent_after_cutoff (§5.2). Recomputed in place like the counts.
  firstLateArrivedAt DateTime? @map("first_late_arrived_at") @db.Time(0)
  computedAt         DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  school    School    @relation(fields: [schoolId], references: [id], map: "attendance_day_status_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  enrolment Enrolment @relation(fields: [schoolId, enrolmentId, studentId], references: [schoolId, id, studentId], map: "attendance_day_status_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section   Section   @relation(fields: [schoolId, sectionId], references: [schoolId, id], map: "attendance_day_status_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "attendance_day_status_school_id_id_key")
  @@unique([schoolId, enrolmentId, date], map: "attendance_day_status_natural_key")
  @@index([schoolId, studentId, date], map: "attendance_day_status_school_id_student_id_date_idx")
  @@index([schoolId, enrolmentId, studentId], map: "attendance_day_status_school_id_enrolment_id_student_id_idx")
  /// The per-section-day recompute; also the section FK's index.
  @@index([schoolId, sectionId, date], map: "attendance_day_status_school_id_section_id_date_idx")
  @@map("attendance_day_status")
}

/// Tenant: per section-day, a GROUP BY of attendance_day_status (R131). version is bumped by the
/// statement-level triggers attendance_marks_summary_bump_insert/_update (no code path can forget);
/// stale iff computed_version <> version. The worker reads version, recomputes, then sets
/// computed_version to what it read (CHECK attendance_daily_summary_version_check).
model AttendanceDailySummary {
  id                BigInt         @id(map: "attendance_daily_summary_pkey") @default(autoincrement())
  schoolId          BigInt         @map("school_id")
  sectionId         BigInt         @map("section_id")
  classId           BigInt         @map("class_id")
  academicYearId    BigInt         @map("academic_year_id")
  date              DateTime       @db.Date
  mode              AttendanceMode
  registersExpected Int            @default(0) @map("registers_expected") @db.SmallInt
  registersRecorded Int            @default(0) @map("registers_recorded") @db.SmallInt
  rosterCount       Int            @default(0) @map("roster_count")
  present           Int            @default(0)
  absent            Int            @default(0)
  late              Int            @default(0)
  onLeave           Int            @default(0) @map("on_leave")
  partial           Int            @default(0)
  version           BigInt         @default(1)
  computedVersion   BigInt         @default(0) @map("computed_version")
  computedAt        DateTime?      @map("computed_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], map: "attendance_daily_summary_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  class   Class   @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "attendance_daily_summary_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section Section @relation(fields: [schoolId, sectionId, classId], references: [schoolId, id, classId], map: "attendance_daily_summary_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "attendance_daily_summary_school_id_id_key")
  @@unique([schoolId, sectionId, date], map: "attendance_daily_summary_natural_key")
  /// The principal's console and the nightly recompute (by date).
  @@index([schoolId, date], map: "attendance_daily_summary_school_id_date_idx")
  @@index([schoolId, sectionId, classId], map: "attendance_daily_summary_school_id_section_id_class_id_idx")
  @@index([schoolId, classId, academicYearId], map: "attendance_daily_summary_class_id_academic_year_id_idx")
  @@map("attendance_daily_summary")
}

/// Tenant (slice 12): one row per staff member per date (R133). Nobody marks or amends their own
/// row (trigger staff_attendance_not_self, R134). A status or note change writes
/// staff_attendance_changes through the §4.6 trigger (staff_attendance_history).
model StaffAttendance {
  id       BigInt                @id(map: "staff_attendance_pkey") @default(autoincrement())
  schoolId BigInt                @map("school_id")
  staffId  BigInt                @map("staff_id")
  date     DateTime              @db.Date
  status   StaffAttendanceStatus
  markedBy BigInt                @map("marked_by")
  markedAt DateTime              @default(now()) @map("marked_at") @db.Timestamptz(3)
  /// Never an identity number (CHECK staff_attendance_note_no_id_check).
  note     String?               @db.VarChar(200)

  school       School                  @relation(fields: [schoolId], references: [id], map: "staff_attendance_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff        Staff                   @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "staff_attendance_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  markedByUser User                    @relation(fields: [schoolId, markedBy], references: [schoolId, id], map: "staff_attendance_marked_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  changes      StaffAttendanceChange[]

  @@unique([schoolId, id], map: "staff_attendance_school_id_id_key")
  @@unique([schoolId, staffId, date], map: "staff_attendance_natural_key")
  @@index([schoolId, markedBy], map: "staff_attendance_school_id_marked_by_idx")
  @@map("staff_attendance")
}

/// Tenant, append-only: written only by the staff_attendance_history trigger. reason NOT NULL (R133).
model StaffAttendanceChange {
  id                BigInt                @id(map: "staff_attendance_changes_pkey") @default(autoincrement())
  schoolId          BigInt                @map("school_id")
  staffAttendanceId BigInt                @map("staff_attendance_id")
  oldStatus         StaffAttendanceStatus @map("old_status")
  newStatus         StaffAttendanceStatus @map("new_status")
  oldNote           String?               @map("old_note") @db.VarChar(200)
  newNote           String?               @map("new_note") @db.VarChar(200)
  changedBy         BigInt                @map("changed_by")
  changedAt         DateTime              @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason            String                @db.VarChar(500)

  school          School          @relation(fields: [schoolId], references: [id], map: "staff_attendance_changes_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staffAttendance StaffAttendance @relation(fields: [schoolId, staffAttendanceId], references: [schoolId, id], map: "staff_attendance_changes_staff_attendance_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changedByUser   User            @relation(fields: [schoolId, changedBy], references: [schoolId, id], map: "staff_attendance_changes_changed_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "staff_attendance_changes_school_id_id_key")
  @@index([schoolId, staffAttendanceId], map: "staff_attendance_changes_school_id_staff_attendance_id_idx")
  @@index([schoolId, changedBy], map: "staff_attendance_changes_school_id_changed_by_idx")
  @@map("staff_attendance_changes")
}

/// Tenant (slice 13): one entry per section, date and subject (R137). Identity columns frozen
/// (trigger diary_entries_columns_immutable); an edit of the five editable fields writes
/// diary_entry_changes through the §4.6 trigger (diary_entries_history; reason may be null, the
/// service demands one after the window). No client_reference: the Idempotency-Key header is the
/// one mechanism.
model DiaryEntry {
  id                  BigInt    @id(map: "diary_entries_pkey") @default(autoincrement())
  schoolId            BigInt    @map("school_id")
  sectionId           BigInt    @map("section_id")
  classId             BigInt    @map("class_id")
  academicYearId      BigInt    @map("academic_year_id")
  date                DateTime  @db.Date
  subjectId           BigInt    @map("subject_id")
  authorStaffId       BigInt    @map("author_staff_id")
  /// 1-500 trimmed, never an identity number (CHECKs diary_entries_topic_check, _topic_no_id_check).
  topic               String    @db.VarChar(500)
  assignment          String?   @db.VarChar(1000)
  learningOutcome     String?   @map("learning_outcome") @db.VarChar(500)
  /// On or after date (CHECK diary_entries_due_on_check).
  dueOn               DateTime? @map("due_on") @db.Date
  /// `{school_id}/{ULID}.{jpg|png|pdf}`; key, mime and size together (CHECK diary_entries_attachment_check).
  /// A staged object is consumed once (partial unique diary_entries_attachment_object_key_key).
  attachmentObjectKey String?   @map("attachment_object_key") @db.VarChar(64)
  attachmentMime      String?   @map("attachment_mime") @db.VarChar(32)
  attachmentSizeBytes Int?      @map("attachment_size_bytes")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school  School             @relation(fields: [schoolId], references: [id], map: "diary_entries_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  class   Class              @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "diary_entries_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section Section            @relation(fields: [schoolId, sectionId, classId], references: [schoolId, id, classId], map: "diary_entries_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  subject Subject            @relation(fields: [schoolId, subjectId], references: [schoolId, id], map: "diary_entries_subject_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  author  Staff              @relation(fields: [schoolId, authorStaffId], references: [schoolId, id], map: "diary_entries_author_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changes DiaryEntryChange[]

  @@unique([schoolId, id], map: "diary_entries_school_id_id_key")
  /// Also serves the (school_id, section_id, date) reads.
  @@unique([schoolId, sectionId, date, subjectId], map: "diary_entries_natural_key")
  @@index([schoolId, authorStaffId, date], map: "diary_entries_school_id_author_staff_id_date_idx")
  @@index([schoolId, subjectId], map: "diary_entries_school_id_subject_id_idx")
  @@index([schoolId, sectionId, classId], map: "diary_entries_school_id_section_id_class_id_idx")
  @@index([schoolId, classId, academicYearId], map: "diary_entries_school_id_class_id_academic_year_id_idx")
  @@map("diary_entries")
}

/// Tenant, append-only: written only by the diary_entries_history trigger, old and new values of
/// the five editable fields. reason is nullable (an author's same-day edit needs none).
model DiaryEntryChange {
  id                     BigInt    @id(map: "diary_entry_changes_pkey") @default(autoincrement())
  schoolId               BigInt    @map("school_id")
  diaryEntryId           BigInt    @map("diary_entry_id")
  oldTopic               String    @map("old_topic") @db.VarChar(500)
  newTopic               String    @map("new_topic") @db.VarChar(500)
  oldAssignment          String?   @map("old_assignment") @db.VarChar(1000)
  newAssignment          String?   @map("new_assignment") @db.VarChar(1000)
  oldLearningOutcome     String?   @map("old_learning_outcome") @db.VarChar(500)
  newLearningOutcome     String?   @map("new_learning_outcome") @db.VarChar(500)
  oldDueOn               DateTime? @map("old_due_on") @db.Date
  newDueOn               DateTime? @map("new_due_on") @db.Date
  oldAttachmentObjectKey String?   @map("old_attachment_object_key") @db.VarChar(64)
  newAttachmentObjectKey String?   @map("new_attachment_object_key") @db.VarChar(64)
  changedBy              BigInt    @map("changed_by")
  changedAt              DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason                 String?   @db.VarChar(500)

  school        School     @relation(fields: [schoolId], references: [id], map: "diary_entry_changes_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  diaryEntry    DiaryEntry @relation(fields: [schoolId, diaryEntryId], references: [schoolId, id], map: "diary_entry_changes_diary_entry_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changedByUser User       @relation(fields: [schoolId, changedBy], references: [schoolId, id], map: "diary_entry_changes_changed_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "diary_entry_changes_school_id_id_key")
  @@index([schoolId, diaryEntryId], map: "diary_entry_changes_school_id_diary_entry_id_idx")
  @@index([schoolId, changedBy], map: "diary_entry_changes_school_id_changed_by_idx")
  @@map("diary_entry_changes")
}

/// Tenant (slice 13): a remark is never edited (R141). A correction is a new row naming its
/// predecessor in supersedes_id (same child, composite FK; a chain, never a tree: partial unique
/// remarks_supersedes_id_key) and carries its correction_reason (contracts/slice-13.md §5.3). The
/// predecessor's superseded_at is set by the AFTER INSERT trigger remarks_mark_superseded; every
/// other column is frozen.
model Remark {
  id               BigInt           @id(map: "remarks_pkey") @default(autoincrement())
  schoolId         BigInt           @map("school_id")
  enrolmentId      BigInt           @map("enrolment_id")
  studentId        BigInt           @map("student_id")
  authorStaffId    BigInt           @map("author_staff_id")
  subjectId        BigInt?          @map("subject_id")
  date             DateTime         @db.Date
  category         RemarkCategory
  /// 1-1000 trimmed, never an identity number (CHECKs remarks_text_check, remarks_text_no_id_check).
  text             String           @db.VarChar(1000)
  visibility       RemarkVisibility
  supersedesId     BigInt?          @map("supersedes_id")
  /// The correction's own reason: set exactly when supersedes_id is (CHECK remarks_correction_check).
  correctionReason String?          @map("correction_reason") @db.VarChar(500)
  supersededAt     DateTime?        @map("superseded_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School    @relation(fields: [schoolId], references: [id], map: "remarks_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  enrolment    Enrolment @relation(fields: [schoolId, enrolmentId, studentId], references: [schoolId, id, studentId], map: "remarks_enrolment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  author       Staff     @relation(fields: [schoolId, authorStaffId], references: [schoolId, id], map: "remarks_author_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  subject      Subject?  @relation(fields: [schoolId, subjectId], references: [schoolId, id], map: "remarks_subject_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  supersedes   Remark?   @relation("RemarkSupersedes", fields: [schoolId, supersedesId, studentId], references: [schoolId, id, studentId], map: "remarks_supersedes_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  supersededBy Remark[]  @relation("RemarkSupersedes")

  @@unique([schoolId, id], map: "remarks_school_id_id_key")
  /// Target of the supersedes FK: a correction names a remark about the same child.
  @@unique([schoolId, id, studentId], map: "remarks_school_id_id_student_id_key")
  @@index([schoolId, studentId, date], map: "remarks_school_id_student_id_date_idx")
  @@index([schoolId, authorStaffId, date], map: "remarks_school_id_author_staff_id_date_idx")
  @@index([schoolId, subjectId], map: "remarks_school_id_subject_id_idx")
  @@index([schoolId, enrolmentId, studentId], map: "remarks_school_id_enrolment_id_student_id_idx")
  @@index([schoolId, supersedesId, studentId], map: "remarks_school_id_supersedes_id_student_id_idx")
  @@map("remarks")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 slice 14: announcements (contracts/slice-14.md §11, phase-2-daily-operations.md §5
// "Announcements"). Value sets mirror packages/shared/src/announcements.ts
// (test/guardrails/shared-enums.e2e-spec.ts). Hand-written CHECKs, partial uniques, the freeze and
// append-only triggers live in the migration slice14_announcements.
// ---------------------------------------------------------------------------------------------

enum AnnouncementCategory {
  holiday
  exam
  fee
  event
  general

  @@map("announcement_category")
}

enum AnnouncementPriority {
  normal
  urgent

  @@map("announcement_priority")
}

/// `sending` is the in-transaction state of a send (decision 9); no client observes it.
enum AnnouncementStatus {
  draft
  scheduled
  sending
  sent
  cancelled

  @@map("announcement_status")
}

enum AudienceKind {
  everyone
  parents
  students
  staff
  class
  section
  student
  guardian
  staff_member

  @@map("audience_kind")
}

enum AudienceRole {
  parents
  students

  @@map("audience_role")
}

/// Tenant: one announcement (R144-R152). Content is editable while draft or scheduled and frozen
/// once sending, sent or cancelled (trigger announcements_final_frozen). A holiday's notice and
/// its cancellation are announcements naming the holiday (R151). scheduled_at is kept as history
/// on a sent row (decision 11). Never deleted.
model Announcement {
  id                  BigInt               @id(map: "announcements_pkey") @default(autoincrement())
  schoolId            BigInt               @map("school_id")
  /// 1-120, never an identity number (CHECK announcements_title_no_id_check).
  title               String               @db.VarChar(120)
  /// 1-1800 (the composed message body is "{school}: {title}\n{body}" in 2,000; decision 6).
  body                String               @db.VarChar(1800)
  category            AnnouncementCategory
  priority            AnnouncementPriority
  status              AnnouncementStatus   @default(draft)
  /// Required when scheduled, absent on a draft, history afterwards (CHECK announcements_scheduled_check).
  scheduledAt         DateTime?            @map("scheduled_at") @db.Timestamptz(3)
  /// The last day it shows in an inbox (R147); null = never expires.
  expiresOn           DateTime?            @map("expires_on") @db.Date
  /// `{school_id}/{ULID}.{jpg|png|pdf}`; key, mime and size together (CHECK announcements_attachment_check).
  attachmentObjectKey String?              @map("attachment_object_key") @db.VarChar(64)
  attachmentMime      String?              @map("attachment_mime") @db.VarChar(32)
  attachmentSizeBytes Int?                 @map("attachment_size_bytes")
  holidayId           BigInt?              @map("holiday_id")
  createdBy           BigInt               @map("created_by")
  /// Set exactly when sent (CHECK announcements_sent_check).
  sentAt              DateTime?            @map("sent_at") @db.Timestamptz(3)
  /// Set together, exactly when cancelled (CHECK announcements_cancelled_check).
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy         BigInt?              @map("cancelled_by")
  cancelReason        String?              @map("cancel_reason") @db.VarChar(500)
  /// Persons resolved at send (R145); 0 until then.
  recipientCount      Int                  @default(0) @map("recipient_count")
  /// Failed attempts of the send job since the last send (§5.6); the fifth gives up.
  sendFailures        Int                  @default(0) @map("send_failures") @db.SmallInt
  /// Set when the send job gave up; only on a draft (CHECK announcements_send_failed_check).
  sendFailedAt        DateTime?            @map("send_failed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School                  @relation(fields: [schoolId], references: [id], map: "announcements_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  holiday         Holiday?                @relation("AnnouncementHoliday", fields: [schoolId, holidayId], references: [schoolId, id], map: "announcements_holiday_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  createdByUser   User                    @relation("AnnouncementCreatedBy", fields: [schoolId, createdBy], references: [schoolId, id], map: "announcements_created_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User?                   @relation("AnnouncementCancelledBy", fields: [schoolId, cancelledBy], references: [schoolId, id], map: "announcements_cancelled_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  noticeOf        Holiday[]               @relation("HolidayAnnouncement")
  audiences       AnnouncementAudience[]
  recipients      AnnouncementRecipient[]

  @@unique([schoolId, id], map: "announcements_school_id_id_key")
  /// The scheduled-send sweep source (§5.6).
  @@index([schoolId, status, scheduledAt], map: "announcements_school_id_status_scheduled_at_idx")
  /// A `.scope` holder's own list.
  @@index([schoolId, createdBy, createdAt], map: "announcements_school_id_created_by_created_at_idx")
  @@index([schoolId, holidayId], map: "announcements_school_id_holiday_id_idx")
  @@index([schoolId, cancelledBy], map: "announcements_school_id_cancelled_by_idx")
  @@map("announcements")
}

/// Tenant: one audience item of an announcement. Exactly the foreign key its kind names is set
/// (CHECK announcement_audiences_target_check); one row per target (unique index
/// announcement_audiences_target_key). A draft's audience is a form field: rows are replaced on
/// PATCH (decision 12), so this table has no no-delete trigger.
model AnnouncementAudience {
  id             BigInt         @id(map: "announcement_audiences_pkey") @default(autoincrement())
  schoolId       BigInt         @map("school_id")
  announcementId BigInt         @map("announcement_id")
  kind           AudienceKind
  classId        BigInt?        @map("class_id")
  sectionId      BigInt?        @map("section_id")
  studentId      BigInt?        @map("student_id")
  guardianId     BigInt?        @map("guardian_id")
  staffId        BigInt?        @map("staff_id")
  /// class, section and student only; 1-2 distinct (CHECK announcement_audiences_roles_check).
  roles          AudienceRole[] @default([parents, students])
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School       @relation(fields: [schoolId], references: [id], map: "announcement_audiences_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  announcement Announcement @relation(fields: [schoolId, announcementId], references: [schoolId, id], map: "announcement_audiences_announcement_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  class        Class?       @relation(fields: [schoolId, classId], references: [schoolId, id], map: "announcement_audiences_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section      Section?     @relation(fields: [schoolId, sectionId], references: [schoolId, id], map: "announcement_audiences_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student      Student?     @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_audiences_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian     Guardian?    @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "announcement_audiences_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff        Staff?       @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "announcement_audiences_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "announcement_audiences_school_id_id_key")
  @@index([schoolId, announcementId], map: "announcement_audiences_school_id_announcement_id_idx")
  @@index([schoolId, classId], map: "announcement_audiences_school_id_class_id_idx")
  @@index([schoolId, sectionId], map: "announcement_audiences_school_id_section_id_idx")
  @@index([schoolId, studentId], map: "announcement_audiences_school_id_student_id_idx")
  @@index([schoolId, guardianId], map: "announcement_audiences_school_id_guardian_id_idx")
  @@index([schoolId, staffId], map: "announcement_audiences_school_id_staff_id_idx")
  @@map("announcement_audiences")
}

/// Tenant, append-only: one person an announcement resolved to at send (R145), once each
/// (partial uniques per person). Serves viaStudents and attachment access, never the inbox
/// (plan §4.2). message_id is back-filled once, from NULL, in the send transaction.
model AnnouncementRecipient {
  id             BigInt   @id(map: "announcement_recipients_pkey") @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  announcementId BigInt   @map("announcement_id")
  /// Exactly one of the three (CHECK announcement_recipients_person_check).
  guardianId     BigInt?  @map("guardian_id")
  staffId        BigInt?  @map("staff_id")
  studentId      BigInt?  @map("student_id")
  messageId      BigInt?  @map("message_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School                         @relation(fields: [schoolId], references: [id], map: "announcement_recipients_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  announcement Announcement                   @relation(fields: [schoolId, announcementId], references: [schoolId, id], map: "announcement_recipients_announcement_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian     Guardian?                      @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "announcement_recipients_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  staff        Staff?                         @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "announcement_recipients_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student      Student?                       @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_recipients_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  message      Message?                       @relation(fields: [schoolId, messageId], references: [schoolId, id], map: "announcement_recipients_message_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  students     AnnouncementRecipientStudent[]

  @@unique([schoolId, id], map: "announcement_recipients_school_id_id_key")
  @@index([schoolId, announcementId], map: "announcement_recipients_school_id_announcement_id_idx")
  @@index([schoolId, guardianId], map: "announcement_recipients_school_id_guardian_id_idx")
  @@index([schoolId, staffId], map: "announcement_recipients_school_id_staff_id_idx")
  @@index([schoolId, studentId], map: "announcement_recipients_school_id_student_id_idx")
  @@index([schoolId, messageId], map: "announcement_recipients_school_id_message_id_idx")
  @@map("announcement_recipients")
}

/// Tenant, append-only: why a guardian recipient is in the audience, every student that put them
/// there (R145). Staff and student recipients have none.
model AnnouncementRecipientStudent {
  id                      BigInt   @id(map: "announcement_recipient_students_pkey") @default(autoincrement())
  schoolId                BigInt   @map("school_id")
  announcementRecipientId BigInt   @map("announcement_recipient_id")
  studentId               BigInt   @map("student_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school    School                @relation(fields: [schoolId], references: [id], map: "announcement_recipient_students_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  recipient AnnouncementRecipient @relation(fields: [schoolId, announcementRecipientId], references: [schoolId, id], map: "announcement_recipient_students_announcement_recipient_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student   Student               @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "announcement_recipient_students_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "announcement_recipient_students_school_id_id_key")
  @@unique([schoolId, announcementRecipientId, studentId], map: "announcement_recipient_students_key")
  @@index([schoolId, studentId], map: "announcement_recipient_students_school_id_student_id_idx")
  @@map("announcement_recipient_students")
}
