  /// Removes a role default only, never a grant (R50).
  revoke

  @@map("grant_effect")
}

/// Tenant: school-defined roles (rule 13, contracts/slice-7.md §3). Never deleted; archived.
/// key unique among active roles (partial index custom_roles_school_id_key_key).
model CustomRole {
  id        BigInt           @id(map: "custom_roles_pkey") @default(autoincrement())
