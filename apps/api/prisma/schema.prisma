// Conventions: docs/plans/phase-1-foundation.md §3.8. Models PascalCase, tables and columns
// snake_case, every index and constraint named explicitly (Prisma 7's P2002 reports only the
// constraint name). The `partialIndexes` preview feature stays OFF: with it on, the next
// migration drops every hand-written partial index.
//
// A tenant model's relation to School is declared ONLY with @ignore on BOTH sides, e.g.
//   School:         schoolSettings SchoolSettings[] @ignore
//   SchoolSettings: school School @relation(fields: [schoolId], references: [id],
//                     map: "school_settings_school_id_fkey", onDelete: Restrict,
//                     onUpdate: Restrict) @ignore
// The declaration exists so Prisma's migration diff knows the FK (school_id) REFERENCES schools
// (id) and stops emitting `DROP CONSTRAINT "<table>_school_id_fkey"` as drift. @ignore keeps it
// out of the generated client: School gets no back-relation field, so platform code holding no
// SchoolId has no route into tenant rows by include, select or a relation filter. Verified on
// Prisma 7.10.0 (slice 1): `prisma migrate diff --from-migrations prisma/migrations --to-schema
// prisma/schema.prisma` is empty. A relation without @ignore on both sides fails
// test/guardrails/prisma-relations.spec.ts. The BEFORE UPDATE trigger calling
// asms_forbid_school_id_change() stays in migration SQL; the schema guard checks it and the FK.
//
// Never run plain `prisma migrate dev`; generate with `--create-only`, review the SQL, apply with
// `prisma migrate deploy`. A hand-written NON-partial index is seen as drift and dropped by the
// next generated migration, so every non-partial index is declared here. Hand-written CHECKs,
// triggers and partial indexes are invisible to the diff and survive.

generator client {
  provider        = "prisma-client"
  output          = "../src/repositories/generated/prisma"
  moduleFormat    = "cjs"
  // An `undefined` in a query argument becomes an error instead of silently dropping the filter.
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

// Non-tenant (CLAUDE.md named exception 1). Relations among these are allowed; none relates to a
// tenant model except School's @ignore back-relations, which the generated client does not have.
// ---------------------------------------------------------------------------------------------

enum SchoolStatus {
  trial
  active
  suspended
  terminated

  @@map("school_status")
}

enum PlatformUserStatus {
  active
  disabled

  @@map("platform_user_status")
}

enum PlatformSessionStage {
  /// Password accepted, authenticator not yet enrolled: may only enrol, confirm, read /me, log out.
  totp_enrolment
  full

  @@map("platform_session_stage")
}

/// Non-tenant: a group of schools under one owner (rule 11). Each school is still its own tenant.
model SchoolGroup {
  id        BigInt   @id(map: "school_groups_pkey") @default(autoincrement())
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  schools School[]

  @@map("school_groups")
}

/// Non-tenant: the tenant itself. School-owned settings live in tenant tables, not here.
model School {
  id               BigInt                 @id(map: "schools_pkey") @default(autoincrement())
  name             String                 @db.VarChar(200)
  /// 3-12 lower-case ASCII letters/digits (CHECK schools_short_code_format_check), immutable after
  /// creation (trigger raising constraint schools_short_code_immutable).
  shortCode        String                 @map("short_code") @db.VarChar(12)
  /// New schools start as trial; nothing returns to trial (contract slice-1 §4.5).
  status           SchoolStatus           @default(trial)
  schoolGroupId    BigInt?                @map("school_group_id")
  timezone         String                 @default("Asia/Karachi") @db.VarChar(64)
  /// Set by the platform (owner, item 18); read-only to the school. CHECK 0-100000.
  smsMonthlyCap    Int                    @default(500) @map("sms_monthly_cap")
  whatsappProvider WhatsAppProviderChoice @default(platform_default) @map("whatsapp_provider")
  smsProvider      SmsProviderChoice      @default(platform_default) @map("sms_provider")
  /// Set when the school is terminated, iff terminated (CHECK schools_terminated_at_check);
  /// retention ends 12 months later (rule 23).
  terminatedAt     DateTime?              @map("terminated_at") @db.Timestamptz(3)
  /// A manual cap patch sets it; while set the monthly billing run leaves sms_monthly_cap alone (A12).
  smsCapOverridden Boolean                @default(false) @map("sms_cap_overridden")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  schoolGroup                   SchoolGroup?                   @relation(fields: [schoolGroupId], references: [id], map: "schools_school_group_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  platformAuditLogs             PlatformAuditLog[]
  deliveryHealth                PlatformDeliveryHealth[]
  // Tenant back-relations: declared for the migration diff only, absent from the client (header).
  schoolSettings                SchoolSettings[]               @ignore
  schoolCounters                SchoolCounter[]                @ignore
  academicYears                 AcademicYear[]                 @ignore
  classes                       Class[]                        @ignore
  sections                      Section[]                      @ignore
  subjects                      Subject[]                      @ignore
  guardians                     Guardian[]                     @ignore
  staff                         Staff[]                        @ignore
  users                         User[]                         @ignore
  sessions                      Session[]                      @ignore
  userTokens                    UserToken[]                    @ignore
  userRoles                     UserRole[]                     @ignore
  auditLogs                     AuditLog[]                     @ignore
  teacherAssignments            TeacherAssignment[]            @ignore
  students                      Student[]                      @ignore
  studentStatusChanges          StudentStatusChange[]          @ignore
  studentGuardians              StudentGuardian[]              @ignore
  enrolments                    Enrolment[]                    @ignore
  studentDocuments              StudentDocument[]              @ignore
  stagedUploads                 StagedUpload[]                 @ignore
  idempotencyKeys               IdempotencyKey[]               @ignore
  customRoles                   CustomRole[]                   @ignore
  customRoleCapabilities        CustomRoleCapability[]         @ignore
  userCapabilityGrants          UserCapabilityGrant[]          @ignore
  whatsappNumbers               WhatsAppNumber[]               @ignore
  devices                       Device[]                       @ignore
  messages                      Message[]                      @ignore
  messageDeliveries             MessageDelivery[]              @ignore
  messageUsage                  MessageUsage[]                 @ignore
  holidays                      Holiday[]                      @ignore
  attendanceRegisters           AttendanceRegister[]           @ignore
  attendanceMarks               AttendanceMark[]               @ignore
  attendanceMarkChanges         AttendanceMarkChange[]         @ignore
  attendanceArrivals            AttendanceArrival[]            @ignore
  attendanceAlerts              AttendanceAlert[]              @ignore
  attendanceDayStatuses         AttendanceDayStatus[]          @ignore
  attendanceSummaries           AttendanceDailySummary[]       @ignore
  staffAttendance               StaffAttendance[]              @ignore
  staffAttendanceChanges        StaffAttendanceChange[]        @ignore
  diaryEntries                  DiaryEntry[]                   @ignore
  diaryEntryChanges             DiaryEntryChange[]             @ignore
  remarks                       Remark[]                       @ignore
  announcements                 Announcement[]                 @ignore
  announcementAudiences         AnnouncementAudience[]         @ignore
  announcementRecipients        AnnouncementRecipient[]        @ignore
  announcementRecipientStudents AnnouncementRecipientStudent[] @ignore
  feeHeads                      FeeHead[]                      @ignore
  feeStructures                 FeeStructure[]                 @ignore
  paymentAccounts               SchoolPaymentAccount[]         @ignore
  concessions                   Concession[]                   @ignore
  concessionHeads               ConcessionHead[]               @ignore
  chargeRuns                    ChargeRun[]                    @ignore
  chargeCampaigns               ChargeCampaign[]               @ignore
  chargeCampaignAudiences       ChargeCampaignAudience[]       @ignore
  charges                       Charge[]                       @ignore
  expenses                      Expense[]                      @ignore
  leaveTypes                    LeaveType[]                    @ignore
  leaveRequests                 LeaveRequest[]                 @ignore
  payments                      Payment[]                      @ignore
  paymentAllocations            PaymentAllocation[]            @ignore
  receipts                      Receipt[]                      @ignore
  receiptLines                  ReceiptLine[]                  @ignore
  paymentReversals              PaymentReversal[]              @ignore
  cashHandovers                 CashHandover[]                 @ignore
  salaryStructures              SalaryStructure[]              @ignore
  salaryStructureComponents     SalaryStructureComponent[]     @ignore
  salaryAdvances                SalaryAdvance[]                @ignore
  payrollRuns                   PayrollRun[]                   @ignore
  payslips                      Payslip[]                      @ignore
  payslipLines                  PayslipLine[]                  @ignore
  salaryAdvanceRecoveries       SalaryAdvanceRecovery[]        @ignore
  // Phase 3 platform billing: non-tenant rows naming the school (like deliveryHealth).
  platformSubscriptions         PlatformSubscription[]
  platformSchoolMetrics         PlatformSchoolMetric[]
  platformInvoices              PlatformInvoice[]

  @@unique([shortCode], map: "schools_short_code_key")
  @@index([schoolGroupId], map: "schools_school_group_id_idx")
  @@map("schools")
}

/// Non-tenant: platform administrators. Login is email + password + TOTP.
model PlatformUser {
  id                 BigInt             @id(map: "platform_users_pkey") @default(autoincrement())
  /// Stored trimmed and lower-cased (CHECK platform_users_email_lower_check); unique.
  email              String             @db.VarChar(254)
  /// argon2id encoded string (CHECK platform_users_password_hash_check refuses anything else).
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  /// AES-256-GCM `v1:...`, AAD `platform|platform_users|totp_secret|<platform_user_id>`. Null until enrolment starts;
  /// set but unconfirmed while totpEnrolledAt is null.
  totpSecret         String?            @map("totp_secret") @db.VarChar(255)
  totpEnrolledAt     DateTime?          @map("totp_enrolled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; a code at or below it is a replay.
  totpLastStep       BigInt?            @map("totp_last_step")
  mustChangePassword Boolean            @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?          @map("password_changed_at") @db.Timestamptz(3)
  status             PlatformUserStatus @default(active)
  lastLoginAt        DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              PlatformSession[]
  auditLogs             PlatformAuditLog[]
  subscriptionsAssigned PlatformSubscription[]
  invoicesVoided        PlatformInvoice[]
  paymentsRecorded      PlatformPayment[]

  @@unique([email], map: "platform_users_email_key")
  @@map("platform_users")
}

/// Non-tenant: server-side platform sessions (cookie __Host-asms_platform).
model PlatformSession {
  id             BigInt               @id(map: "platform_sessions_pkey") @default(autoincrement())
  platformUserId BigInt               @map("platform_user_id")
  /// Lower-case SHA-256 hex of the token (CHECK platform_sessions_token_hash_check); the token
  /// itself is never stored.
  tokenHash      String               @map("token_hash") @db.Char(64)
  stage          PlatformSessionStage
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?            @map("revoked_at") @db.Timestamptz(3)
  /// Truncated to 255 characters by the application.
  userAgent      String?              @map("user_agent") @db.VarChar(255)
  ip             String?              @db.Inet

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], map: "platform_sessions_platform_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([tokenHash], map: "platform_sessions_token_hash_key")
  @@index([platformUserId], map: "platform_sessions_platform_user_id_idx")
  @@map("platform_sessions")
}

/// Non-tenant, append-only (trigger platform_audit_log_append_only). schoolId is nullable: platform
/// actions on no school (login, seed) have none. actorPlatformUserId is null only for the seed.
model PlatformAuditLog {
  id                  BigInt   @id(map: "platform_audit_log_pkey") @default(autoincrement())
  actorPlatformUserId BigInt?  @map("actor_platform_user_id")
  schoolId            BigInt?  @map("school_id")
  action              String   @db.VarChar(64)
  subjectType         String   @map("subject_type") @db.VarChar(32)
  subjectId           BigInt?  @map("subject_id")
  /// Never holds an identity number (CHECK platform_audit_log_reason_no_id_check).
  reason              String?  @db.VarChar(500)
  /// Never holds an identity number (CHECK platform_audit_log_metadata_no_id_check); timestamps
  /// inside are ISO strings, never epoch milliseconds (13 digits).
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  PlatformUser? @relation(fields: [actorPlatformUserId], references: [id], map: "platform_audit_log_actor_platform_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  school School?       @relation(fields: [schoolId], references: [id], map: "platform_audit_log_school_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@index([schoolId, createdAt], map: "platform_audit_log_school_id_created_at_idx")
  @@index([actorPlatformUserId, createdAt], map: "platform_audit_log_actor_platform_user_id_created_at_idx")
  @@index([subjectType, subjectId, createdAt], map: "platform_audit_log_subject_type_subject_id_created_at_idx")
  @@map("platform_audit_log")
}

// ---------------------------------------------------------------------------------------------
// Tenant. school_id NOT NULL, UNIQUE (school_id, id); the immutability trigger is in migration
// SQL. The relation to School is declared with @ignore on both sides (see header).
// ---------------------------------------------------------------------------------------------

/// Tenant: one row per school, written by the platform in the transaction that creates the school.
model SchoolSettings {
  id                        BigInt           @id(map: "school_settings_pkey") @default(autoincrement())
  schoolId                  BigInt           @map("school_id")
  /// Day of the month fees fall due (rule 15). CHECK 1-28 in migration SQL: every month has it.
  feeDueDay                 Int              @default(10) @map("fee_due_day") @db.SmallInt
  studentLoginEnabled       Boolean          @default(false) @map("student_login_enabled")
  // Phase 2 (plan §4.5, contracts/slice-9.md §4). CHECKs school_settings_*_check in migration SQL.
  periodsPerDay             Int              @default(8) @map("periods_per_day") @db.SmallInt
  /// 0 = Sunday ... 6 = Saturday; distinct, ascending, fewer than seven. Default `[0]`, written as
  /// Postgres prints it: Prisma's `@default([0])` on a smallint list diffs as drift every time.
  weeklyOffDays             Int[]            @default(dbgenerated("ARRAY[(0)::smallint]")) @map("weekly_off_days") @db.SmallInt
  attendanceAmendWindowDays Int              @default(3) @map("attendance_amend_window_days") @db.SmallInt
  /// School-local times.
  registerDeadlineTime      DateTime         @default(dbgenerated("'10:00:00'::time without time zone")) @map("register_deadline_time") @db.Time(0)
  absenceAlertTime          DateTime         @default(dbgenerated("'09:30:00'::time without time zone")) @map("absence_alert_time") @db.Time(0)
  lateAdviceEnabled         Boolean          @default(false) @map("late_advice_enabled")
  lateCountsAs              LateCountsAs     @default(present) @map("late_counts_as")
  /// Required while late_counts_as = absent_after_cutoff.
  lateCutoffTime            DateTime?        @map("late_cutoff_time") @db.Time(0)
  leaveCountsAs             LeaveCountsAs    @default(excused) @map("leave_counts_as")
  /// SMS-eligible types only; the default is register item 22's list, with Phase 3's four fee
  /// types (phase-3-financial.md §1.1; backfilled into existing rows).
  smsAllowedTypes           MessageType[]    @default([absence_alert, late_advice, attendance_corrected, announcement_urgent, holiday_notice, fee_due_reminder, fee_overdue, receipt_issued, payment_claim_rejected]) @map("sms_allowed_types")
  remarkDefaultVisibility   RemarkVisibility @default(guardian) @map("remark_default_visibility")
  remarkNotifyGuardians     Boolean          @default(false) @map("remark_notify_guardians")
  // Phase 3 (phase-3-financial.md §3.8). CHECKs school_settings_*_check in migration SQL.
  /// A student whose earliest enrolment start in the year is after this day is not charged that
  /// month's monthly heads (R180). 1-28.
  feeCutoffDay              Int              @default(15) @map("fee_cutoff_day") @db.SmallInt
  lateFeeEnabled            Boolean          @default(false) @map("late_fee_enabled")
  /// Whole rupees; required while late fees are enabled (no default: it must be entered).
  lateFeeAmount             Int?             @map("late_fee_amount")
  /// 0-30.
  lateFeeGraceDays          Int              @default(7) @map("late_fee_grace_days") @db.SmallInt
  /// Stamped each time late fees are switched on; only charges due on or after it attract one.
  lateFeeEnabledAt          DateTime?        @map("late_fee_enabled_at") @db.Timestamptz(3)
  /// An expense above it needs the principal's approval (rule 22). Whole rupees, 0 or more.
  expenseApprovalThreshold  Int              @default(5000) @map("expense_approval_threshold")
  /// The payroll job prepares the previous month on this day (rule 22). 1-28.
  payDay                    Int              @default(1) @map("pay_day") @db.SmallInt
  /// 0-10 days before fee_due_day.
  feeReminderDaysBefore     Int              @default(3) @map("fee_reminder_days_before") @db.SmallInt
  /// 7-30.
  overdueReminderEveryDays  Int              @default(14) @map("overdue_reminder_every_days") @db.SmallInt
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "school_settings_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore

  @@unique([schoolId], map: "school_settings_school_id_key")
  @@unique([schoolId, id], map: "school_settings_school_id_id_key")
  @@map("school_settings")
}

/// Tenant: per-school sequences (admission_no now, certificate numbers later). Advanced by one
/// UPDATE ... SET value = value + 1 RETURNING value inside the caller's transaction, never
/// read-then-write.
model SchoolCounter {
  id        BigInt   @id(map: "school_counters_pkey") @default(autoincrement())
  schoolId  BigInt   @map("school_id")
  /// snake_case key, e.g. admission_no (CHECK school_counters_name_check).
  name      String   @db.VarChar(32)
  /// Last value issued; 0 means none yet (CHECK school_counters_value_check: never negative).
  value     BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "school_counters_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore

  @@unique([schoolId, name], map: "school_counters_school_id_name_key")
  @@unique([schoolId, id], map: "school_counters_school_id_id_key")
  @@map("school_counters")
}

// ---------------------------------------------------------------------------------------------
// Slice 3: academic structure. Names are stored trimmed and non-empty (CHECK <table>_name_check),
// so a trailing space cannot defeat a uniqueness rule; the API trims before writing.
// ---------------------------------------------------------------------------------------------

enum AcademicYearStatus {
  planned
  active
  closed

  @@map("academic_year_status")
}

enum ClassStatus {
  active
  archived

  @@map("class_status")
}

/// Rule 14: how staff record attendance for the class. A daily mark is stored as period 1.
enum AttendanceMode {
  daily
  period

  @@map("attendance_mode")
}

/// Tenant: a session (rule 15). A school may run several at once; each class belongs to one.
model AcademicYear {
  id        BigInt             @id(map: "academic_years_pkey") @default(autoincrement())
  schoolId  BigInt             @map("school_id")
  /// Unique per school (academic_years_school_id_name_key).
  name      String             @db.VarChar(100)
  startsOn  DateTime           @map("starts_on") @db.Date
  /// CHECK academic_years_dates_check: ends_on > starts_on.
  endsOn    DateTime           @map("ends_on") @db.Date
  status    AcademicYearStatus @default(planned)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School           @relation(fields: [schoolId], references: [id], map: "academic_years_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  classes         Class[]
  chargeRuns      ChargeRun[]
  chargeCampaigns ChargeCampaign[]
  payments        Payment[]

  @@unique([schoolId, id], map: "academic_years_school_id_id_key")
  @@unique([schoolId, name], map: "academic_years_school_id_name_key")
  @@map("academic_years")
}

/// Tenant: one row per class per academic year. The year never changes once the class is
/// referenced: by a section, trigger classes_academic_year_immutable; by later rows (teacher
/// assignments, enrolments), their FKs to (school_id, id, academic_year_id) ON UPDATE RESTRICT.
model Class {
  id             BigInt         @id(map: "classes_pkey") @default(autoincrement())
  schoolId       BigInt         @map("school_id")
  academicYearId BigInt         @map("academic_year_id")
  /// Unique per year (classes_school_id_academic_year_id_name_key), archived classes included.
  name           String         @db.VarChar(100)
  /// Display order; CHECK classes_sort_order_check: 0 or more.
  sortOrder      Int            @default(0) @map("sort_order")
  /// No default: the school chooses per class (rule 14, contract slice-3 §3.3).
  attendanceMode AttendanceMode @map("attendance_mode")
  status         ClassStatus    @default(active)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                  School                   @relation(fields: [schoolId], references: [id], map: "classes_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  academicYear            AcademicYear             @relation(fields: [schoolId, academicYearId], references: [schoolId, id], map: "classes_academic_year_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  sections                Section[]
  teacherAssignments      TeacherAssignment[]
  enrolments              Enrolment[]
  attendanceRegisters     AttendanceRegister[]
  attendanceSummaries     AttendanceDailySummary[]
  diaryEntries            DiaryEntry[]
  announcementAudiences   AnnouncementAudience[]
  feeStructures           FeeStructure[]
  chargeCampaignAudiences ChargeCampaignAudience[]

  @@unique([schoolId, id], map: "classes_school_id_id_key")
  /// Target of (school_id, class_id, academic_year_id) FKs: a row naming a class names its year too.
  @@unique([schoolId, id, academicYearId], map: "classes_school_id_id_academic_year_id_key")
  @@unique([schoolId, academicYearId, name], map: "classes_school_id_academic_year_id_name_key")
  @@map("classes")
}

/// Tenant config table: soft-deleted by deleted_at. Live names are unique per class by the partial
/// index sections_school_id_class_id_name_key (migration SQL, WHERE deleted_at IS NULL).
model Section {
  id        BigInt    @id(map: "sections_pkey") @default(autoincrement())
  schoolId  BigInt    @map("school_id")
  classId   BigInt    @map("class_id")
  name      String    @db.VarChar(50)
  /// Null = no limit; CHECK sections_capacity_check: 1 or more.
  capacity  Int?      @db.SmallInt
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                  School                   @relation(fields: [schoolId], references: [id], map: "sections_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  class                   Class                    @relation(fields: [schoolId, classId], references: [schoolId, id], map: "sections_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  teacherAssignments      TeacherAssignment[]
  enrolments              Enrolment[]
  attendanceRegisters     AttendanceRegister[]
  attendanceDayStatuses   AttendanceDayStatus[]
  attendanceSummaries     AttendanceDailySummary[]
  diaryEntries            DiaryEntry[]
  announcementAudiences   AnnouncementAudience[]
  chargeCampaignAudiences ChargeCampaignAudience[]

  @@unique([schoolId, id], map: "sections_school_id_id_key")
  /// Target of (school_id, section_id, class_id) FKs: an enrolment's section is of its class.
  @@unique([schoolId, id, classId], map: "sections_school_id_id_class_id_key")
  @@index([schoolId, classId], map: "sections_school_id_class_id_idx")
  @@map("sections")
}

/// Tenant config table: soft-deleted by deleted_at. Live name and live code are each unique per
/// school by partial indexes subjects_school_id_name_key / subjects_school_id_code_key.
model Subject {
  id        BigInt    @id(map: "subjects_pkey") @default(autoincrement())
  schoolId  BigInt    @map("school_id")
  name      String    @db.VarChar(100)
  code      String?   @db.VarChar(20)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school             School              @relation(fields: [schoolId], references: [id], map: "subjects_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  teacherAssignments TeacherAssignment[]
  diaryEntries       DiaryEntry[]
  remarks            Remark[]

  @@unique([schoolId, id], map: "subjects_school_id_id_key")
  @@map("subjects")
}

// ---------------------------------------------------------------------------------------------
// Identity numbers (plan §3.6), on every table that holds one: `cnic` is the AES-256-GCM envelope
// `v1:<keyId>:<iv>:<tag>:<ciphertext>` (CHECK <table>_cnic_check), `cnic_hash` the lower-hex
// HMAC-SHA256 of the 13 digits (CHECK <table>_cnic_hash_check); both or neither
// (CHECK <table>_cnic_pair_check). Phones are E.164 (CHECK <table>_phone_check); emails are
// stored trimmed and lower-cased (CHECK <table>_email_normalised_check).
// ---------------------------------------------------------------------------------------------

/// Rule 17: asked at admission, editable later. There is no "unknown"; the office must pick.
enum ContactCapability {
  whatsapp
  smartphone_data
  keypad

  @@map("contact_capability")
}

enum GuardianStatus {
  active
  /// Folded into merged_into_id (CHECK guardians_merged_check); lookups resolve to the survivor.
  merged

  @@map("guardian_status")
}

/// Tenant: a parent or guardian, linked to students through student_guardians (slice 6). One row
/// per person per school: a live CNIC is unique (partial index guardians_school_id_cnic_hash_key).
/// Phone is deliberately not unique (siblings' parents share a number).
model Guardian {
  id                BigInt            @id(map: "guardians_pkey") @default(autoincrement())
  schoolId          BigInt            @map("school_id")
  fullName          String            @map("full_name") @db.VarChar(200)
  cnic              String?           @db.VarChar(255)
  cnicHash          String?           @map("cnic_hash") @db.Char(64)
  phone             String?           @db.VarChar(16)
  email             String?           @db.VarChar(254)
  contactCapability ContactCapability @map("contact_capability")
  address           String?           @db.VarChar(500)
  /// Set exactly when status = merged (CHECK guardians_merged_check); never this row's own id.
  mergedIntoId      BigInt?           @map("merged_into_id")
  status            GuardianStatus    @default(active)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                 School                  @relation(fields: [schoolId], references: [id], map: "guardians_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  mergedInto             Guardian?               @relation("GuardianMerge", fields: [schoolId, mergedIntoId], references: [schoolId, id], map: "guardians_merged_into_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  mergedFrom             Guardian[]              @relation("GuardianMerge")
  user                   User?
  studentLinks           StudentGuardian[]
  messages               Message[]
  announcementAudiences  AnnouncementAudience[]
  announcementRecipients AnnouncementRecipient[]
  paymentsPaid           Payment[]

  @@unique([schoolId, id], map: "guardians_school_id_id_key")
  @@index([schoolId, phone], map: "guardians_school_id_phone_idx")
  @@index([schoolId, mergedIntoId], map: "guardians_school_id_merged_into_id_idx")
  @@map("guardians")
}

// ---------------------------------------------------------------------------------------------
// Slice 2: staff (minimal; slice 4 completes it), users, sessions, tokens, roles, audit.
// ---------------------------------------------------------------------------------------------

enum StaffStatus {
  active
  suspended
  left

  @@map("staff_status")
}

enum UserStatus {
  active
  /// Written only by the disable endpoint (R71). "No active capacity" is derived, never stored.
  disabled

  @@map("user_status")
}

/// A token is accepted only on the channel it was minted for (§3.5).
enum SessionChannel {
  cookie
  bearer

  @@map("session_channel")
}

enum UserTokenPurpose {
  password_reset
  email_verify

  @@map("user_token_purpose")
}

/// Stored system roles. Parent and student are not rows: they derive from users.guardian_id and
/// (slice 6) users.student_id.
enum SystemRole {
  principal
  office_staff
  teacher

  @@map("system_role")
}

/// Tenant: one row per employed person (rule 7). Identity-number columns: see the comment above
/// Guardian. cnic is nullable (R21: no CNIC, no login); a CNIC appears on at most one staff row in
/// the school, any status (R20, partial index staff_school_id_cnic_hash_key).
model Staff {
  id          BigInt      @id(map: "staff_pkey") @default(autoincrement())
  schoolId    BigInt      @map("school_id")
  fullName    String      @map("full_name") @db.VarChar(200)
  cnic        String?     @db.VarChar(255)
  cnicHash    String?     @map("cnic_hash") @db.Char(64)
  phone       String      @db.VarChar(16)
  designation String?     @db.VarChar(100)
  joinedOn    DateTime?   @map("joined_on") @db.Date
  status      StaffStatus @default(active)
  /// Last day of employment. Set only while status = left (CHECK staff_left_on_check), cleared on
  /// re-hire (R19); never before joined_on (CHECK staff_left_on_after_joined_check).
  leftOn      DateTime?   @map("left_on") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                 School                  @relation(fields: [schoolId], references: [id], map: "staff_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user                   User?
  messages               Message[]
  teacherAssignments     TeacherAssignment[]
  attendance             StaffAttendance[]
  diaryEntries           DiaryEntry[]
  remarks                Remark[]
  announcementAudiences  AnnouncementAudience[]
  announcementRecipients AnnouncementRecipient[]
  leaveRequests          LeaveRequest[]
  salaryStructures       SalaryStructure[]
  salaryAdvances         SalaryAdvance[]
  payslips               Payslip[]

  @@unique([schoolId, id], map: "staff_school_id_id_key")
  @@map("staff")
}

// ---------------------------------------------------------------------------------------------
// Slice 4: teacher assignments, the only source of a teacher's scope (§3.4, R53, R54).
// ---------------------------------------------------------------------------------------------

/// Teacher is one role; class teacher and subject teacher are assignments (rule 13).
enum TeacherAssignmentRole {
  class_teacher
  subject_teacher
  /// A dated class-teacher scope for one section (Phase 2 R132): CHECK teacher_assignments_cover_check.
  cover

  @@map("teacher_assignment_role")
}

/// Tenant: a staff member teaching a class (and section, and subject) between two dates. Active
/// means active today in the school's timezone: voided_at IS NULL AND starts_on <= today AND
/// (ends_on IS NULL OR ends_on >= today). Ending sets ends_on; a row that has not begun is voided
/// instead (voided_at + voided_by, CHECK teacher_assignments_voided_check), never deleted. Every
/// other column is frozen by trigger teacher_assignments_columns_immutable (R23: reassignment ends
/// or voids the old row and inserts a new one).
///
/// - class_teacher: section set, subject null (CHECK teacher_assignments_class_teacher_check).
/// - subject_teacher: subject set (CHECK teacher_assignments_subject_teacher_check); a null section
///   scopes every section of the class (R54).
/// - One class teacher per section at any date among unvoided rows: EXCLUDE
///   teacher_assignments_class_teacher_excl (btree_gist), migration SQL.
/// - (school_id, class_id, academic_year_id) -> classes ON UPDATE RESTRICT: a class's year cannot
///   change while an assignment names it, even before the class has a section (the trigger
///   classes_academic_year_immutable covers sections only). (school_id, section_id, class_id) ->
///   sections: the section is one of the class's.
model TeacherAssignment {
  id                 BigInt                @id(map: "teacher_assignments_pkey") @default(autoincrement())
  schoolId           BigInt                @map("school_id")
  staffId            BigInt                @map("staff_id")
  academicYearId     BigInt                @map("academic_year_id")
  classId            BigInt                @map("class_id")
  sectionId          BigInt?               @map("section_id")
  subjectId          BigInt?               @map("subject_id")
  role               TeacherAssignmentRole
  startsOn           DateTime              @map("starts_on") @db.Date
  /// Inclusive last day; null = open-ended. CHECK teacher_assignments_dates_check: >= starts_on.
  endsOn             DateTime?             @map("ends_on") @db.Date
  voidedAt           DateTime?             @map("voided_at") @db.Timestamptz(3)
  /// cover only (CHECK teacher_assignments_covers_check): the class-teacher row being covered, in
  /// the same section; null when the section has no class teacher. Frozen.
  coversAssignmentId BigInt?               @map("covers_assignment_id")
  voidedBy           BigInt?               @map("voided_by")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school           School              @relation(fields: [schoolId], references: [id], map: "teacher_assignments_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff            Staff               @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "teacher_assignments_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  class            Class               @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "teacher_assignments_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  section          Section?            @relation(fields: [schoolId, sectionId, classId], references: [schoolId, id, classId], map: "teacher_assignments_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  subject          Subject?            @relation(fields: [schoolId, subjectId], references: [schoolId, id], map: "teacher_assignments_subject_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  voidedByUser     User?               @relation(fields: [schoolId, voidedBy], references: [schoolId, id], map: "teacher_assignments_voided_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  coversAssignment TeacherAssignment?  @relation("CoverOf", fields: [schoolId, coversAssignmentId, sectionId], references: [schoolId, id, sectionId], map: "teacher_assignments_covers_assignment_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  coveredBy        TeacherAssignment[] @relation("CoverOf")
  leaveCovered     LeaveRequest[]

  @@unique([schoolId, id], map: "teacher_assignments_school_id_id_key")
  /// Target of the cover FK: a cover names a class-teacher row of its own section.
  @@unique([schoolId, id, sectionId], map: "teacher_assignments_school_id_id_section_id_key")
  @@index([schoolId, staffId], map: "teacher_assignments_school_id_staff_id_idx")
  @@index([schoolId, classId, academicYearId], map: "teacher_assignments_school_id_class_id_academic_year_id_idx")
  @@index([schoolId, sectionId, classId], map: "teacher_assignments_school_id_section_id_class_id_idx")
  @@index([schoolId, subjectId], map: "teacher_assignments_school_id_subject_id_idx")
  @@index([schoolId, voidedBy], map: "teacher_assignments_school_id_voided_by_idx")
  /// The cover FK's index (contracts/slice-10.md §12 item 3).
  @@index([schoolId, coversAssignmentId, sectionId], map: "teacher_assignments_school_id_covers_assignment_id_idx")
  @@map("teacher_assignments")
}

/// Tenant: a login. One per person per school: (school_id, staff_id) and (school_id, guardian_id)
/// are unique, and a teacher who is also a parent has ONE user carrying both (rule 12). The
/// username is never stored in clear: username_hash is the HMAC of the 13 digits. Email is not
/// unique (R8). At least one person link (CHECK users_person_check).
///
/// A student login's username is the B-Form digits (rule 12). Issue-student-login never links to
/// an existing user (R40); (school_id, student_id) is unique like the other two person links.
model User {
  id                BigInt     @id(map: "users_pkey") @default(autoincrement())
  schoolId          BigInt     @map("school_id")
  /// Lower-hex HMAC-SHA256 (IDENTITY_HASH_KEY) of the 13 digits (CHECK users_username_hash_check).
  usernameHash      String     @map("username_hash") @db.Char(64)
  /// argon2id encoded (CHECK users_password_hash_check).
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  email             String?    @db.VarChar(254)
  /// Null whenever email changes (R7); set only with an email (CHECK users_email_verified_check).
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordIsDefault Boolean    @default(true) @map("password_is_default")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  status            UserStatus @default(active)
  staffId           BigInt?    @map("staff_id")
  guardianId        BigInt?    @map("guardian_id")
  studentId         BigInt?    @map("student_id")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Last office reset (contract slice-2 §5.4). The first login with last_login_at null or older
  /// than this marks that login's user.login_on_default_password row afterOfficeReset: true.
  officeResetAt     DateTime?  @map("office_reset_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                    School                  @relation(fields: [schoolId], references: [id], map: "users_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  staff                     Staff?                  @relation(fields: [schoolId, staffId], references: [schoolId, id], map: "users_staff_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian                  Guardian?               @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "users_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  student                   Student?                @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "users_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  sessions                  Session[]
  tokens                    UserToken[]
  roles                     UserRole[]              @relation("UserRoleHolder")
  rolesAssigned             UserRole[]              @relation("UserRoleAssignedBy")
  rolesEnded                UserRole[]              @relation("UserRoleEndedBy")
  auditLogs                 AuditLog[]
  studentStatusChanges      StudentStatusChange[]
  studentDocuments          StudentDocument[]
  stagedUploads             StagedUpload[]
  idempotencyKeys           IdempotencyKey[]
  teacherAssignmentsVoided  TeacherAssignment[]
  capabilityGrants          UserCapabilityGrant[]   @relation("GrantHolder")
  capabilityGrantsMade      UserCapabilityGrant[]   @relation("GrantGrantedBy")
  capabilityGrantsEnded     UserCapabilityGrant[]   @relation("GrantRevokedBy")
  customRoleKeysAdded       CustomRoleCapability[]  @relation("CustomRoleCapabilityAddedBy")
  customRoleKeysRemoved     CustomRoleCapability[]  @relation("CustomRoleCapabilityRemovedBy")
  devices                   Device[]
  whatsappNumbersPaired     WhatsAppNumber[]        @relation("WhatsAppNumberPairedBy")
  whatsappNumbersDisabled   WhatsAppNumber[]        @relation("WhatsAppNumberDisabledBy")
  holidaysPublished         Holiday[]               @relation("HolidayPublishedBy")
  holidaysCancelled         Holiday[]               @relation("HolidayCancelledBy")
  registersSubmitted        AttendanceRegister[]    @relation("RegisterSubmittedBy")
  registersAmended          AttendanceRegister[]    @relation("RegisterLastAmendedBy")
  attendanceMarkChanges     AttendanceMarkChange[]
  attendanceArrivals        AttendanceArrival[]
  staffAttendanceMarked     StaffAttendance[]
  staffAttendanceChanges    StaffAttendanceChange[]
  diaryEntryChanges         DiaryEntryChange[]
  announcementsCreated      Announcement[]          @relation("AnnouncementCreatedBy")
  announcementsCancelled    Announcement[]          @relation("AnnouncementCancelledBy")
  feeHeadsCreated           FeeHead[]               @relation("FeeHeadCreatedBy")
  feeHeadsArchived          FeeHead[]               @relation("FeeHeadArchivedBy")
  feeStructuresCreated      FeeStructure[]
  paymentAccountsCreated    SchoolPaymentAccount[]  @relation("PaymentAccountCreatedBy")
  paymentAccountsDisabled   SchoolPaymentAccount[]  @relation("PaymentAccountDisabledBy")
  concessionsRequested      Concession[]            @relation("ConcessionRequestedBy")
  concessionsDecided        Concession[]            @relation("ConcessionDecidedBy")
  concessionsEnded          Concession[]            @relation("ConcessionEndedBy")
  chargeRunsTriggered       ChargeRun[]
  chargeCampaignsCreated    ChargeCampaign[]        @relation("ChargeCampaignCreatedBy")
  chargeCampaignsCancelled  ChargeCampaign[]        @relation("ChargeCampaignCancelledBy")
  chargesCreated            Charge[]                @relation("ChargeCreatedBy")
  chargesVoided             Charge[]                @relation("ChargeVoidedBy")
  chargesWaived             Charge[]                @relation("ChargeWaivedBy")
  expensesRecorded          Expense[]               @relation("ExpenseRecordedBy")
  expensesDecided           Expense[]               @relation("ExpenseDecidedBy")
  expensesVoided            Expense[]               @relation("ExpenseVoidedBy")
  leaveTypesCreated         LeaveType[]             @relation("LeaveTypeCreatedBy")
  leaveTypesArchived        LeaveType[]             @relation("LeaveTypeArchivedBy")
  leaveRequested            LeaveRequest[]          @relation("LeaveRequestRequestedBy")
  leaveDecided              LeaveRequest[]          @relation("LeaveRequestDecidedBy")
  leaveCancelled            LeaveRequest[]          @relation("LeaveRequestCancelledBy")
  paymentsRecorded          Payment[]               @relation("PaymentRecordedBy")
  paymentsVerified          Payment[]               @relation("PaymentVerifiedBy")
  receiptsIssued            Receipt[]
  paymentReversalsRequested PaymentReversal[]       @relation("PaymentReversalRequestedBy")
  paymentReversalsApproved  PaymentReversal[]       @relation("PaymentReversalApprovedBy")
  cashHandoversCollected    CashHandover[]          @relation("CashHandoverCollector")
  cashHandoversOpened       CashHandover[]          @relation("CashHandoverOpenedBy")
  cashHandoversConfirmed    CashHandover[]          @relation("CashHandoverConfirmedBy")
  cashHandoversResolved     CashHandover[]          @relation("CashHandoverResolvedBy")
  salaryStructuresCreated   SalaryStructure[]
  salaryAdvancesApproved    SalaryAdvance[]         @relation("SalaryAdvanceApprovedBy")
  salaryAdvancesWrittenOff  SalaryAdvance[]         @relation("SalaryAdvanceWrittenOffBy")
  payrollRunsPrepared       PayrollRun[]            @relation("PayrollRunPreparedBy")
  payrollRunsFinalised      PayrollRun[]            @relation("PayrollRunFinalisedBy")
  payslipsPaid              Payslip[]
  payslipLinesCreated       PayslipLine[]

  @@unique([schoolId, id], map: "users_school_id_id_key")
  @@unique([schoolId, usernameHash], map: "users_school_id_username_hash_key")
  // NULLs are distinct: these index the FKs and make "one login per person" a database fact.
  @@unique([schoolId, staffId], map: "users_school_id_staff_id_key")
  @@unique([schoolId, guardianId], map: "users_school_id_guardian_id_key")
  @@unique([schoolId, studentId], map: "users_school_id_student_id_key")
  /// Target of (school_id, user_id, staff_id) FKs binding a collector's user and staff (§3.2).
  @@unique([schoolId, id, staffId], map: "users_school_id_id_staff_id_key")
  @@map("users")
}

/// Tenant: server-side sessions (§3.5). token_hash is globally unique because resolving a session
/// is what establishes the tenant (CLAUDE.md named exception 4); its index is the one allowlisted
/// tenant index that does not lead with school_id.
model Session {
  id         BigInt         @id(map: "sessions_pkey") @default(autoincrement())
  schoolId   BigInt         @map("school_id")
  userId     BigInt         @map("user_id")
  /// Lower-hex SHA-256 of the token (CHECK sessions_token_hash_check); the token is never stored.
  tokenHash  String         @map("token_hash") @db.Char(64)
  channel    SessionChannel
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry (CHECK sessions_expires_at_check: after created_at).
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(3)
  /// Truncated to 255 characters by the application.
  userAgent  String?        @map("user_agent") @db.VarChar(255)
  ip         String?        @db.Inet
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School  @relation(fields: [schoolId], references: [id], map: "sessions_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user   User    @relation(fields: [schoolId, userId], references: [schoolId, id], map: "sessions_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  device Device?

  @@unique([schoolId, id], map: "sessions_school_id_id_key")
  @@unique([tokenHash], map: "sessions_token_hash_key")
  @@index([schoolId, userId], map: "sessions_school_id_user_id_idx")
  /// The daily session purge (contracts/slice-9.md §1.5): revoked or expired before a cut-off.
  @@index([schoolId, revokedAt], map: "sessions_school_id_revoked_at_idx")
  @@index([schoolId, expiresAt], map: "sessions_school_id_expires_at_idx")
  @@map("sessions")
}

/// Tenant: single-use reset and email-verification tokens. Consumed by one conditional UPDATE
/// (used_at IS NULL AND expires_at > now()), never read-then-write. used_at means consumed only;
/// voiding an outstanding token (disable, office reset, a newer request) sets expires_at = now(),
/// so no CHECK relates expires_at to created_at.
model UserToken {
  id        BigInt           @id(map: "user_tokens_pkey") @default(autoincrement())
  schoolId  BigInt           @map("school_id")
  userId    BigInt           @map("user_id")
  purpose   UserTokenPurpose
  /// Lower-hex SHA-256 of the token (CHECK user_tokens_token_hash_check).
  tokenHash String           @map("token_hash") @db.Char(64)
  /// The address an email_verify token was issued for; set exactly for that purpose
  /// (CHECK user_tokens_email_check).
  email     String?          @db.VarChar(254)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "user_tokens_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user   User   @relation(fields: [schoolId, userId], references: [schoolId, id], map: "user_tokens_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "user_tokens_school_id_id_key")
  @@unique([schoolId, tokenHash], map: "user_tokens_school_id_token_hash_key")
  @@index([schoolId, userId, purpose], map: "user_tokens_school_id_user_id_purpose_idx")
  @@map("user_tokens")
}

/// Tenant: role assignments. Ended, never deleted. Exactly one of system_role / custom_role_id
/// (CHECK user_roles_one_role_check). One live row per (user, system role) and per (user, custom
/// role): partial indexes user_roles_school_id_user_id_system_role_key and
/// user_roles_school_id_user_id_custom_role_key.
model UserRole {
  id           BigInt      @id(map: "user_roles_pkey") @default(autoincrement())
  schoolId     BigInt      @map("school_id")
  userId       BigInt      @map("user_id")
  systemRole   SystemRole? @map("system_role")
  customRoleId BigInt?     @map("custom_role_id")
  /// Null only for a principal role issued by the platform (issue-principal-login), whose actor is
  /// in audit_log.actor_platform_user_id (CHECK user_roles_assigned_by_check).
  assignedBy   BigInt?     @map("assigned_by")
  assignedAt   DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(3)
  /// ended_at and ended_by are set together (CHECK user_roles_ended_check).
  endedAt      DateTime?   @map("ended_at") @db.Timestamptz(3)
  endedBy      BigInt?     @map("ended_by")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School      @relation(fields: [schoolId], references: [id], map: "user_roles_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user           User        @relation("UserRoleHolder", fields: [schoolId, userId], references: [schoolId, id], map: "user_roles_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  assignedByUser User?       @relation("UserRoleAssignedBy", fields: [schoolId, assignedBy], references: [schoolId, id], map: "user_roles_assigned_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  endedByUser    User?       @relation("UserRoleEndedBy", fields: [schoolId, endedBy], references: [schoolId, id], map: "user_roles_ended_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  customRole     CustomRole? @relation(fields: [schoolId, customRoleId], references: [schoolId, id], map: "user_roles_custom_role_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "user_roles_school_id_id_key")
  @@index([schoolId, userId], map: "user_roles_school_id_user_id_idx")
  @@index([schoolId, assignedBy], map: "user_roles_school_id_assigned_by_idx")
  @@index([schoolId, endedBy], map: "user_roles_school_id_ended_by_idx")
  @@index([schoolId, customRoleId], map: "user_roles_school_id_custom_role_id_idx")
  @@map("user_roles")
}

/// Tenant, append-only (§3.7; triggers audit_log_append_only and audit_log_no_truncate). Written
/// by AuditService.record() inside the transaction of the change. Exactly one actor
/// (CHECK audit_log_actor_check): a school user, or a platform admin acting through one of the two
/// platform operations inside a school. actor_platform_user_id and subject_id carry no FK: the
/// first points at a non-tenant table (a tenant->platform relation cannot be declared under
/// test/guardrails/prisma-relations.spec.ts, and an undeclared FK is dropped as drift by every
/// generated migration), the second is polymorphic. Both are allowlisted in the schema guard
/// (NON_FK_ID_COLUMNS in test/guardrails/schema-checks.ts).
model AuditLog {
  id                  BigInt   @id(map: "audit_log_pkey") @default(autoincrement())
  schoolId            BigInt   @map("school_id")
  actorUserId         BigInt?  @map("actor_user_id")
  actorPlatformUserId BigInt?  @map("actor_platform_user_id")
  action              String   @db.VarChar(64)
  subjectType         String   @map("subject_type") @db.VarChar(32)
  subjectId           BigInt?  @map("subject_id")
  /// Never holds an identity number (CHECK audit_log_reason_no_id_check).
  reason              String?  @db.VarChar(500)
  /// Never holds an identity number (CHECK audit_log_metadata_no_id_check); timestamps inside are
  /// ISO strings, never epoch milliseconds (13 digits).
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school    School @relation(fields: [schoolId], references: [id], map: "audit_log_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  actorUser User?  @relation(fields: [schoolId, actorUserId], references: [schoolId, id], map: "audit_log_actor_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "audit_log_school_id_id_key")
  @@index([schoolId, subjectType, subjectId, createdAt], map: "audit_log_school_id_subject_type_subject_id_created_at_idx")
  @@index([schoolId, actorUserId, createdAt], map: "audit_log_school_id_actor_user_id_created_at_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// Slice 6: students, guardian links, enrolment (the hub, rule 6), documents, uploads, idempotency.
// The B-Form follows the identity-number pattern above: b_form is the AES-256-GCM envelope (AAD
// `schoolId|students|b_form`), b_form_hash the HMAC of the 13 digits, both or neither.
// ---------------------------------------------------------------------------------------------

enum StudentStatus {
  active
  suspended
  withdrawn
  transferred
  alumni

  @@map("student_status")
}

/// As recorded on the B-Form. Adding a value is a normal migration; removing one is not.
enum Gender {
  male
  female

  @@map("gender")
}

enum GuardianRelationship {
  father
  mother
  guardian
  other

  @@map("guardian_relationship")
}

enum EnrolmentStatus {
  active
  completed
  left

  @@map("enrolment_status")
}

enum StudentDocumentType {
  b_form
  photo
  previous_school_leaving
  guardian_cnic
  other

  @@map("student_document_type")
}

/// Tenant: a child admitted to the school. Academic and financial records hang off Enrolment, not
/// here (rule 6). A B-Form appears on at most one student in the school, any status (R25; R26: a
/// hit on a former student offers readmission). Partial index students_school_id_b_form_hash_key.
model Student {
  id          BigInt        @id(map: "students_pkey") @default(autoincrement())
  schoolId    BigInt        @map("school_id")
  /// Decimal digits from school_counters 'admission_no' (CHECK students_admission_no_check: no
  /// leading zero, at most 12 digits, so never an identity-number run). Text, so sort numerically
  /// with ORDER BY length(admission_no), admission_no. Unique per school
  /// (students_school_id_admission_no_key).
  admissionNo String        @map("admission_no") @db.VarChar(20)
  fullName    String        @map("full_name") @db.VarChar(200)
  gender      Gender
  /// CHECK students_date_of_birth_check: before admitted_on.
  dateOfBirth DateTime      @map("date_of_birth") @db.Date
  bForm       String?       @map("b_form") @db.VarChar(255)
  bFormHash   String?       @map("b_form_hash") @db.Char(64)
  status      StudentStatus @default(active)
  admittedOn  DateTime      @map("admitted_on") @db.Date
  /// Never holds an identity number (CHECK students_notes_no_id_check).
  notes       String?       @db.VarChar(2000)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                        School                         @relation(fields: [schoolId], references: [id], map: "students_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  statusChanges                 StudentStatusChange[]
  guardianLinks                 StudentGuardian[]
  enrolments                    Enrolment[]
  documents                     StudentDocument[]
  user                          User?
  messages                      Message[]
  announcementAudiences         AnnouncementAudience[]
  announcementRecipients        AnnouncementRecipient[]
  announcementRecipientStudents AnnouncementRecipientStudent[]
  chargeCampaignAudiences       ChargeCampaignAudience[]
  advancePayments               Payment[]
  receiptLines                  ReceiptLine[]

  @@unique([schoolId, id], map: "students_school_id_id_key")
  @@unique([schoolId, admissionNo], map: "students_school_id_admission_no_key")
  /// The possible-duplicate check at admission (name + date of birth).
  @@index([schoolId, dateOfBirth], map: "students_school_id_date_of_birth_idx")
  @@map("students")
}

/// Tenant, append-only (triggers student_status_changes_append_only and _no_truncate): one row per
/// status transition, including admission (from_status null -> active) and readmission. A wrong
/// row is corrected by a further row, never an edit.
model StudentStatusChange {
  id          BigInt         @id(map: "student_status_changes_pkey") @default(autoincrement())
  schoolId    BigInt         @map("school_id")
  studentId   BigInt         @map("student_id")
  /// Null only for the admission row (CHECK student_status_changes_transition_check).
  fromStatus  StudentStatus? @map("from_status")
  toStatus    StudentStatus  @map("to_status")
  /// Never holds an identity number (CHECK student_status_changes_reason_no_id_check).
  reason      String?        @db.VarChar(500)
  changedBy   BigInt         @map("changed_by")
  effectiveOn DateTime       @map("effective_on") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  school        School  @relation(fields: [schoolId], references: [id], map: "student_status_changes_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  student       Student @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "student_status_changes_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  changedByUser User    @relation(fields: [schoolId, changedBy], references: [schoolId, id], map: "student_status_changes_changed_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "student_status_changes_school_id_id_key")
  @@index([schoolId, studentId, createdAt], map: "student_status_changes_school_id_student_id_created_at_idx")
  @@index([schoolId, changedBy], map: "student_status_changes_school_id_changed_by_idx")
  @@map("student_status_changes")
}

/// Tenant: guardian links (rule 9). A live link has ended_at null; student_id and guardian_id are
/// frozen (trigger student_guardians_columns_immutable). Partial indexes: one live link per pair
/// (student_guardians_school_id_student_id_guardian_id_key) and at most one primary contact among
/// live links (student_guardians_one_primary_contact_key, R28). "At least one" primary contact and
/// fee payer (R28, R29) and "no phone, no primary contact" (R30) span rows or tables: the service
/// enforces them.
model StudentGuardian {
  id               BigInt               @id(map: "student_guardians_pkey") @default(autoincrement())
  schoolId         BigInt               @map("school_id")
  studentId        BigInt               @map("student_id")
  guardianId       BigInt               @map("guardian_id")
  relationship     GuardianRelationship
  isPrimaryContact Boolean              @default(false) @map("is_primary_contact")
  isFeePayer       Boolean              @default(false) @map("is_fee_payer")
  canLogin         Boolean              @default(false) @map("can_login")
  endedAt          DateTime?            @map("ended_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School   @relation(fields: [schoolId], references: [id], map: "student_guardians_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  student  Student  @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "student_guardians_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  guardian Guardian @relation(fields: [schoolId, guardianId], references: [schoolId, id], map: "student_guardians_guardian_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "student_guardians_school_id_id_key")
  @@index([schoolId, studentId], map: "student_guardians_school_id_student_id_idx")
  @@index([schoolId, guardianId], map: "student_guardians_school_id_guardian_id_idx")
  @@map("student_guardians")
}

/// Tenant, the hub (rule 6): a student in a section of a class in an academic year. Attendance,
/// marks, invoices and results hang off this row. Moving class closes this row and opens another
/// (R39): student_id, academic_year_id and class_id are frozen (trigger
/// enrolments_columns_immutable). A section change within the class is an edit that clears roll_no
/// (R37). Partial indexes: one active enrolment per student (enrolments_one_active_per_student_key)
/// and roll_no per section among active rows (enrolments_school_id_section_id_roll_no_key).
model Enrolment {
  id             BigInt          @id(map: "enrolments_pkey") @default(autoincrement())
  schoolId       BigInt          @map("school_id")
  studentId      BigInt          @map("student_id")
  academicYearId BigInt          @map("academic_year_id")
  classId        BigInt          @map("class_id")
  sectionId      BigInt          @map("section_id")
  /// Positive (CHECK enrolments_roll_no_check). Widening to text later is a cast, not a data
  /// migration.
  rollNo         Int?            @map("roll_no")
  status         EnrolmentStatus @default(active)
  startedOn      DateTime        @map("started_on") @db.Date
  /// Null exactly while active (CHECK enrolments_ended_check); never before started_on.
  endedOn        DateTime?       @map("ended_on") @db.Date
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school                School                @relation(fields: [schoolId], references: [id], map: "enrolments_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  student               Student               @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "enrolments_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The class is of the enrolment's year; ON UPDATE RESTRICT freezes the class's year.
  class                 Class                 @relation(fields: [schoolId, classId, academicYearId], references: [schoolId, id, academicYearId], map: "enrolments_class_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  /// The section is one of the enrolment's class.
  section               Section               @relation(fields: [schoolId, sectionId, classId], references: [schoolId, id, classId], map: "enrolments_section_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  attendanceMarks       AttendanceMark[]
  attendanceAlerts      AttendanceAlert[]
  attendanceDayStatuses AttendanceDayStatus[]
  remarks               Remark[]
  concessions           Concession[]
  charges               Charge[]

  @@unique([schoolId, id], map: "enrolments_school_id_id_key")
  /// Target of (school_id, enrolment_id, student_id) FKs (marks, alerts, remarks): a row can never
  /// name a different child than its enrolment (Phase 2 plan §5).
  @@unique([schoolId, id, studentId], map: "enrolments_school_id_id_student_id_key")
  /// Target of Phase 3's (school_id, enrolment_id, student_id, academic_year_id) FKs: a money row
  /// can never name a different child or year than its enrolment (phase-3-financial.md §4).
  @@unique([schoolId, id, studentId, academicYearId], map: "enrolments_school_id_id_student_id_academic_year_id_key")
  @@index([schoolId, studentId], map: "enrolments_school_id_student_id_idx")
  @@index([schoolId, status, studentId], map: "enrolments_school_id_status_student_id_idx")
  @@index([schoolId, sectionId, status], map: "enrolments_school_id_section_id_status_idx")
  @@index([schoolId, academicYearId, status], map: "enrolments_school_id_academic_year_id_status_idx")
  @@index([schoolId, classId, academicYearId], map: "enrolments_school_id_class_id_academic_year_id_idx")
  @@index([schoolId, sectionId, classId], map: "enrolments_school_id_section_id_class_id_idx")
  @@map("enrolments")
}

/// Tenant: a committed document. Its object key is the staged upload's key, unchanged (nothing is
/// moved, so no failure strands a committed document). A student's photo is their latest `photo`
/// row. Rows are never edited; no verification columns until that workflow is specified.
model StudentDocument {
  id         BigInt              @id(map: "student_documents_pkey") @default(autoincrement())
  schoolId   BigInt              @map("school_id")
  studentId  BigInt              @map("student_id")
  type       StudentDocumentType
  /// `{school_id}/{ULID}.{jpg|png|pdf}`; CHECK student_documents_object_key_check binds the prefix
  /// to this row's school_id. Unique per school (student_documents_school_id_object_key_key).
  objectKey  String              @map("object_key") @db.VarChar(64)
  /// image/jpeg, image/png or application/pdf; a photo is an image (CHECKs).
  mime       String              @db.VarChar(32)
  sizeBytes  Int                 @map("size_bytes")
  uploadedBy BigInt              @map("uploaded_by")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  school         School  @relation(fields: [schoolId], references: [id], map: "student_documents_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  student        Student @relation(fields: [schoolId, studentId], references: [schoolId, id], map: "student_documents_student_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  uploadedByUser User    @relation(fields: [schoolId, uploadedBy], references: [schoolId, id], map: "student_documents_uploaded_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "student_documents_school_id_id_key")
  @@unique([schoolId, objectKey], map: "student_documents_school_id_object_key_key")
  @@index([schoolId, studentId, type, createdAt], map: "student_documents_school_id_student_id_type_created_at_idx")
  @@index([schoolId, uploadedBy], map: "student_documents_school_id_uploaded_by_idx")
  @@map("student_documents")
}

/// Tenant: an uploaded object not yet committed to a document. Usable only by its uploader (not
/// its session) until expires_at (24 h). Committing sets consumed_at. The daily sweep deletes rows
/// (and objects) with consumed_at IS NULL AND expires_at < now(): transient, not a record.
model StagedUpload {
  id         BigInt    @id(map: "staged_uploads_pkey") @default(autoincrement())
  schoolId   BigInt    @map("school_id")
  uploadedBy BigInt    @map("uploaded_by")
  /// Same format and CHECK as student_documents.object_key.
  objectKey  String    @map("object_key") @db.VarChar(64)
  mime       String    @db.VarChar(32)
  /// 1 byte to 5 MB (CHECK staged_uploads_size_bytes_check).
  sizeBytes  Int       @map("size_bytes")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school         School @relation(fields: [schoolId], references: [id], map: "staged_uploads_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  uploadedByUser User   @relation(fields: [schoolId, uploadedBy], references: [schoolId, id], map: "staged_uploads_uploaded_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "staged_uploads_school_id_id_key")
  @@unique([schoolId, objectKey], map: "staged_uploads_school_id_object_key_key")
  @@index([schoolId, expiresAt], map: "staged_uploads_school_id_expires_at_idx")
  @@index([schoolId, uploadedBy], map: "staged_uploads_school_id_uploaded_by_idx")
  @@map("staged_uploads")
}

/// Tenant: a committed idempotent request (R33, R82-R89). Inserted as the first statement of the
/// admission's transaction (response_status and subject_type known then), so a racing same-key
/// submit waits on the unique index; subject_id is filled in before commit and must be set by
/// then (deferred constraint trigger idempotency_keys_subject_required). No response body: a replay re-reads the subject. Never purged in
/// Phase 1 (R86). subject_id is polymorphic (allowlisted in NON_FK_ID_COLUMNS).
model IdempotencyKey {
  id             BigInt   @id(map: "idempotency_keys_pkey") @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  userId         BigInt   @map("user_id")
  /// Lower-case route key, e.g. `admissions` (CHECK idempotency_keys_endpoint_check).
  endpoint       String   @db.VarChar(64)
  /// 16-64 of [A-Za-z0-9_-] with no 13-digit run (CHECKs idempotency_keys_key_check and
  /// idempotency_keys_key_no_id_check).
  key            String   @db.VarChar(64)
  /// Lower-hex HMAC-SHA256 of the canonical request: the body holds identity digits.
  requestHash    String   @map("request_hash") @db.Char(64)
  /// 2xx only: only a committed request stores a key (R87).
  responseStatus Int      @map("response_status") @db.SmallInt
  subjectType    String   @map("subject_type") @db.VarChar(32)
  /// Null only inside the inserting transaction (see the model comment).
  subjectId      BigInt?  @map("subject_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], map: "idempotency_keys_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user   User   @relation(fields: [schoolId, userId], references: [schoolId, id], map: "idempotency_keys_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "idempotency_keys_school_id_id_key")
  /// R84: per user, per endpoint. Also the index behind the user FK.
  @@unique([schoolId, userId, endpoint, key], map: "idempotency_keys_school_id_user_id_endpoint_key_key")
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------- slice 7

enum CustomRoleStatus {
  active
  /// Contributes nothing (R52). Refused while any user_roles row holds it (R96).
  archived

  @@map("custom_role_status")
}

enum GrantEffect {
  grant
  /// Removes a role default only, never a grant (R50).
  revoke

  @@map("grant_effect")
}

/// Tenant: school-defined roles (rule 13, contracts/slice-7.md §3). Never deleted; archived.
/// key unique among active roles (partial index custom_roles_school_id_key_key).
model CustomRole {
  id        BigInt           @id(map: "custom_roles_pkey") @default(autoincrement())
  schoolId  BigInt           @map("school_id")
  key       String           @db.VarChar(32)
  name      String           @db.VarChar(100)
  status    CustomRoleStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school       School                 @relation(fields: [schoolId], references: [id], map: "custom_roles_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  capabilities CustomRoleCapability[]
  userRoles    UserRole[]

  @@unique([schoolId, id], map: "custom_roles_school_id_id_key")
  @@map("custom_roles")
}

/// Tenant: a custom role's capability keys. Removing a key ends the row (removed_at), never
/// deletes it. Never role.manage (CHECK custom_role_capabilities_no_role_manage_check, R45).
model CustomRoleCapability {
  id            BigInt    @id(map: "custom_role_capabilities_pkey") @default(autoincrement())
  schoolId      BigInt    @map("school_id")
  customRoleId  BigInt    @map("custom_role_id")
  capabilityKey String    @map("capability_key") @db.VarChar(64)
  addedBy       BigInt    @map("added_by")
  addedAt       DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  /// removed_at and removed_by are set together (CHECK custom_role_capabilities_removed_check).
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy     BigInt?   @map("removed_by")

  school        School     @relation(fields: [schoolId], references: [id], map: "custom_role_capabilities_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  customRole    CustomRole @relation(fields: [schoolId, customRoleId], references: [schoolId, id], map: "custom_role_capabilities_custom_role_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  addedByUser   User       @relation("CustomRoleCapabilityAddedBy", fields: [schoolId, addedBy], references: [schoolId, id], map: "custom_role_capabilities_added_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  removedByUser User?      @relation("CustomRoleCapabilityRemovedBy", fields: [schoolId, removedBy], references: [schoolId, id], map: "custom_role_capabilities_removed_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "custom_role_capabilities_school_id_id_key")
  @@index([schoolId, customRoleId], map: "custom_role_capabilities_school_id_custom_role_id_idx")
  @@index([schoolId, addedBy], map: "custom_role_capabilities_school_id_added_by_idx")
  @@index([schoolId, removedBy], map: "custom_role_capabilities_school_id_removed_by_idx")
  @@map("custom_role_capabilities")
}

/// Tenant: per-user grant and revoke rows (rule 13, R45-R51). Append-only except ending: trigger
/// user_capability_grants_end_only refuses DELETE, TRUNCATE, any change but the end columns, and
/// any change to an ended row. Never role.manage (CHECK, R75). One live row per (user, key,
/// effect): partial index user_capability_grants_live_key.
model UserCapabilityGrant {
  id            BigInt      @id(map: "user_capability_grants_pkey") @default(autoincrement())
  schoolId      BigInt      @map("school_id")
  userId        BigInt      @map("user_id")
  capabilityKey String      @map("capability_key") @db.VarChar(64)
  effect        GrantEffect
  grantedBy     BigInt      @map("granted_by")
  /// Never holds an identity number (CHECK user_capability_grants_reason_no_id_check).
  reason        String      @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// revoked_at, revoked_by and end_reason are set together (CHECK user_capability_grants_revoked_check).
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedBy     BigInt?     @map("revoked_by")
  endReason     String?     @map("end_reason") @db.VarChar(500)

  school        School @relation(fields: [schoolId], references: [id], map: "user_capability_grants_school_id_fkey", onDelete: Restrict, onUpdate: Restrict) @ignore
  user          User   @relation("GrantHolder", fields: [schoolId, userId], references: [schoolId, id], map: "user_capability_grants_user_id_fkey", onDelete: Restrict, onUpdate: Restrict)
  grantedByUser User   @relation("GrantGrantedBy", fields: [schoolId, grantedBy], references: [schoolId, id], map: "user_capability_grants_granted_by_fkey", onDelete: Restrict, onUpdate: Restrict)
  revokedByUser User?  @relation("GrantRevokedBy", fields: [schoolId, revokedBy], references: [schoolId, id], map: "user_capability_grants_revoked_by_fkey", onDelete: Restrict, onUpdate: Restrict)

  @@unique([schoolId, id], map: "user_capability_grants_school_id_id_key")
  @@index([schoolId, userId], map: "user_capability_grants_school_id_user_id_idx")
  @@index([schoolId, grantedBy], map: "user_capability_grants_school_id_granted_by_idx")
  @@index([schoolId, revokedBy], map: "user_capability_grants_school_id_revoked_by_idx")
  @@map("user_capability_grants")
}

