// append-only triggers live in the migration slice14_announcements.
// ---------------------------------------------------------------------------------------------

enum AnnouncementCategory {
  holiday
  exam
  fee
  event
  general

  @@map("announcement_category")
}

enum AnnouncementPriority {
  normal
  urgent

  @@map("announcement_priority")
}

/// `sending` is the in-transaction state of a send (decision 9); no client observes it.
enum AnnouncementStatus {
  draft
  scheduled
  sending
  sent
  cancelled

  @@map("announcement_status")
}

enum AudienceKind {
  everyone
  parents
  students
  staff
  class
  section
  student
  guardian
  staff_member

  @@map("audience_kind")
}

enum AudienceRole {
  parents
  students

  @@map("audience_role")
