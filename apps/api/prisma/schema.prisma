  cover_assigned
  // Phase 3 (phase-3-financial.md §3.6); added in their own migration
  // (20261005180725_phase3_message_types).
  fee_charged
  fee_due_reminder
  fee_overdue
  receipt_issued
  payment_claim_rejected
  payment_claim_submitted
