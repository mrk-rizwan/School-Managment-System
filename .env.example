# Copy to .env and fill every value. The API refuses to start if any is missing.
# Never commit .env (the pre-commit hook blocks it).

# --- docker compose services
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=asms
REDIS_PASSWORD=

# --- API
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=

# Three separate secrets (see CLAUDE.md conventions). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_HASH_KEY=
# Keyring: comma-separated keyId:base64key; the first entry encrypts, all decrypt.
FIELD_ENCRYPTION_KEYS=
PASSWORD_PEPPER=

# --- object storage (MinIO locally)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=asms-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- mail (mailpit locally)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="ASMS <no-reply@localhost>"

# --- seeded platform admin (slice 1)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
