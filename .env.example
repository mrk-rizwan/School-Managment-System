# Copy to .env and fill every value. The API refuses to start if any is missing.
# Never commit .env (the pre-commit hook blocks it).

# --- docker compose services
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=asms
REDIS_PASSWORD=

# --- API
NODE_ENV=development
API_PORT=3461
APP_URL=http://localhost:3460
DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=

# Three separate secrets (see CLAUDE.md conventions). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_HASH_KEY=
# Keyring: comma-separated keyId:base64key; the first entry encrypts, all decrypt.
FIELD_ENCRYPTION_KEYS=
PASSWORD_PEPPER=

# --- object storage (MinIO locally)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=asms-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- mail (mailpit locally)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="ASMS <no-reply@localhost>"

# --- seeded platform admin (slice 1)
# Optional: the API boots without these; only the seed command requires them.
# Read ONLY by `pnpm --filter @asms/api seed:platform-admin`; the running API does not need them.
# Run the seed once, then remove the password from any server environment: until first sign-in,
# that password alone is the whole account. The admin must enrol an authenticator and change it.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- platform alerts (Phase 2, slice 9)
# Optional: the one ops mailbox that receives platform alerts such as "WhatsApp down".
PLATFORM_ALERT_EMAIL=

# --- mobile app (Phase 2, slice 9)
# The lowest X-App-Version the API serves; older apps get 426 and an update screen (R161).
# Required in production; empty elsewhere means every version (0.0.0).
MOBILE_MIN_APP_VERSION=

# --- messaging drivers (Phase 2, slice 9; contracts/slice-9.md)
# Outside production an empty value selects the log driver (nothing leaves the machine); in
# production every one of these is required and the API refuses to start without it (R112) -
# except the WAHA_* and META_* keys of a WhatsApp provider left out of WHATSAPP_PROVIDERS_ENABLED.
# Base64 of the Firebase service-account JSON (push).
FCM_SERVICE_ACCOUNT_JSON=
# The WhatsApp providers this deployment runs: waha, cloud_api or both (default, when empty). A
# provider left out refuses every send, its webhook answers 404 and the platform cannot choose it.
WHATSAPP_PROVIDERS_ENABLED=
# WAHA (self-hosted WhatsApp), private network only.
WAHA_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
# WhatsApp Business Cloud API (Meta): webhook signature key and subscription verify token.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version pinned for the Cloud API (default v23.0).
# META_GRAPH_VERSION=v23.0
# Sendpk SMS: the key is sent in the POST body only; the sender is the platform's mask.
SMS_API_KEY=
SMS_SENDER_ID=
# Worker health port (default 3002).
# WORKER_HEALTH_PORT=3002

# WORKER is set by the worker entrypoint (pnpm --filter @asms/api worker); never set it here.
